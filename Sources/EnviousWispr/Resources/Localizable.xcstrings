    "whatsNew.more-reliable-recordings.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry more-reliable-recordings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fewer silent failures. The audio helper now recovers cleanly from a rare crash class, and the microphone bounces back better from bad states after long idle periods or audio interruptions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger unbemerkte Fehler: Der Audio-Hilfsprozess erholt sich jetzt sauber von einer seltenen Absturzart. Auch das Mikrofon findet nach langer Inaktivität oder einer Audiounterbrechung zuverlässiger in einen funktionierenden Zustand zurück."
          }
