    "whatsNew.emoji-stay-put.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry emoji-stay-put).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate an emoji and it now stays exactly where you placed it after polish runs. No more emoji going missing or landing in the wrong spot."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktierte Emoji bleiben nach der Nachbearbeitung genau dort, wo du sie eingefügt hast. Sie verschwinden nicht mehr und landen nicht an der falschen Stelle."
          }
        }
      }
    },
    "whatsNew.clearer-polish-failure-reasons.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry clearer-polish-failure-reasons).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearer reasons when polish can't finish"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarere Gründe, wenn die Nachbearbeitung scheitert"
          }
        }
      }
    },
    "whatsNew.clearer-polish-failure-reasons.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry clearer-polish-failure-reasons).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If cloud or on-device AI polish ever cannot finish, EnviousWispr now tells you specifically what happened and what to do, instead of a vague notice. Either way, your clean transcription is always delivered."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann die KI-Nachbearbeitung in der Cloud oder auf dem Gerät nicht abgeschlossen werden, erklärt EnviousWispr jetzt genau, was passiert ist und was du tun kannst. Deine saubere Transkription erhältst du trotzdem immer."
          }
        }
      }
    },
    "whatsNew.crash-recovery.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry crash-recovery).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your words survive an unexpected quit"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wörter überstehen ein unerwartetes Beenden"
          }
        }
      }
    },
    "whatsNew.crash-recovery.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry crash-recovery).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the app ever closes in the middle of a dictation, your recording is no longer lost. When you reopen EnviousWispr it quietly picks up where it left off and finishes turning your words into text."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird die App mitten in einem Diktat geschlossen, geht deine Aufnahme nicht mehr verloren. Beim nächsten Start setzt EnviousWispr die Verarbeitung unauffällig fort und macht aus deinen Wörtern Text."
          }
        }
      }
    },
    "whatsNew.ap-style-numbers.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry ap-style-numbers).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numbers written the way you would write them"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlen so geschrieben, wie du sie schreiben würdest"
          }
        }
      }
    },
    "whatsNew.ap-style-numbers.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry ap-style-numbers).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numbers now come out the way you would actually type them: small ones spelled out, larger ones as digits, following the same style most newsrooms use. That means less cleanup for you."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlen erscheinen jetzt eher so, wie du sie selbst tippen würdest: kleine Zahlen ausgeschrieben, größere als Ziffern – nach einem Stil, den viele Redaktionen verwenden. So musst du weniger nachbessern."
          }
        }
      }
    },
    "whatsNew.no-clipped-last-words.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry no-clipped-last-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more clipped last words"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine abgeschnittenen Schlusswörter mehr"
          }
        }
      }
    },
    "whatsNew.no-clipped-last-words.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry no-clipped-last-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We fixed a case where a quick, energetic word or two at the very end of a dictation could get trimmed off. Your full sentence now makes it through."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein oder zwei kurze, betonte Wörter am Ende eines Diktats konnten bisher abgeschnitten werden. Jetzt kommt der ganze Satz an."
          }
        }
      }
    },
    "whatsNew.paste-never-waits-on-history.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-never-waits-on-history).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting never waits on saving"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfügen wartet nicht mehr auf das Speichern"
          }
        }
