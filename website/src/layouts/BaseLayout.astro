---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import CompareTableMobile from '../components/CompareTableMobile.astro';
import '../styles/global.css';
import '../styles/site-header.css';

import SiteHead from '../components/SiteHead.astro';
import SiteServices from '../components/SiteServices.astro';
import type {ComponentProps} from 'astro/types';
type Props = ComponentProps<typeof SiteHead>;
const { activePage = 'home' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body class="base-shell">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="dot-grid" aria-hidden="true"></div>
    <SiteHeader activePage={activePage} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <ScrollReveal />
    <CompareTableMobile />
    <SiteServices />
  </body>
</html>
