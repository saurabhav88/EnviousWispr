      }
    },
    "%@ alternate spellings may not be added, because other words already use them." : {
      "comment" : "Your Words, import review: a row's note. %@ is the number of misheard forms, never 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alternative Schreibweisen können nicht hinzugefügt werden, weil andere Wörter sie bereits verwenden."
          }
        }
      }
    },
    "%@ alternate spellings were skipped, because other words already use them." : {
      "comment" : "Your Words, import result: %@ is the number of misheard forms not added, never 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alternative Schreibweisen wurden übersprungen, weil andere Wörter sie bereits verwenden."
          }
        }
      }
    },
    "%@ by Superwhisper is a small open model built for one job: tidying up dictated text. It runs entirely on this Mac, so nothing you say leaves your device, and it is free with no API key to manage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ von Superwhisper ist ein kleines offenes Modell, das diktierte Texte nachbearbeitet. Es läuft vollständig auf diesem Mac. Nichts, was du sagst, verlässt dein Gerät. Es ist kostenlos und braucht keinen API-Schlüssel."
          }
        }
      }
    },
    "%@ channels" : {
      "comment" : "Transcribe a File: a file's audio channels. %@ is the count, never 1 or 2.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Kanäle"
          }
        }
      }
    },
    "%@ entries were left out because EnviousWispr can't use them." : {
      "comment" : "Snippets, import review: notice. %@ is the number of entries that could not be used, never 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Einträge wurden ausgelassen, weil EnviousWispr sie nicht verwenden kann."
          }
        }
      }
    },
    "%@ fixes" : {
      "comment" : "Your Words, vocabulary packs: under a pack. %@ is its number of fixes, never 1.",
