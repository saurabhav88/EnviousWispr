          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr affiche uniquement les modèles qu’Ollama possède déjà. Utilisez Parcourir les modèles ou exécutez ollama pull dans le Terminal."
          }
        },
        "es" : {
          "stringUnit" : {
