    "whatsNew.import-your-snippets.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry import-your-snippets).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring snippets in from the file you exported, a CSV, a list you paste, or straight from Wispr Flow or TypeWhisper. You review the list before anything is saved, snippets you already have are skipped, and your keyword stays as it is."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere Textbausteine aus einer exportierten Datei, einer CSV-Datei, einer eingefügten Liste oder direkt aus Wispr Flow oder TypeWhisper. Du prüfst die Liste, bevor etwas gespeichert wird. Vorhandene Textbausteine werden übersprungen und dein Schlüsselwort bleibt erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez des extraits de texte depuis le fichier que vous avez exporté, un fichier CSV, une liste que vous collez ou directement depuis Wispr Flow ou TypeWhisper. Vous vérifiez la liste avant tout enregistrement, les extraits que vous avez déjà sont ignorés et votre mot-clé reste inchangé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa fragmentos de texto desde el archivo que exportaste, un archivo CSV, una lista que pegues o directamente desde Wispr Flow o TypeWhisper. Puedes revisar la lista antes de guardar nada; los fragmentos que ya tienes se omiten y tu palabra clave se mantiene sin cambios."
          }
        }
      }
    },
    "whatsNew.snippet-dynamic-values.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry snippet-dynamic-values).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic variables in snippets"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamische Werte in Textbausteinen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variables dynamiques dans les extraits de texte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variables dinámicas en los fragmentos de texto"
          }
        }
      }
    },
    "whatsNew.snippet-dynamic-values.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry snippet-dynamic-values).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insert the current date, current time, or your last copied text into snippets. Dynamic values resolve instantly on trigger, and clipboard contents are read strictly when the snippet fires."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge das aktuelle Datum, die aktuelle Uhrzeit oder deinen zuletzt kopierten Text in Textbausteine ein. Die Werte werden erst beim Auslösen eingesetzt, und die Zwischenablage wird nur gelesen, wenn der Textbaustein tatsächlich ausgelöst wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insérez la date actuelle, l’heure actuelle ou le dernier texte que vous avez copié dans vos extraits de texte. Les valeurs dynamiques sont remplacées instantanément au déclenchement, et le contenu du presse-papiers est lu uniquement lorsque l’extrait est déclenché."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserta la fecha, la hora o el último texto que hayas copiado en tus fragmentos de texto. Los valores se sustituyen al instante cuando se activa el fragmento de texto. El portapapeles solo se lee en ese momento."
          }
        }
      }
    },
    "whatsNew.english-uk-spelling.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry english-uk-spelling).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "English (UK) spelling"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Britische Schreibweise mit Englisch (UK)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orthographe anglaise (Royaume-Uni)"
          }
        },
        "es" : {
