    "Press %@, or open the EnviousWispr menu and choose the Add item." : {
      "comment" : "Dictionary settings, Quick Add teaching card: step 2. %@ is a key combination. Add is the first word of the menu item; use the same word as that menu item in this language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke %@ oder öffne das EnviousWispr-Menü und wähle den Eintrag, der mit „hinzufügen“ endet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@ ou ouvrez le menu EnviousWispr et choisissez Ajouter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@ o abre el menú de EnviousWispr y elige la opción que empieza por “Añadir”."
          }
        }
      }
    },
    "Press Play to listen. To remove just the audio and keep the text, open More actions and choose Delete recording, keep text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Abspielen“, um die Aufnahme anzuhören. Wenn du nur die Audioaufnahme löschen und den Text behalten möchtest, öffne „Weitere Aktionen“ und wähle „Aufnahme löschen, Text behalten“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez Lire pour écouter. Pour supprimer uniquement l’audio et conserver le texte, ouvrez Autres actions et choisissez « Supprimer l’enregistrement, conserver le texte »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa Reproducir para escuchar. Para eliminar solo el audio y conservar el texto, abre “Más acciones” y selecciona “Eliminar grabación y conservar el texto”."
          }
        }
      }
    },
    "Press Save key to finish, or pick another." : {
      "comment" : "Transcribe a File, Polish step: the note beside Continue when it is blocked. Save key is a button.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke zum Abschließen auf „Sichern“ oder wähle eine andere Engine."
