          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Nachbearbeitung verändert deinen Text nicht mehr übermäßig und beantwortet Fragen nicht mehr, statt sie zu bearbeiten. Fünf Schutzregeln bewahren deine Worte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retouche IA ne modifie plus excessivement votre texte et ne répond plus aux questions au lieu de les retoucher. Cinq règles de protection préservent vos mots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
