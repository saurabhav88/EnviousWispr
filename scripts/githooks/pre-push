  touch "$repo/SLOW"; git -C "$repo" add SLOW; git -C "$repo" commit --quiet -m slow
  printf 'refs/heads/main %s refs/heads/main %s\n' "$(git -C "$repo" rev-parse HEAD)" "$ZERO_SHA" > "$tmp/stdin"
  (cd "$repo" && SELFTEST_SLOW_PID="$tmp/slow.pid" exec "$BASH" "$hook" origin "$remote" < "$tmp/stdin" > "$tmp/int.out" 2>&1) &
  pid=$!
  local waited=0
