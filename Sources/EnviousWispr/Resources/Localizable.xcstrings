    },
    "This may take a moment on first run." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Start kann das einen Moment dauern."
          }
        }
      }
    },
    "This model did not pass any of our cleanup tests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell hat keinen unserer Tests zur Nachbearbeitung bestanden."
          }
        }
      }
    },
    "This model needs a newer version of EnviousWispr." : {
      "comment" : "AI Polish, local model card: the reason under the health status.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell benötigt eine neuere Version von EnviousWispr."
          }
        }
