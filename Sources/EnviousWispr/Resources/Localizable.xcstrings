    "whatsNew.auto-language-actually-works.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry auto-language-actually-works).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave language on Auto and EnviousWispr will detect what you spoke instead of assuming English. Short clips also decide faster, so quick commands feel snappier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Sprache auf „Automatisch“ lässt, erkennt EnviousWispr jetzt deine gesprochene Sprache, statt Englisch anzunehmen. Bei kurzen Aufnahmen fällt die Entscheidung zudem schneller, sodass kurze Befehle flotter wirken."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la langue réglée sur « Automatique », EnviousWispr identifie la langue que vous parlez au lieu de supposer qu’il s’agit de l’anglais. La langue est aussi identifiée plus rapidement dans les enregistrements courts, pour que les commandes vocales répondent plus vite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el idioma en Automático y EnviousWispr detectará en qué idioma hablaste, en lugar de dar por hecho que es inglés. Ahora también detecta antes el idioma en grabaciones cortas, así que los comandos breves responden más rápido."
          }
        }
      }
    },
    "whatsNew.stuck-model-loads-recover-sooner.title" : {
