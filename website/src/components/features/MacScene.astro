---
// Make it yours hero visual: the real recording pill on a real Mac screen, to
// scale. The desktop is a 14-inch MacBook Pro screen (1512 x 982 points); the
// document window and the menu bar text are captures of macOS; each pill is
// the app's own recording view rendered at 2x. Positions are the app's
// placement arithmetic (data/features/customization.js), expressed as
// percentages of the screen so the scene scales with its container.
import { getImage } from 'astro:assets';
import desktop from '../../assets/features/mac-scene/desktop.jpg';
import windowShot from '../../assets/features/mac-scene/textedit-window.png';
import menubarLeft from '../../assets/features/mac-scene/menubar-left.png';
import menubarRight from '../../assets/features/mac-scene/menubar-right.png';
import pillClassicListening from '../../assets/features/mac-scene/pill-classic-listening.png';
import pillClassicHandsfree from '../../assets/features/mac-scene/pill-classic-handsfree.png';
import pillRailListening from '../../assets/features/mac-scene/pill-levelRail-listening.png';
import pillRailHandsfree from '../../assets/features/mac-scene/pill-levelRail-handsfree.png';
import pillWellListening from '../../assets/features/mac-scene/pill-readingWell-listening.png';
import pillWellHandsfree from '../../assets/features/mac-scene/pill-readingWell-handsfree.png';
import { pills, modes, positions, screen, pillPlacement } from '../../data/features/customization.js';

const wallpaper = await getImage({ src: desktop, width: 1600, format: 'webp', quality: 80 });
const doc = await getImage({ src: windowShot, width: 1400, format: 'webp', quality: 88 });

const pct = (points, of) => `${((points / of) * 100).toFixed(3)}%`;

// The document window capture is 952 x 672 points including its shadow; the
// window itself is 840 x 560 inside a 56-point shadow margin. Centred, with
// its title bar just under where the top pill sits.
const windowLeft = (screen.width - 840) / 2 - 56;
const windowTop = 120 - 56;

const pillImages = {
  classic: { listening: pillClassicListening, handsfree: pillClassicHandsfree, width: 185 },
  levelRail: { listening: pillRailListening, handsfree: pillRailHandsfree, width: 288 },
  readingWell: { listening: pillWellListening, handsfree: pillWellHandsfree, width: 400 },
};
const pillLayers = pills.flatMap((p) =>
  modes.map((m) => ({
    design: p.key,
    mode: m.key,
    src: pillImages[p.key][m.key].src,
    width: pct(pillImages[p.key].width, screen.width),
    height: pct(pillPlacement[p.key].height, screen.height),
    top: pct(pillPlacement[p.key].top, screen.height),
    bottom: pct(pillPlacement[p.key].bottom, screen.height),
  })),
);
---

<div class="mac-scene" data-picker="mac-scene">
  <div class="mac-stage" id="mac-stage" data-design="classic" data-mode="listening" data-position="bottom">
    <div class="mac-screen" style={`aspect-ratio:${screen.width}/${screen.height}`} role="img" aria-label="A Mac desktop with a document open and the EnviousWispr recording pill floating over it.">
      <img class="mac-desktop" src={wallpaper.src} alt="" width={screen.width} height={screen.height} loading="eager" fetchpriority="high" decoding="async" />
      <div class="mac-menubar" style={`height:${pct(screen.menuBar, screen.height)}`}>
        <img src={menubarLeft.src} alt="" width="870" height="66" style={`width:${pct(435, screen.width)}`} />
        <span class="mac-notch" aria-hidden="true"></span>
        <img src={menubarRight.src} alt="" width="290" height="66" style={`width:${pct(145, screen.width)};margin-right:${pct(12, screen.width)}`} />
      </div>
      <img
        class="mac-window"
        src={doc.src}
        alt=""
        width="1904"
        height="1344"
        loading="eager"
        decoding="async"
        style={`left:${pct(windowLeft, screen.width)};top:${pct(windowTop, screen.height)};width:${pct(952, screen.width)}`}
      />
      {
        pillLayers.map((layer) => (
          <img
            class="mac-pill"
            data-design={layer.design}
            data-mode={layer.mode}
            src={layer.src}
            alt=""
            loading="eager"
            decoding="async"
            style={`width:${layer.width};height:${layer.height};--pill-top:${layer.top};--pill-bottom:${layer.bottom}`}
          />
        ))
      }
    </div>

    <div class="mac-closeup" aria-hidden="true">
      {
        pillLayers.map((layer) => (
          <img class="mac-closeup-pill" data-design={layer.design} data-mode={layer.mode} src={layer.src} alt="" loading="eager" decoding="async" style={`width:${pct(pillImages[layer.design].width, 420)}`} />
        ))
      }
      <span class="mac-closeup-label">Close up</span>
    </div>

    <div class="mac-controls">
      <div class="mac-choice-row">
        <span class="mac-choice-label">Design</span>
        <div class="mac-choices" role="group" aria-label="Recording pill design" data-choice-group data-kind="dataset" data-target="mac-stage" data-name="design">
          {
            pills.map((p, i) => (
              <button type="button" class:list={{ selected: i === 0 }} data-choice={p.key} aria-pressed={i === 0 ? 'true' : 'false'} disabled data-enables>
                {p.name}
              </button>
            ))
          }
        </div>
      </div>
      <div class="mac-choice-row">
        <span class="mac-choice-label">Mode</span>
        <div class="mac-choices" role="group" aria-label="Recording mode" data-choice-group data-kind="dataset" data-target="mac-stage" data-name="mode">
          {
            modes.map((m, i) => (
              <button type="button" class:list={{ selected: i === 0 }} data-choice={m.key} aria-pressed={i === 0 ? 'true' : 'false'} disabled data-enables>
                {m.name}
              </button>
            ))
          }
        </div>
      </div>
      <div class="mac-choice-row">
        <span class="mac-choice-label">Position</span>
        <div class="mac-choices" role="group" aria-label="Where the pill appears" data-choice-group data-kind="dataset" data-target="mac-stage" data-name="position">
          {
            positions.map((p) => (
              <button type="button" class:list={{ selected: p.key === 'bottom' }} data-choice={p.key} aria-pressed={p.key === 'bottom' ? 'true' : 'false'} disabled data-enables>
                {p.name}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mac-notes" aria-live="polite">
      {
        pills.map((p) => (
          <p class="mac-note" data-design={p.key}>
            <strong>{p.name}.</strong> {p.note}
            {p.key === 'readingWell' ? ' Needs Live Preview switched on.' : ''}
          </p>
        ))
      }
    </div>
  </div>
  <small>The real recording pill, shown to scale on a 14-inch MacBook Pro screen. Drag it anywhere during a dictation; the next one returns to the spot you chose.</small>
</div>
