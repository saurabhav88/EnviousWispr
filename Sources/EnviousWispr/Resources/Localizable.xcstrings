    "whatsNew.update-banner-stays-put.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry update-banner-stays-put).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a new version is ready, the in-app banner now stays visible until you install. No more dismissing it and forgetting it was there."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine neue Version bereitsteht, bleibt der Hinweis in der App jetzt bis zur Installation sichtbar. So gerät das Update nicht nach dem Schließen des Hinweises in Vergessenheit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’une nouvelle version est disponible, la bannière de l’app reste maintenant visible jusqu’à son installation. Vous ne risquez plus de la fermer et d’oublier la mise à jour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando hay una versión nueva, el aviso permanece visible en la app hasta que la instalas. Así no puedes descartarlo sin querer y olvidarte de la actualización."
          }
        }
      }
    },
