  PATH="$fakebin:$PATH" git -C "$repo" push "$remote" rec-old:rec-old3 > "$tmp/push.out" 2>&1; rc=$?
  check "R11 a failed fetch of origin/main is COULD NOT RUN: warns and allows" \
    "$rc|$(grep -c 'recipe: COULD NOT RUN (git fetch origin main failed' "$tmp/push.out")" "0|1"
