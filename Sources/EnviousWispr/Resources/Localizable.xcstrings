    },
    "This transcript was deleted." : {
      "comment" : "History transcript: the transcript was deleted while Locate original ran.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Transkript wurde gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette transcription a été supprimée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transcripción se ha eliminado."
          }
        }
      }
    },
    "This transcript was saved before EnviousWispr kept file details, so it can't check that the file you choose is the original. Choose only the file you transcribed." : {
      "comment" : "History transcript, Locate original: why a legacy transcript needs confirmation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Transkript wurde gespeichert, bevor EnviousWispr Dateiinformationen speicherte. Daher kann nicht geprüft werden, ob die gewählte Datei das Original ist. Wähle nur die Datei, die du transkribiert hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette transcription a été enregistrée avant qu’EnviousWispr ne conserve les informations sur les fichiers. Il est donc impossible de vérifier que le fichier que vous choisissez est l’original. Choisissez uniquement le fichier que vous avez transcrit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transcripción se guardó antes de que EnviousWispr almacenara los detalles del archivo, así que no se puede comprobar que el archivo que elijas sea el original. Elige solo el archivo que transcribiste."
          }
        }
      }
    },
    "This version is not saved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version ist nicht gespeichert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version n’est pas enregistrée"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión no se ha guardado"
          }
        }
      }
    },
    "This version of EnviousWispr cannot run that preview engine." : {
      "comment" : "Live Preview settings, preview engine: unavailable in this build.\nOn-screen preview status: this app build lacks the preview engine's files.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Version von EnviousWispr kann diese Vorschau-Engine nicht ausführen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version d’EnviousWispr ne peut pas exécuter ce moteur d’aperçu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de EnviousWispr no puede ejecutar ese motor de vista previa."
          }
        }
      }
    },
    "This version of EnviousWispr is missing that engine's files. Pick Apple instead." : {
      "comment" : "Live Preview settings: status build cannot run detail.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Version von EnviousWispr fehlen die Dateien dieser Engine. Wähle stattdessen Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version d’EnviousWispr ne contient pas les fichiers de ce moteur. Choisissez plutôt Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A esta versión de EnviousWispr le faltan los archivos de ese motor. Elige Apple en su lugar."
          }
        }
      }
    },
    "This version of EnviousWispr is missing that engine's files. Updating the app should restore it." : {
      "comment" : "Live Preview settings: status build cannot run detail no alternative.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Version von EnviousWispr fehlen die Dateien dieser Engine. Ein App-Update sollte sie wiederherstellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version d’EnviousWispr ne contient pas les fichiers de ce moteur. Une mise à jour de l’app devrait les restaurer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A esta versión de EnviousWispr le faltan los archivos de ese motor. Si actualizas la app, el motor debería volver a estar disponible."
          }
        }
      }
    },
    "This will permanently delete all %@ items in History, including any hidden by a filter or search. This action cannot be undone." : {
      "comment" : "Delete All confirmation in History. %@ is how many rows will be deleted, including hidden ones. Never 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@ Einträge im Verlauf werden dauerhaft gelöscht, auch die durch Filter oder Suche ausgeblendeten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération supprimera définitivement les %@ éléments de l’Historique, y compris ceux masqués par un filtre ou une recherche. Cette action est irréversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente los %@ elementos del Historial, incluidos los ocultos por un filtro o una búsqueda. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "This will permanently delete the only item in History, even if a filter or search is hiding it. This action cannot be undone." : {
      "comment" : "Delete All confirmation in History when exactly one row exists (it may be hidden by a filter).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird der einzige Eintrag im Verlauf dauerhaft gelöscht, auch wenn er durch einen Filter oder eine Suche ausgeblendet ist. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération supprimera définitivement l’unique élément de l’Historique, même s’il est masqué par un filtre ou une recherche. Cette action est irréversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente el único elemento del Historial, aunque un filtro o una búsqueda lo oculte. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "This word changed while this editor was open. Nothing was deleted. Close this editor and open the word again." : {
      "comment" : "Dictionary word editor: Delete stopped because the word's text or settings were changed elsewhere meanwhile.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wort hat sich geändert, während dieser Dialog geöffnet war. Es wurde nichts gelöscht. Schließe diesen Dialog und öffne das Wort erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot a changé pendant que cet éditeur était ouvert. Rien n’a été supprimé. Fermez cet éditeur et ouvrez à nouveau le mot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta palabra cambió mientras este editor estaba abierto. No se ha eliminado nada. Cierra este editor y vuelve a abrir la palabra."
          }
        }
      }
    },
    "This word changed while you were editing. Your changes weren't saved. Close this editor and open the word again." : {
      "comment" : "Dictionary word editor: Save stopped because the word was changed elsewhere meanwhile.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wort hat sich geändert, während du es bearbeitet hast. Deine Änderungen wurden nicht gespeichert. Schließe diesen Dialog und öffne das Wort erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot a changé pendant que vous le modifiiez. Vos modifications n’ont pas été enregistrées. Fermez cet éditeur et ouvrez à nouveau le mot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta palabra cambió mientras la editabas. No se han guardado tus cambios. Cierra este editor y vuelve a abrir la palabra."
          }
        }
      }
    },
    "This word is no longer in your words. Nothing was deleted." : {
      "comment" : "Dictionary word editor: Delete found the word already deleted.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
