            "value" : "Tu clave de API de %@"
          }
        }
      }
    },
    "Your %@ key is not saved yet." : {
      "comment" : "AI Polish, leave pop-up reason: a key was typed but Save was not pressed. %@ is a provider name, such as OpenAI.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
