    "whatsNew.english-uk-spelling.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry english-uk-spelling).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose English (UK) as your dictation language and your text comes out in British spelling, like colour, organisation and centre. It works for dictation and Transcribe a File, with polishing on or off."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Englisch (UK) als Diktiersprache, und dein Text erscheint in britischer Schreibweise, etwa colour, organisation und centre. Das gilt für Diktate und „Datei transkribieren“, mit und ohne Nachbearbeitung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l’anglais (Royaume-Uni) comme langue de dictée pour obtenir un texte en orthographe britannique, avec des mots comme colour, organisation et centre. Cette option fonctionne pour la dictée et Transcrire un fichier, avec ou sans retouche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Inglés (Reino Unido) como idioma de dictado y el texto seguirá la ortografía británica, con formas como “colour”, “organisation” y “centre”. Funciona tanto con el dictado como con Transcribir un archivo, con el Pulido activado o desactivado."
          }
        }
      }
    },
    "whatsNew.dock-icon-and-window-in-front.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry dock-icon-and-window-in-front).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Dock icon, and a window that opens in front"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Symbol im Dock und ein Fenster im Vordergrund"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une icône dans le Dock et une fenêtre au premier plan"
