      }
    },
    "Automatically detects when you correct a dictation and adds the corrected word to your dictionary. Undo it from the notification, or remove it later in Your Words." : {
      "comment" : "Your Words, Learn from: the self-learning dictionary row: what the feature does. Your Words is a page name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt automatisch, wenn du ein Diktat korrigierst, und fügt das korrigierte Wort deinem Wörterbuch hinzu. Du kannst das über die Mitteilung rückgängig machen oder das Wort später unter „Deine Wörter“ entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détecte automatiquement les corrections apportées à une dictée et ajoute le mot corrigé à votre dictionnaire. Annulez cette action depuis la notification ou supprimez le mot plus tard dans Vos mots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta automáticamente cuándo corriges un dictado y añade la palabra corregida a tu Diccionario. Puedes deshacer esa incorporación desde la notificación o eliminar la palabra más tarde en Tus palabras."
          }
        }
      }
    },
