    "whatsNew.clipboard-restored-in-chrome.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry clipboard-restored-in-chrome).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your clipboard now comes back after you dictate into Chrome, Brave, Edge, Vivaldi, Arc or the ChatGPT app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zwischenablage wird jetzt wiederhergestellt, nachdem du in Chrome, Brave, Edge, Vivaldi, Arc oder in die ChatGPT-App diktiert hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre presse-papiers est désormais restauré après une dictée dans Chrome, Brave, Edge, Vivaldi, Arc ou l’app ChatGPT."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
