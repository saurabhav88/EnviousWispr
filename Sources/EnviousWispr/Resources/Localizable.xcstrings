    "whatsNew.paste-last-dictation.bullet.2" : {
      "comment" : "Settings > What's New: point 3 of the list under one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste Last Dictation is in your menu bar too, and you can customize either shortcut under Settings > Keybinds. Never lose a spoken thought to a missed click again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Letztes Diktat einfügen“ findest du auch in der Menüleiste, und beide Kurzbefehle kannst du unter Einstellungen > Tastenkürzel ändern. Kein gesprochener Gedanke geht mehr durch einen verpassten Klick verloren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Coller la dernière dictée » est également disponible dans votre barre des menus. Vous pouvez personnaliser chacun des deux raccourcis dans Réglages > Raccourcis clavier. Ne perdez plus jamais une idée dictée à cause d’un clic manqué."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegar el último dictado también está en la barra de menús. Puedes personalizar ambos atajos en Ajustes > Atajos de teclado. Así no perderás lo que dictaste por no haber hecho clic en el campo de texto."
          }
        }
      }
    },
    "whatsNew.paste-lands-where-you-started.title" : {
