    },
    "We couldn't move EnviousWispr automatically." : {
      "comment" : "Move to Applications result, any other failure: the heading. EnviousWispr is the app name; keep it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr konnte nicht automatisch verschoben werden."
          }
        }
      }
    },
    "We heard you. The box was not selected, so your words went to the clipboard.\nClick inside the box, then hold %@ again." : {
      "comment" : "Practice screen when the text box was not selected. %@ is the dictation shortcut. Keep the line break.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dich gehört. Das Feld war nicht ausgewählt, deshalb wurden deine Wörter in die Zwischenablage kopiert.\nKlicke in das Feld und halte %@ erneut gedrückt."
          }
        }
      }
    },
    "We only use Accessibility at the moment we paste your dictation. Never to read your keystrokes, never to watch what happens in other apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir nutzen den Zugriff auf Bedienungshilfen nur, wenn wir dein Diktat einfügen. Wir lesen damit keine Tastatureingaben und beobachten keine anderen Apps."
          }
        }
      }
    },
    "We'll add %@ names from your contacts." : {
      "comment" : "Your Words, import from Contacts: %@ is the number of new names, never 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir fügen %@ Namen aus deinen Kontakten hinzu."
