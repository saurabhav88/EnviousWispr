          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparaisons et alternatives : « pros slash cons » devient pros/cons"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparaciones y alternativas: “pros slash cons” se convierte en pros/cons"
