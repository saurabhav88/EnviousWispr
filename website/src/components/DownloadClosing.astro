---
// Shared closing: the approved dawn and twilight landscapes from #2816.
// Images remain lazy and theme-hidden; with scripts off, browsers may fetch both.
import { getImage } from 'astro:assets';
import dawn from '../assets/features/dawn-landscape.png';
import twilight from '../assets/features/twilight-landscape.png';
import DownloadButton from './features/DownloadButton.astro';
import PlayButton from './PlayButton.astro';
import { downloadUrl } from '../data/site-navigation.js';
import '../styles/download-closing.css';

interface Props {
  title?: string;
  description?: string;
  source?: string;
  id?: string;
  /** #4161: 'button' puts Google Play beside the Mac button; 'link' (pages about
   * a Mac feature) adds only a quiet link to /android/, so the closing never
   * implies that page's feature runs on Android; 'primary' (the /android/
   * page) leads with Google Play and keeps a quiet Mac link. */
  android?: 'button' | 'link' | 'primary';
}
const {
  title = 'Put your voice to work.',
  description = 'Free, private dictation for Mac. No account. No subscription.',
  source = 'features-closing',
  id,
  android = 'link',
} = Astro.props;
const widths = [1086, 2172];
async function sources(src) {
  const variants = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp', quality: 82 })));
  return { srcset: variants.map((v, i) => `${v.src} ${widths[i]}w`).join(', '), src: variants[0].src };
}
const light = await sources(dawn);
const dark = await sources(twilight);
---

<section class="download-closing" id={id} aria-labelledby="download-closing-title">
  <img class="download-closing-dark" src={dark.src} srcset={dark.srcset} sizes="100vw" alt="" width="2172" height="724" loading="lazy" decoding="async" />
  <img class="download-closing-light" src={light.src} srcset={light.srcset} sizes="100vw" alt="" width="2172" height="724" loading="lazy" decoding="async" />
  <div class="download-closing-content">
    <span class="download-closing-kicker">A little more room for your ideas.</span>
    <h2 id="download-closing-title">{title}</h2>
    <p class="download-closing-description">{description}</p>
    {
      android === 'primary' ? (
        <PlayButton source={source} class="download-closing-button" label="Get it on Google Play" />
      ) : android === 'button' ? (
        <div class="download-choices download-closing-choices">
          <DownloadButton source={source} class="download-closing-button" />
          <PlayButton source={source} class="download-closing-button is-secondary" />
        </div>
      ) : (
        <DownloadButton source={source} class="download-closing-button" />
      )
    }
    <small class="download-closing-compatibility">
      {android === 'primary' ? 'Android 13+ · 64-bit · 6 GB memory or more' : android === 'button' ? 'macOS 14+ · Apple Silicon · Android 13+' : 'macOS 14+ · Apple Silicon'}
    </small>
    {android === 'link' && <a class="download-closing-android" href="/android/">Also on Android <span aria-hidden="true">→</span></a>}
    {android === 'primary' && <a class="download-closing-android" href={downloadUrl} data-download-source={source}>On a Mac? Download for Mac</a>}
    <slot />
  </div>
</section>
