    "whatsNew.paste-last-dictation.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ever finish dictating only to realize your cursor wasn't focused in a text box? Or wanted to drop your exact last thought into a second app? Meet Paste Last Dictation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig diktiert, aber der Cursor stand in keinem Textfeld? Oder du möchtest denselben Gedanken in eine zweite App bringen? Hier kommt „Letztes Diktat einfügen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà fini de dicter avant de vous rendre compte que le curseur n’était pas actif dans une zone de texte ? Ou peut-être vouliez-vous insérer votre dernière pensée exactement telle quelle dans une autre app ? Découvrez Coller la dernière dictée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Alguna vez terminaste de dictar y te diste cuenta de que no había ningún campo de texto activo? ¿O quisiste pegar exactamente lo mismo en otra app? Para eso está Pegar el último dictado."
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.bullet.0" : {
      "comment" : "Settings > What's New: point 1 of the list under one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste instantly: ⌃⌘V drops your most recent transcription wherever your cursor is right now."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofort einfügen: ⌃⌘V fügt dein letztes Diktat dort ein, wo dein Cursor gerade steht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coller instantanément : ⌃⌘V insère votre transcription la plus récente là où se trouve actuellement votre curseur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pegar al instante: ⌃⌘V inserta tu transcripción más reciente donde esté el cursor en ese momento."
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.bullet.1" : {
      "comment" : "Settings > What's New: point 2 of the list under one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy to clipboard: ⌃⌘C puts it straight onto your clipboard so you can reuse it later."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In die Zwischenablage kopieren: ⌃⌘C legt es direkt in deine Zwischenablage, damit du es später weiterverwenden kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier dans le presse-papiers : ⌃⌘C la copie directement dans votre presse-papiers pour vous permettre de la réutiliser plus tard."
          }
