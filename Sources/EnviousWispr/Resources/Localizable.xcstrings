    "whatsNew.openai-model-support.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry openai-model-support).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI changed how its API calls work. We fixed them so their full library of models can be used for cloud polishing. This also includes smaller fixes, such as making sure you are notified if you forget to enter your API key."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI hat seine API-Aufrufe geändert. Wir haben die Anbindung angepasst, damit die gesamte Modellpalette für die Cloud-Nachbearbeitung nutzbar ist. Dazu kommen kleinere Korrekturen, etwa ein Hinweis, wenn du keinen API-Schlüssel eingegeben hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI a modifié le fonctionnement de ses appels d’API. Nous les avons adaptés afin que toute sa bibliothèque de modèles puisse être utilisée pour la retouche dans le cloud. Cette mise à jour comprend également de petites corrections, comme l’affichage d’une notification si vous oubliez de saisir votre clé d’API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI cambió el funcionamiento de su API. Adaptamos la app para que puedas usar todos sus modelos con el Pulido en la nube. También corregimos algunos detalles: por ejemplo, ahora te avisamos si falta tu clave de API."
          }
        }
      }
    },
