    "whatsNew.ollama-download-progress.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry ollama-download-progress).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Manage Models row now shows a live progress bar while an Ollama model downloads, plus a Cancel button. No more wondering whether the download is stuck or how big it is."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter „Modelle verwalten“ siehst du beim Download eines Ollama-Modells jetzt einen Fortschrittsbalken und eine Schaltfläche zum Abbrechen. So erkennst du, wie weit der Download ist und ob er noch läuft."
          }
