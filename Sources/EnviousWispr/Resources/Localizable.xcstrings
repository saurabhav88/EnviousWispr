    "whatsNew.faster-polish-after-pause.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry faster-polish-after-pause).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first dictation after a quiet stretch now gets polished faster. The pre-warm probe talks to the LLM the same way a real polish does, so the first real call doesn't pay a cold-start tax."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein erstes Diktat nach einer längeren Pause wird jetzt schneller nachbearbeitet. Die vorbereitende Anfrage spricht mit dem Sprachmodell wie eine echte Nachbearbeitung, damit der erste tatsächliche Aufruf keinen Kaltstart abwarten muss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre première dictée après une longue pause est maintenant retouchée plus rapidement. La requête de préchauffage communique avec le LLM comme une véritable retouche, afin que le premier appel réel ne subisse pas le délai d’un démarrage à froid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Pulido del primer dictado tras una pausa termina antes. La app prepara el modelo de IA con el mismo tipo de solicitud que usa para pulir el texto, así que la primera solicitud de Pulido no tiene que esperar a que el modelo se inicie."
          }
        }
      }
    },
