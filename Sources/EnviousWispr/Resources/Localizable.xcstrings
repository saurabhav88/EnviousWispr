    "whatsNew.live-preview-settings-decluttered.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry live-preview-settings-decluttered).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A less cluttered Live Preview settings screen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersichtlichere Einstellungen für die Live-Vorschau"
          }
        }
      }
    },
    "whatsNew.live-preview-settings-decluttered.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry live-preview-settings-decluttered).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved the Live Preview settings screen to be less cluttered."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen für die Live-Vorschau sind jetzt übersichtlicher."
          }
        }
      }
    },
    "whatsNew.settings-hover-states.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry settings-hover-states).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings respond as your pointer moves"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen reagieren auf den Mauszeiger"
          }
        }
      }
    },
    "whatsNew.settings-hover-states.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry settings-hover-states).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rows, cards, the sidebar and the History list respond to your pointer across the settings window, so it is clearer what is a control and what is only text."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen, Karten, die Seitenleiste und der Verlauf reagieren jetzt auf den Mauszeiger. So erkennst du leichter, was sich bedienen lässt und was nur Text ist."
          }
        }
      }
    },
    "whatsNew.deep-reasoning-retired.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry deep-reasoning-retired).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One less switch to think about"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Schalter weniger"
          }
        }
      }
    },
    "whatsNew.deep-reasoning-retired.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry deep-reasoning-retired).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI Polish page used to carry a Deep reasoning switch, which asked cloud models to think harder before polishing your text. We finally measured it, on the hundred hardest dictations we test with, using the Gemini model the app ships with. Thinking harder did not produce a difference we could tell apart from chance, and it made polishing take close to three times as long on the slower dictations. So the switch is gone. Every model now always uses the setting it was already using for virtually everyone, because it shipped off and stayed off for practically all of you. If you were one of the few who turned it on, polishing will finish noticeably sooner. Nothing else about polishing changes, and no other setting moves."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der Seite „KI-Nachbearbeitung“ gab es bisher den Schalter „Tiefes Schlussfolgern“. Damit sollten Cloud-Modelle vor der Nachbearbeitung länger nachdenken. Wir haben ihn mit dem mitgelieferten Gemini-Modell an unseren hundert schwierigsten Testdiktaten gemessen: Die Ergebnisse unterschieden sich nicht erkennbar vom Zufall, während die langsameren Nachbearbeitungen fast dreimal so lange dauerten. Deshalb entfällt der Schalter. Alle Modelle verwenden weiterhin die Einstellung, die ohnehin für fast alle aktiv war: Die Option war standardmäßig ausgeschaltet. Falls du sie eingeschaltet hattest, wird die Nachbearbeitung spürbar schneller fertig. Sonst ändert sich an der Nachbearbeitung und den Einstellungen nichts."
          }
        }
      }
    },
    "whatsNew.spoken-web-addresses.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry spoken-web-addresses).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictated web addresses come out ready to use"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktierte Webadressen sind sofort nutzbar"
          }
        }
      }
    },
    "whatsNew.spoken-web-addresses.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry spoken-web-addresses).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saying a web address out loud used to leave you something to fix by hand. A stray period at the end of a bare address is now dropped, while a real sentence period is kept. A leftover dot word sitting beside an address we already joined up is folded into the address. A garbled h slash slash from a half heard https is repaired before polish ever sees it. Dictating into the address bar of Safari, Chrome, Brave or Edge no longer adds a trailing space you have to delete. And in Chrome and Brave, pressing Return after dictating an address now goes there, which it did not before."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprochene Webadressen musstest du bisher manchmal von Hand korrigieren. Ein überflüssiger Punkt am Ende einer alleinstehenden Adresse fällt jetzt weg, ein echter Satzpunkt bleibt erhalten. Ein gesprochenes „Punkt“ neben einer bereits zusammengesetzten Adresse wird in die Adresse übernommen. Ein falsch erkanntes „h slash slash“ aus einem unvollständigen „https“ wird vor der Nachbearbeitung repariert. Beim Diktieren in die Adressleiste von Safari, Chrome, Brave oder Edge entsteht kein störendes Leerzeichen mehr am Ende. In Chrome und Brave öffnet Return nach dem Diktieren jetzt auch die Adresse."
          }
        }
      }
    },
    "whatsNew.saved-words-keep-address-endings.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry saved-words-keep-address-endings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your saved words no longer eat the end of an address"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Wörter verschlucken keine Webadress-Endungen mehr"
          }
        }
      }
    },
    "whatsNew.saved-words-keep-address-endings.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry saved-words-keep-address-endings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you had saved a word or phrase that looked like the start of a web address, correcting it could swallow the ending, so a company name with dot com stuck on it came back as the company name alone. Both places that could happen are fixed, and the ending now survives the correction."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein gespeichertes Wort oder eine Wortfolge wie der Anfang einer Webadresse aussah, konnte die Korrektur deren Endung verschlucken. Aus einem Firmennamen mit „.com“ wurde dann nur noch der Firmenname. Beide Ursachen sind behoben; die Endung bleibt erhalten."
          }
        }
      }
    },
    "whatsNew.filler-removal-respects-language.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry filler-removal-respects-language).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real German, Dutch, Danish and Norwegian words are no longer deleted"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echte Wörter in Deutsch, Niederländisch, Dänisch und Norwegisch bleiben erhalten"
          }
        }
      }
    },
    "whatsNew.filler-removal-respects-language.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry filler-removal-respects-language).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The step that strips out ums and uhs used an English list, and it ran whatever language you were dictating in. That deleted real, common words: er means he in German, there in Dutch, and is in Danish and Norwegian, and um is an ordinary German word too. Filler removal now reads the language you are dictating in and leaves those words alone. Every other word and every other language is unchanged."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entfernen von Fülllauten wie „äh“ wurde bisher unabhängig von der Diktiersprache eine englische Liste verwendet. Dadurch verschwanden echte, häufige Wörter: „er“ ist im Deutschen ein Pronomen, bedeutet im Niederländischen „dort“ und im Dänischen und Norwegischen „ist“. Auch „um“ ist ein normales deutsches Wort. Die Füllwortentfernung beachtet jetzt deine Diktiersprache und lässt diese Wörter stehen. Alle anderen Wörter und Sprachen bleiben unverändert."
          }
        }
      }
    },
    "whatsNew.smaller-wins-2-4-6.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smaller-wins-2-4-6).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The smaller wins"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere kleine Verbesserungen"
          }
        }
      }
    },
    "whatsNew.smaller-wins-2-4-6.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smaller-wins-2-4-6).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete, Cancel and Save stay visible in the custom word panel however many spellings you have saved against a word, and a long spelling wraps instead of pushing them off. Cancelling a model download you started yourself no longer stops the next automatic upgrade being offered. And if the speech engine was not ready when you finished speaking, your recording is kept and given another go rather than lost."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Löschen“, „Abbrechen“ und „Sichern“ bleiben im Fenster für eigene Wörter sichtbar, auch wenn zu einem Wort viele Schreibweisen gespeichert sind. Lange Schreibweisen werden umgebrochen. Wenn du einen selbst gestarteten Modelldownload abbrichst, wird dir das nächste automatische Upgrade weiterhin angeboten. Und war die Spracherkennung beim Ende deines Diktats noch nicht bereit, bleibt die Aufnahme erhalten und wird erneut verarbeitet."
          }
        }
      }
    },
    "whatsNew.escape-recovery-cancelled-dictations.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry escape-recovery-cancelled-dictations).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelled dictations are now recoverable!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgebrochene Diktate lassen sich jetzt wiederherstellen!"
          }
        }
      }
    },
    "whatsNew.escape-recovery-cancelled-dictations.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry escape-recovery-cancelled-dictations).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressing your cancel keybind used to discard your recording instantly. Turn on Escape Recovery, and your dictation is preserved instead. The app finishes transcribing and polishing, then displays a small pill offering an Undo button for three seconds, staying visible as long as your pointer rests on it. If you let it fade, the text waits in your History for 24 hours, where a Keep button makes it permanent. Only the text transcript is retained, never the audio. Escape Recovery is disabled by default. You can enable it in the Keybinds settings menu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher wurde deine Aufnahme beim Drücken des Abbrechen-Tastenkürzels sofort verworfen. Mit „Escape-Wiederherstellung“ bleibt sie stattdessen erhalten. Die App beendet Transkription und Nachbearbeitung und zeigt dann drei Sekunden lang eine kleine Anzeige mit „Rückgängig“. Solange dein Mauszeiger darauf liegt, bleibt sie sichtbar. Danach wartet der Text 24 Stunden im Verlauf; mit „Behalten“ speicherst du ihn dauerhaft. Nur das Transkript wird aufbewahrt, niemals die Audiodatei. „Escape-Wiederherstellung“ ist standardmäßig ausgeschaltet und lässt sich unter „Tastenkürzel“ aktivieren."
          }
        }
      }
    },
    "whatsNew.live-preview-words-while-you-speak.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry live-preview-words-while-you-speak).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You asked for this: see your words as you speak"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oft gewünscht: Sieh deine Wörter beim Sprechen"
          }
        }
      }
    },
    "whatsNew.live-preview-words-while-you-speak.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry live-preview-words-while-you-speak).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the one you have been asking for. The recording pill now shows your words as you speak them. The box starts compact and grows to five lines, then scrolls so the newest thing you said is always in view, and the pill has been rebuilt around it with a live meter, a cleaner header and the hands-free timer back where you can see it. Choose the engine that suits your Mac: Apple's is built into macOS 26 and needs no preview model, though some languages ask macOS for a language pack first, or take the universal one, a 217 MB download that runs on macOS 14 and later and covers far more languages. You pick your language on the Live Preview page, and you can switch the whole thing on or off whenever you like. Your finished text is as good as ever: when you stop, Parakeet or WhisperKit transcribes the whole recording from the very first word, then your custom words and polish run on top. So there is no need to let the preview catch up before you stop talking. Everything you said is already captured."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahmeanzeige zeigt jetzt deine Wörter, während du sprichst. Das Textfeld beginnt kompakt, wächst auf fünf Zeilen und scrollt dann mit, damit das Neueste sichtbar bleibt. Dazu gibt es eine Pegelanzeige, einen klareren Kopfbereich und den wieder sichtbaren Freisprech-Timer. Wähle die passende Erkennung für deinen Mac: Die von Apple ist in macOS 26 integriert und braucht kein Vorschau-Modell, wobei macOS für manche Sprachen zunächst ein Sprachpaket lädt. Die universelle Alternative benötigt einen Download von 217 MB, läuft ab macOS 14 und deckt deutlich mehr Sprachen ab. Auf der Seite „Live-Vorschau“ wählst du die Sprache und kannst die Funktion jederzeit ein- oder ausschalten. Der fertige Text bleibt genauso gut wie bisher: Nach dem Stoppen transkribiert Parakeet oder WhisperKit die gesamte Aufnahme ab dem ersten Wort. Danach werden deine eigenen Wörter und die Nachbearbeitung angewendet. Du musst also nicht warten, bis die Vorschau aufgeholt hat. Alles Gesagte ist bereits aufgenommen."
          }
        }
      }
    },
    "whatsNew.parakeet-language-selection.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry parakeet-language-selection).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language selection now available on Parakeet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachauswahl jetzt auch für Parakeet"
          }
        }
      }
    },
    "whatsNew.parakeet-language-selection.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry parakeet-language-selection).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you dictate in a language other than English, telling the app which language you speak now actually does something on Parakeet, the engine most people dictate with. It could not before: Parakeet has no language detection and no way of being told, so it worked purely from the sounds. Setting your language narrows what it produces to your own alphabet, so a German dictation stops coming back with stray Greek or Cyrillic characters in it. It cannot separate languages that share an alphabet, so it will not tell German from Dutch. If you use WhisperKit you could already set this, and nothing changes for you."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du nicht auf Englisch diktierst, wirkt sich deine Sprachauswahl jetzt auch auf Parakeet aus – die Erkennung, die die meisten verwenden. Bisher konnte Parakeet weder die Sprache erkennen noch eine vorgegebene Sprache annehmen und orientierte sich nur am Klang. Die Auswahl begrenzt die Ausgabe auf dein Alphabet. So tauchen in einem deutschen Diktat keine vereinzelten griechischen oder kyrillischen Zeichen mehr auf. Sprachen mit demselben Alphabet, etwa Deutsch und Niederländisch, kann Parakeet dadurch nicht unterscheiden. Bei WhisperKit war die Sprachauswahl bereits möglich; dort ändert sich nichts."
          }
        }
      }
    },
    "whatsNew.smart-import-five-more-apps.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smart-import-five-more-apps).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring your words across from five more dictation apps"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter aus fünf weiteren Diktier-Apps übernehmen"
          }
        }
      }
    },
    "whatsNew.smart-import-five-more-apps.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smart-import-five-more-apps).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching from another dictation app used to mean retyping your vocabulary one word at a time. EnviousWispr can now read custom words out of Vox, TypeWhisper, Spokenly, Juno and Handy, on top of FluidVoice, Superwhisper and Wispr Flow. Eight apps in all. It reads their files without changing them, and shows you every word it found before anything joins your library."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel von einer anderen Diktier-App musstest du deinen Wortschatz bisher Wort für Wort neu eingeben. EnviousWispr kann eigene Wörter jetzt auch aus Vox, TypeWhisper, Spokenly, Juno und Handy lesen – zusätzlich zu FluidVoice, Superwhisper und Wispr Flow. Das sind insgesamt acht Apps. Ihre Dateien werden dabei nicht verändert. Bevor ein Wort in deine Sammlung kommt, siehst du alle gefundenen Einträge."
          }
        }
      }
    },
    "whatsNew.eg1-retrained-on-weakest-spots.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry eg1-retrained-on-weakest-spots).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EG-1 has been retrained on its two weakest spots"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EG-1 wurde an seinen zwei größten Schwächen neu trainiert"
          }
        }
      }
    },
    "whatsNew.eg1-retrained-on-weakest-spots.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry eg1-retrained-on-weakest-spots).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We spent this cycle retraining our built-in AI cleanup on the two things it was worst at, and both moved a long way. When you announce a list out loud, EG-1 used to hand you one long line almost every time: in our testing it built a real list under 1% of the time, and it now does it 83% of the time. When you change your mind mid-sentence, saying something like \"send it to Marcus, sorry, to Priya\", it keeps what you meant and drops what you took back 78% of the time, up from 71%, which puts it level with the frontier cloud models we measure ourselves against. It is also around 14% faster than the version it replaces. Those figures come from our own testing, on cases the model never trained on. Nothing changes about how you dictate. If you already use EG-1 the new version updates itself in the background the next time you open the app, with dictation working normally throughout, and you can pause that download and pick it up later from AI Polish settings, which now also shows which version you are on."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben die integrierte KI-Nachbearbeitung gezielt bei zwei schwierigen Aufgaben verbessert. Wenn du eine Liste ansagst, formatierte EG-1 sie in unseren Tests bisher in weniger als 1 % der Fälle als echte Liste; jetzt sind es 83 %. Wenn du dich mitten im Satz korrigierst, etwa „schick es an Marcus, nein, an Priya“, behält EG-1 in 78 % der Fälle die gemeinte Fassung und entfernt die verworfene – zuvor waren es 71 %. Damit liegt es auf dem Niveau der führenden Cloud-Modelle, mit denen wir es vergleichen. Außerdem ist es etwa 14 % schneller. Die Zahlen stammen aus eigenen Tests mit Fällen, auf denen das Modell nicht trainiert wurde. Für dich ändert sich beim Diktieren nichts. Wenn du EG-1 bereits nutzt, aktualisiert sich das Modell beim nächsten App-Start im Hintergrund; du kannst währenddessen normal diktieren. Den Download kannst du pausieren und später unter „KI-Nachbearbeitung“ fortsetzen. Dort siehst du jetzt auch deine Modellversion."
          }
        }
      }
    },
    "whatsNew.cloud-polish-prompt-v7.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry cloud-polish-prompt-v7).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud AI polish got a better set of instructions"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Anweisungen für die KI-Nachbearbeitung in der Cloud"
          }
        }
      }
    },
    "whatsNew.cloud-polish-prompt-v7.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry cloud-polish-prompt-v7).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you bring your own OpenAI, Claude or Gemini key, we rewrote the instructions we send along with your dictation, and it is the biggest gain we have measured on the cloud path. On our benchmark Claude went from 80% to 88%, OpenAI's newer models from 88% to 94%, and Gemini from 88% to 91%, with critical errors down by a third to a half across all three. Spoken lists moved furthest: on OpenAI, announcing a list out loud produced a real list 57% of the time before and 93% of the time now. New Gemini setups also start on 3.7 Flash, which scored highest of the three Gemini models we tested and costs about 29% less to run than the one it replaces. Nothing changes about how you dictate, and if you have already picked a model we leave your choice exactly as it is."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen eigenen Schlüssel für OpenAI, Claude oder Gemini verwendest, erhält das Modell jetzt überarbeitete Anweisungen zu deinem Diktat. Das ist der größte gemessene Fortschritt bei der Cloud-Nachbearbeitung: In unserem Test stieg Claude von 80 % auf 88 %, neuere OpenAI-Modelle von 88 % auf 94 % und Gemini von 88 % auf 91 %. Kritische Fehler gingen bei allen drei um etwa ein Drittel bis zur Hälfte zurück. Besonders stark verbesserten sich gesprochene Listen: Bei OpenAI wurden daraus zuvor in 57 % der Fälle echte Listen, jetzt in 93 %. Bei einer neuen Gemini-Einrichtung ist außerdem 3.7 Flash voreingestellt. Dieses Modell erzielte unter drei getesteten Gemini-Modellen das beste Ergebnis und kostet im Betrieb etwa 29 % weniger als das zuvor voreingestellte Modell. Beim Diktieren ändert sich nichts; ein bereits gewähltes Modell bleibt ausgewählt."
          }
        }
      }
    },
    "whatsNew.ollama-model-recommendations-from-tests.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry ollama-model-recommendations-from-tests).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revised Ollama recommendations"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überarbeitete Ollama-Empfehlungen"
          }
        }
      }
    },
    "whatsNew.ollama-model-recommendations-from-tests.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry ollama-model-recommendations-from-tests).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama model labels used to be based on model size, which did not show how well they cleaned up dictation. They now reflect our own cleanup tests and explain what went wrong. New Ollama setups now start with qwen2.5:3b, the best result among the local models we offer. There is also a new option, qwen3:0.6b, which earned a Recommended label from a download about a quarter the size, so a small download no longer means poor cleanup. Models that produced no acceptable result ask before downloading."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kennzeichnungen der Ollama-Modelle richteten sich bisher nach der Modellgröße. Das sagte wenig darüber aus, wie gut sie Diktate nachbearbeiten. Jetzt beruhen sie auf unseren eigenen Tests und erklären, was dabei schiefging. Bei einer neuen Ollama-Einrichtung ist qwen2.5:3b voreingestellt – das beste der angebotenen lokalen Modelle in unseren Tests. Neu ist auch qwen3:0.6b: Trotz eines etwa viermal kleineren Downloads erhielt es die Kennzeichnung „Empfohlen“. Bei Modellen ohne akzeptables Testergebnis wird vor dem Download nachgefragt."
          }
        }
      }
    },
    "whatsNew.virtual-microphone-silence-fixed.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry virtual-microphone-silence-fixed).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If dictation was recording silence, that is fixed"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktate mit Stille statt Ton: behoben"
          }
        }
      }
    },
    "whatsNew.virtual-microphone-silence-fixed.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry virtual-microphone-silence-fixed).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your Mac's default microphone was a virtual one, the kind that Krisp, Loopback, BlackHole, an aggregate device or a meeting app installs, EnviousWispr took it at its word and recorded digital silence. Not quieter audio, nothing at all, every single time. Across the four releases we have data for, not one dictation on a device like that ever succeeded. The app now reads what the device actually is before binding to it, and picks a real microphone over one of these whenever you have one. If a virtual device is genuinely the only input on your Mac, it is still used, because refusing it would leave you with nothing to record with at all. If you tried EnviousWispr, got nothing back, and assumed it was broken: it was, and it is worth another go."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "War das Standardmikrofon deines Mac ein virtuelles Gerät, etwa von Krisp, Loopback, BlackHole, einem kombinierten Audiogerät oder einer Meeting-App, nahm EnviousWispr digitale Stille auf. Nicht bloß leisen Ton, sondern jedes Mal gar keinen Ton. In den vier Versionen, für die wir Daten haben, gelang auf solchen Geräten kein einziges Diktat. Die App prüft jetzt, um welches Gerät es sich tatsächlich handelt, und bevorzugt ein echtes Mikrofon, falls eines vorhanden ist. Ist ein virtuelles Gerät dein einziger Eingang, wird es weiterhin verwendet. Falls du EnviousWispr ausprobiert hast und nie Text zurückbekamst: Das war ein Fehler. Ein neuer Versuch lohnt sich."
          }
        }
      }
    },
    "whatsNew.smaller-wins-2-4-5.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smaller-wins-2-4-5).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The smaller wins"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere kleine Verbesserungen"
          }
        }
      }
    },
    "whatsNew.smaller-wins-2-4-5.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smaller-wins-2-4-5).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A handful of smaller improvements. The Shortcuts page is now called Keybinds, and everywhere that used to say \"hotkey\" now says \"keybind\", so one thing has one name. Live transcription is now called Faster Transcription, because changing when your text lands is what it actually does. Noisy rooms no longer eat the start of your sentence, though if you use auto-stop its timing will move in those rooms: usually stopping sooner, and on the half-second setting sometimes waiting longer or not stopping on its own at all. Pasting is around four times quicker, down from roughly 265 milliseconds to under 60 in most apps, because your dictation no longer waits on the clipboard handover before counting itself done. Dictating into a terminal no longer quietly gives up part way through a session, where the only cure used to be quitting and reopening the app. Recordings are no longer cut short as though nothing was heard, which could happen when a quiet opening ate the app's patience before you had really started. Dragging a pill no longer leaves a ghost copy of it stranded on screen. Changing your dictation keybind can no longer set a recording going by accident. A single modifier key now works as your cancel keybind, where before it would save and display and then quietly do nothing. And if you run EnviousWispr straight from your Downloads folder, its offer to move itself into Applications now actually works."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige weitere Änderungen: „Shortcuts“ heißt jetzt „Tastenkürzel“, und „Hotkey“ wurde überall durch denselben Begriff ersetzt. „Live-Transkription“ heißt nun „Schnellere Transkription“, denn die Funktion beeinflusst, wann dein Text erscheint. In lauten Räumen geht der Satzanfang nicht mehr verloren. Bei automatischem Stopp kann sich dort allerdings der Zeitpunkt ändern: meist stoppt die Aufnahme früher; bei der Einstellung von einer halben Sekunde kann sie länger warten oder gar nicht selbst stoppen. Das Einfügen ist in den meisten Apps etwa viermal schneller – meist unter 60 statt ungefähr 265 Millisekunden –, weil das Diktat nicht mehr auf die Übergabe an die Zwischenablage wartet. Diktate im Terminal brechen während einer Sitzung nicht mehr unbemerkt ab. Aufnahmen werden nach einem leisen Anfang nicht mehr vorzeitig beendet. Beim Verschieben bleibt keine Geisterkopie der Aufnahmeanzeige zurück. Das Ändern des Diktier-Tastenkürzels startet keine Aufnahme mehr versehentlich. Auch eine einzelne Sondertaste funktioniert jetzt als Abbrechen-Tastenkürzel. Und wenn du EnviousWispr direkt aus „Downloads“ startest, funktioniert das angebotene Verschieben nach „Programme“ jetzt."
          }
        }
      }
    },
    "whatsNew.globe-key-dictation-hotkey.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry globe-key-dictation-hotkey).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Globe key, or Fn, as your dictation keybind"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Globus- oder Fn-Taste zum Diktieren verwenden"
          }
        }
      }
    },
    "whatsNew.globe-key-dictation-hotkey.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry globe-key-dictation-hotkey).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can now use the Globe key, marked Fn on many Macs, as your dictation keybind. Right Option stays exactly as it is unless you choose Globe. If macOS also opens emoji, switches your keyboard language, or starts its own dictation when you press it, go to System Settings, then Keyboard, then Press 🌐 key to, and choose Do Nothing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jetzt die Globus-Taste, die auf vielen Macs mit Fn beschriftet ist, als Diktier-Tastenkürzel verwenden. Die rechte Wahltaste bleibt unverändert, solange du nicht Globus auswählst. Wenn macOS beim Drücken zusätzlich Emoji öffnet, die Tastatursprache wechselt oder die eigene Diktierfunktion startet, öffne „Systemeinstellungen“ > „Tastatur“ > „🌐-Taste drücken“ und wähle „Keine Aktion“."
          }
        }
      }
    },
    "whatsNew.ollama-cloud-models-appear-automatically.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry ollama-cloud-models-appear-automatically).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama Cloud models now appear automatically"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama Cloud-Modelle erscheinen jetzt automatisch"
          }
        }
      }
    },
    "whatsNew.ollama-cloud-models-appear-automatically.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry ollama-cloud-models-appear-automatically).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama Cloud models used to appear in Manage Models only after you added them on that Mac. The full lineup now appears there automatically on every install and after every update. The button now says Add instead of Download because nothing is downloading, and cloud models can no longer be deleted. For 30 days after the August 5, 2026 check, the models available without a paid Ollama plan are listed first. After that the list returns to a neutral order."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama Cloud-Modelle erschienen bisher erst unter „Modelle verwalten“, nachdem du sie auf diesem Mac hinzugefügt hattest. Jetzt ist das gesamte Angebot nach jeder Installation und Aktualisierung automatisch sichtbar. Die Taste heißt „Hinzufügen“ statt „Laden“, weil nichts heruntergeladen wird; Cloud-Modelle lassen sich auch nicht mehr löschen. Für 30 Tage nach der Prüfung vom 5. August 2026 stehen Modelle, die ohne kostenpflichtigen Ollama-Tarif verfügbar sind, oben. Danach wird die Liste wieder neutral sortiert."
          }
        }
      }
    },
    "whatsNew.ollama-cloud-supported-end-to-end.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry ollama-cloud-supported-end-to-end).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama Cloud models are now properly supported end to end"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama Cloud-Modelle werden jetzt durchgehend unterstützt"
          }
        }
      }
    },
    "whatsNew.ollama-cloud-supported-end-to-end.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry ollama-cloud-supported-end-to-end).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you polish with an Ollama Cloud model, EnviousWispr used to treat it as a small model running on your Mac. It gave the model too little room to work, spent your cloud quota on warm-up calls it did not need, and when something failed it told you to start Ollama even though Ollama was already running. Cloud models are now recognised for what they are, and if you are signed out of Ollama the message says so. Models that run on your own Mac also get a prompt written for them, replacing one that was quietly working against itself on most dictations."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Nachbearbeitung mit einem Ollama Cloud-Modell behandelte EnviousWispr es bisher wie ein kleines Modell auf deinem Mac. Es bekam zu wenig Raum für seine Arbeit, verbrauchte Cloud-Kontingent für unnötige Vorbereitungsanfragen und meldete bei Fehlern, du solltest Ollama starten – auch wenn es bereits lief. Cloud-Modelle werden jetzt richtig erkannt. Wenn du bei Ollama abgemeldet bist, sagt dir die App das. Modelle auf deinem Mac erhalten außerdem passende Anweisungen statt der bisherigen, die bei vielen Diktaten eher störten."
          }
        }
      }
    },
    "whatsNew.ollama-settings-stay-accurate.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry ollama-settings-stay-accurate).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama settings and the model list now stay accurate"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama-Status und Modellliste bleiben aktuell"
          }
        }
      }
    },
    "whatsNew.ollama-settings-stay-accurate.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry ollama-settings-stay-accurate).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Ollama status in Settings could get stuck: still saying it was starting after it was ready, or still saying ready after you had quit Ollama. It now keeps itself current while you have the panel open. The model picker also showed two different models under one identical name, so there was no way to tell them apart. Each one is now labelled so you can."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ollama-Status in den Einstellungen konnte hängen bleiben: Er zeigte noch „Wird gestartet“, obwohl Ollama bereit war, oder weiterhin „Bereit“, nachdem du Ollama beendet hattest. Solange das Fenster offen ist, wird der Status jetzt aktualisiert. Auch zwei verschiedene Modelle mit bisher identischem Namen sind in der Modellauswahl nun unterscheidbar."
          }
        }
      }
    },
    "whatsNew.continuation-casing-eleven-languages.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry continuation-casing-eleven-languages).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictating into the middle of a sentence now works in eleven more languages"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätze in elf weiteren Sprachen korrekt weiterdiktieren"
          }
        }
      }
    },
    "whatsNew.continuation-casing-eleven-languages.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry continuation-casing-eleven-languages).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you type part of a sentence and dictate the rest, EnviousWispr matches the capitalisation you would have used yourself. Until now that only worked in English, so every other language got a capital letter dropped into the middle of your sentence. It now works in German, French, Italian, Spanish, Portuguese, Dutch, Danish, Swedish, Finnish, Russian and Turkish. Measured against real published writing, this went from right 7% of the time to right 94%. We also found several ways to make it more accurate everywhere, so it now works reliably in far more of the places you dictate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Satz anfängst zu tippen und den Rest diktierst, passt EnviousWispr die Großschreibung an. Bisher funktionierte das nur auf Englisch; in anderen Sprachen konnte mitten im Satz ein Großbuchstabe erscheinen. Jetzt klappt es auch auf Deutsch, Französisch, Italienisch, Spanisch, Portugiesisch, Niederländisch, Dänisch, Schwedisch, Finnisch, Russisch und Türkisch. Gemessen an veröffentlichten Texten stieg die Trefferquote von 7 % auf 94 %. Weitere Verbesserungen machen die Funktion auch an mehr Eingabestellen zuverlässig."
          }
        }
      }
    },
    "whatsNew.fewer-transcription-errors.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry fewer-transcription-errors).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fewer transcription errors"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Transkriptionsfehler"
          }
        }
      }
    },
    "whatsNew.fewer-transcription-errors.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry fewer-transcription-errors).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quick press with no dictation used to fire an error that had nothing to explain. No more. And a microphone that sent no audio at all now asks you to check your mic, instead of blaming transcription for something transcription never saw."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kurzer Tastendruck ohne gesprochenes Diktat löst keinen unerklärlichen Fehler mehr aus. Wenn ein Mikrofon überhaupt keinen Ton liefert, bittet dich die App jetzt, das Mikrofon zu prüfen, statt fälschlich die Transkription zu beschuldigen."
          }
        }
      }
    },
    "whatsNew.fixes-you-should-never-notice.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry fixes-you-should-never-notice).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes you should never notice"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrekturen, die du kaum bemerken solltest"
          }
        }
      }
    },
    "whatsNew.fixes-you-should-never-notice.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry fixes-you-should-never-notice).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom Words saves are now much more resilient to an app crash or a power cut. After an update, a leftover model file can no longer be mistaken for a good one. And the speech engine has picked up newer transcription repairs from upstream. All real, all invisible unless something goes wrong."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Wörter werden jetzt robuster gespeichert, auch bei einem App-Absturz oder Stromausfall. Nach einem Update kann eine übrig gebliebene Modelldatei nicht mehr für eine intakte gehalten werden. Außerdem übernimmt die Spracherkennung neuere Korrekturen ihres Ursprungsprojekts. Diese Änderungen fallen vor allem dann auf, wenn sonst etwas schiefgegangen wäre."
          }
        }
      }
    },
    "whatsNew.cursor-aware-capitalization.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry cursor-aware-capitalization).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictating after an incomplete sentence properly considers capitalization"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrekte Großschreibung beim Fortsetzen eines Satzes"
          }
        }
      }
    },
    "whatsNew.cursor-aware-capitalization.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry cursor-aware-capitalization).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you type part of a sentence and then dictate the rest, EnviousWispr now looks at the words already there before it writes. It matches the capitalization and spacing you would have used, so you no longer get a capital letter in the middle of your own sentence. If the dictation repeats a word you just typed, the duplicate is removed. This also works in your terminal when Claude Code, Codex or Gemini CLI is running."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Satz teilweise tippst und den Rest diktierst, betrachtet EnviousWispr jetzt den vorhandenen Text. Großschreibung und Leerzeichen werden passend ergänzt, statt mitten im Satz einen unnötigen Großbuchstaben einzufügen. Wiederholt das Diktat ein gerade getipptes Wort, wird das Duplikat entfernt. Das funktioniert auch im Terminal, während Claude Code, Codex oder Gemini CLI läuft."
          }
        }
      }
    },
    "whatsNew.spoken-punctuation-is-now-a-choice.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry spoken-punctuation-is-now-a-choice).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added a toggle to control spoken punctuation"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprochene Satzzeichen ein- oder ausschalten"
          }
        }
      }
    },
    "whatsNew.spoken-punctuation-is-now-a-choice.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry spoken-punctuation-is-now-a-choice).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saying \"comma\" or \"period\" used to always insert the punctuation mark, even when you meant the word. There is now a toggle for it under Speech Engine, in the Cleanup section. It is off by default, because EnviousWispr already adds punctuation for you. Turn it on if you prefer to dictate punctuation out loud, and the help icon beside it lists every word you can say."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus gesprochenem „Komma“ oder „Punkt“ wurde bisher immer ein Satzzeichen, auch wenn du das Wort meintest. Unter „Spracherkennung“ im Bereich „Bereinigung“ gibt es dafür jetzt einen Schalter. Er ist standardmäßig aus, weil EnviousWispr Satzzeichen bereits selbst setzt. Wenn du Satzzeichen lieber ausdrücklich diktierst, aktiviere ihn. Das Hilfesymbol daneben zeigt alle unterstützten Wörter."
          }
        }
      }
    },
    "whatsNew.parakeet-final-words.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry parakeet-final-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved how Parakeet hears the last few words of your dictation"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet erkennt das Ende deiner Diktate besser"
          }
        }
      }
    },
    "whatsNew.parakeet-final-words.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry parakeet-final-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet, the default speech engine, would sometimes add a word you never said at the very end of a dictation. \"I was able to\" could come back as \"I was able to do that.\" That no longer happens. Your dictation ends where you stopped speaking."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet, die standardmäßige Spracherkennung, fügte am Ende eines Diktats manchmal ein nie gesprochenes Wort hinzu. Aus „I was able to“ konnte „I was able to do that“ werden. Das passiert jetzt nicht mehr: Dein Diktat endet dort, wo du aufgehört hast zu sprechen."
          }
        }
      }
    },
    "whatsNew.bluetooth-wake-grace.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry bluetooth-wake-grace).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Further improved Bluetooth performance"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth funktioniert noch zuverlässiger"
          }
        }
      }
    },
    "whatsNew.bluetooth-wake-grace.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry bluetooth-wake-grace).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth microphones take a moment to start listening after you press, and EnviousWispr was giving up too early. A first press on AirPods or a headset could come back with nothing at all. It now waits for the connection to wake up, so you can press and start talking."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth-Mikrofone brauchen nach dem Tastendruck einen Moment, bis sie zuhören. EnviousWispr gab bisher manchmal zu früh auf, sodass der erste Versuch mit AirPods oder einem Headset leer blieb. Jetzt wartet die App, bis die Verbindung bereit ist. Du kannst drücken und lossprechen."
          }
        }
      }
    },
    "whatsNew.audio-error-reporting.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry audio-error-reporting).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved audio error reporting"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verständlichere Audiofehler"
          }
        }
      }
    },
    "whatsNew.audio-error-reporting.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry audio-error-reporting).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your microphone sent nothing usable, EnviousWispr showed a generic error with a Try Again button that would fail the same way. In one case it said nothing at all. You now get a plain sentence asking you to check your microphone. And if macOS loses track of your default microphone, EnviousWispr finds another connected one and carries on."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dein Mikrofon keinen brauchbaren Ton lieferte, zeigte EnviousWispr einen allgemeinen Fehler mit „Erneut versuchen“, obwohl der nächste Versuch genauso scheiterte. In einem Fall erschien gar keine Meldung. Jetzt wirst du verständlich gebeten, dein Mikrofon zu prüfen. Verliert macOS dein Standardmikrofon aus dem Blick, verwendet EnviousWispr ein anderes angeschlossenes Mikrofon."
          }
        }
      }
    },
    "whatsNew.help-icons-introduced.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry help-icons-introduced).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Began introducing help icons within the application"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Hilfesymbole in der App"
          }
        }
      }
    },
    "whatsNew.help-icons-introduced.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry help-icons-introduced).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We've recognized there's a lot of nuance to how our software works. You might start noticing help icons next to some toggles so you can better understand the features and capabilities."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Funktionen haben Feinheiten, die sich nicht sofort erschließen. Neben einigen Schaltern findest du deshalb jetzt Hilfesymbole, die ihre Wirkung erklären."
          }
        }
      }
    },
    "whatsNew.gemini-latest-models.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry gemini-latest-models).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updated Gemini API to support latest models"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini-API für aktuelle Modelle aktualisiert"
          }
        }
      }
    },
    "whatsNew.gemini-latest-models.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry gemini-latest-models).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google changed how its newer Gemini models accept requests, and several models in the picker had stopped working for cloud polish. They all work now. The default Gemini model has also been updated, since Google retired the previous one."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google hat geändert, wie neuere Gemini-Modelle Anfragen annehmen. Mehrere Modelle in der Auswahl funktionierten deshalb nicht mehr für die Cloud-Nachbearbeitung. Sie funktionieren jetzt wieder. Auch das standardmäßige Gemini-Modell wurde ersetzt, weil Google das vorige eingestellt hat."
          }
        }
      }
    },
    "whatsNew.smaller-repairs-recording-settings.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smaller-repairs-recording-settings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A handful of smaller repairs across recording and settings"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleinere Korrekturen bei Aufnahme und Einstellungen"
          }
        }
      }
    },
    "whatsNew.smaller-repairs-recording-settings.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smaller-repairs-recording-settings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Live transcription switched on, the last words you said could go missing while the transcript still looked complete. Settings could say your speech engine was ready before it actually was, so recording would not start. Hands-free mode could get stuck, leaving your keybind doing nothing. Recovering a recording that was interrupted is more dependable. And the app runs more steadily on the newest Macs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei eingeschalteter Live-Transkription konnten die letzten gesprochenen Wörter fehlen, obwohl das Transkript vollständig aussah. Die Einstellungen meldeten die Spracherkennung manchmal als bereit, bevor sie es war; dann startete keine Aufnahme. Der Freisprechmodus konnte hängen bleiben und das Tastenkürzel wirkungslos machen. Unterbrochene Aufnahmen lassen sich jetzt zuverlässiger wiederherstellen. Auf aktuellen Macs läuft die App außerdem stabiler."
          }
        }
      }
    },
    "whatsNew.import-words-from-another-app.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry import-words-from-another-app).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring your words over from another dictation app"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter aus einer anderen Diktier-App übernehmen"
          }
        }
      }
    },
    "whatsNew.import-words-from-another-app.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry import-words-from-another-app).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching no longer means retyping your vocabulary. Pick the app you used before and your words come across, including the misspellings you had it watch for. FluidVoice, Superwhisper and Wispr Flow are supported today, with more on the way, and only apps actually installed on your Mac are offered. Nothing on your disk is touched until you choose one, and nothing is added to your words until you review and approve it. On Macs where Apple Intelligence is available, EnviousWispr also suggests sound-alike spellings for your new words automatically, so dictation picks them up without a second pass by hand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel musst du deinen Wortschatz nicht mehr neu eintippen. Wähle deine bisherige App, und deine Wörter werden übernommen – auch die falschen Schreibweisen, auf die sie achten sollte. Derzeit werden FluidVoice, Superwhisper und Wispr Flow unterstützt; weitere folgen. Angeboten werden nur Apps, die auf deinem Mac installiert sind. Auf der Festplatte wird nichts verändert, bevor du eine App auswählst, und zu deinen Wörtern kommt erst nach deiner Prüfung und Zustimmung etwas hinzu. Wenn Apple Intelligence auf deinem Mac verfügbar ist, schlägt EnviousWispr für neue Wörter außerdem automatisch ähnlich klingende Schreibweisen vor."
          }
        }
      }
    },
    "whatsNew.import-words-from-file-or-paste.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry import-words-from-file-or-paste).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import words from a file, or just paste a list"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter aus einer Datei oder eingefügten Liste importieren"
          }
        }
      }
    },
    "whatsNew.import-words-from-file-or-paste.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry import-words-from-file-or-paste).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload a words file or a plain text file, or paste a list straight in. Every route lands on the same review screen, so you see exactly what will be added, what is already yours, and what clashes, before anything changes. On Macs where Apple Intelligence is available, new words can also get automatic sound-alike suggestions."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Wörterdatei oder einfache Textdatei aus, oder füge direkt eine Liste ein. Jeder Weg führt zur selben Prüfansicht. Dort siehst du vor der Übernahme, was neu ist, was du bereits hast und wo es Konflikte gibt. Auf Macs mit Apple Intelligence können für neue Wörter außerdem automatisch ähnlich klingende Schreibweisen vorgeschlagen werden."
          }
        }
      }
    },
    "whatsNew.export-words-backup.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry export-words-backup).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your words to a backup you own"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wörter als eigene Sicherung exportieren"
          }
        }
      }
    },
    "whatsNew.export-words-backup.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry export-words-backup).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your whole vocabulary to a file. Useful for a backup, for moving to a new Mac, or for sharing a set of words with someone else."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deinen gesamten Wortschatz in einer Datei – als Sicherung, für einen neuen Mac oder um Wörter mit jemandem zu teilen."
          }
        }
      }
    },
    "whatsNew.claude-cloud-polish-provider.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry claude-cloud-polish-provider).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude joins OpenAI and Gemini for cloud polish"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ergänzt OpenAI und Gemini bei der Cloud-Nachbearbeitung"
          }
        }
      }
    },
    "whatsNew.claude-cloud-polish-provider.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry claude-cloud-polish-provider).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring your own Anthropic key and let Claude clean up your dictation, with ten models to choose from. As always, it is your key and your account, and the app tells you exactly what gets sent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende deinen eigenen Anthropic-Schlüssel und lass Claude deine Diktate nachbearbeiten. Zehn Modelle stehen zur Auswahl. Es bleibt dein Schlüssel und dein Konto; die App zeigt dir genau, was gesendet wird."
          }
        }
      }
    },
    "whatsNew.bulk-select-delete-words.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry bulk-select-delete-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select and delete many words at once"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Wörter gleichzeitig auswählen und löschen"
          }
        }
      }
    },
    "whatsNew.bulk-select-delete-words.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry bulk-select-delete-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidy up your list without deleting one word at a time. If you are about to remove a lot, EnviousWispr offers to export them first so nothing disappears by accident."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume deine Liste auf, ohne jedes Wort einzeln zu löschen. Wenn du viele Wörter entfernen möchtest, bietet EnviousWispr zuvor einen Export an, damit nichts versehentlich verloren geht."
          }
        }
      }
    },
    "whatsNew.revamped-crash-recovery.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry revamped-crash-recovery).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revamped crash recovery"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellung nach Fehlern überarbeitet"
          }
        }
      }
    },
    "whatsNew.revamped-crash-recovery.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry revamped-crash-recovery).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our crash recovery system is smarter now. It actively tries to rescue a failed dictation wherever it can while the app is still running, not only after a crash. If the speech engine stops responding while you are still talking, EnviousWispr keeps the audio it already captured and transcribes it rather than losing the dictation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere Wiederherstellung rettet fehlgeschlagene Diktate jetzt nach Möglichkeit schon während die App läuft, nicht erst nach einem Absturz. Reagiert die Spracherkennung nicht mehr, während du noch sprichst, behält EnviousWispr den bereits aufgenommenen Ton und transkribiert ihn."
          }
        }
      }
    },
    "whatsNew.cloud-polish-longer-dictations.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry cloud-polish-longer-dictations).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better cloud polishing for long dictations"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Cloud-Nachbearbeitung langer Diktate"
          }
        }
      }
    },
    "whatsNew.cloud-polish-longer-dictations.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry cloud-polish-longer-dictations).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We reworked the output limits across all three cloud AI providers, so even a very long dictation has the room it needs to be polished in full."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben die Ausgabelimits aller drei Cloud-KI-Anbieter überarbeitet. So ist auch für die vollständige Nachbearbeitung sehr langer Diktate genug Platz."
          }
        }
      }
    },
    "whatsNew.two-copies-share-words-safely.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry two-copies-share-words-safely).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixed: a rare issue when the app was running twice"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoben: seltenes Problem bei zwei laufenden App-Kopien"
          }
        }
      }
    },
    "whatsNew.two-copies-share-words-safely.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry two-copies-share-words-safely).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you happened to have two copies of EnviousWispr running at the same time, your custom words could be affected. That is now handled properly."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn zwei Kopien von EnviousWispr gleichzeitig liefen, konnten deine eigenen Wörter betroffen sein. Das wird jetzt richtig behandelt."
          }
        }
      }
    },
    "whatsNew.model-download-improvements.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry model-download-improvements).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download improvements"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbesserte Downloads"
          }
        }
      }
    },
    "whatsNew.model-download-improvements.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry model-download-improvements).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We revamped how the speech and polish models download, and where they are stored on disk. Downloads are faster, resume on their own if your connection drops, and can be cancelled if they stall."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben Downloads und Speicherorte der Sprach- und Nachbearbeitungsmodelle überarbeitet. Downloads sind schneller, werden nach einem Verbindungsabbruch automatisch fortgesetzt und lassen sich bei einem Hänger abbrechen."
          }
        }
      }
    },
    "whatsNew.bluetooth-usb-audio-support.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry bluetooth-usb-audio-support).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proper Bluetooth and USB audio support"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuverlässige Unterstützung für Bluetooth- und USB-Audio"
          }
        }
      }
    },
    "whatsNew.bluetooth-usb-audio-support.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry bluetooth-usb-audio-support).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr now properly supports Bluetooth and USB microphones, including on Mac mini. We also rebuilt the entire infrastructure around our sound capture engine to be far more robust, so recording no longer fails quietly when a microphone misbehaves."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr unterstützt Bluetooth- und USB-Mikrofone jetzt richtig, auch auf dem Mac mini. Zudem haben wir die Audioaufnahme robuster gemacht, damit Aufnahmen bei Problemen mit dem Mikrofon nicht mehr unbemerkt scheitern."
          }
        }
      }
    },
    "whatsNew.recording-sound-cues.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry recording-sound-cues).",
