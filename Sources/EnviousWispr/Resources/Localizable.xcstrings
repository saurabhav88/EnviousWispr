      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved our error logging so we can spot issues and enhance your experience faster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben die Fehlerprotokollierung verbessert, damit wir Probleme schneller erkennen und die App verbessern können."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons amélioré la journalisation des erreurs pour repérer les problèmes et améliorer votre expérience plus rapidement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos mejorado el registro de errores para detectar problemas y mejorar tu experiencia más rápido."
          }
        }
      }
    },
    "whatsNew.welcome-to-2-0.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry welcome-to-2-0).",
