          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una píldora más ancha con un medidor junto al temporizador que muestra el volumen de tu voz en tiempo real con los colores del arcoíris."
          }
        }
      }
    },
