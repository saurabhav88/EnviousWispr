    },
    "whatsNew.five-smaller-fixes-2-4-7.bullet.3" : {
      "comment" : "Settings > What's New: point 4 of the list under one feature announcement (entry five-smaller-fixes-2-4-7).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bumped the OpenAI and Gemini request timeout from 5 seconds to 15 seconds to give complex polishing more room to finish."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zeitlimit für Anfragen an OpenAI und Gemini wurde von 5 auf 15 Sekunden erhöht, damit auch komplexe Nachbearbeitungen fertig werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai d’expiration des requêtes OpenAI et Gemini porté de 5 à 15 secondes pour laisser davantage de temps aux retouches complexes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos aumentado de 5 a 15 segundos el tiempo de espera de las solicitudes a OpenAI y Gemini para que el Pulido con IA tenga más tiempo en los casos complejos."
          }
        }
      }
    },
    "whatsNew.five-smaller-fixes-2-4-7.bullet.4" : {
      "comment" : "Settings > What's New: point 5 of the list under one feature announcement (entry five-smaller-fixes-2-4-7).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved speech parsing so saying \"two B\" outputs as \"2B\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachauswertung wurde verbessert: Aus gesprochenem „zwei B“ wird jetzt „2B“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amélioration de l’analyse vocale afin que « deux B » donne « 2B »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos mejorado el procesamiento de voz para que, al dictar “two B”, aparezca “2B”."
          }
