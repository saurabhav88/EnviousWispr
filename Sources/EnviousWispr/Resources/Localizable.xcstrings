    "whatsNew.parakeet-ultra.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry parakeet-ultra).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In our tests across 24 languages, Parakeet Ultra made about 19% fewer word errors than the old Parakeet, at the same speed. It downloads and switches over on its own."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In unseren Tests in 24 Sprachen machte Parakeet Ultra rund 19 % weniger Wortfehler als das bisherige Parakeet, bei gleicher Geschwindigkeit. Download und Umstellung erfolgen automatisch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de nos tests dans 24 langues, Parakeet Ultra a produit environ 19 % d’erreurs de mots en moins que l’ancien Parakeet, à la même vitesse. Son téléchargement et son activation sont automatiques."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En nuestras pruebas con 24 idiomas, Parakeet Ultra cometió aproximadamente un 19 % menos de errores de reconocimiento de palabras que la versión anterior de Parakeet, a la misma velocidad. La app lo descarga y empieza a usarlo automáticamente."
          }
        }
      }
    },
    "whatsNew.whisper-new-engine.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry whisper-new-engine).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
