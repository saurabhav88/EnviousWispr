  # 20-21. a registration query git cannot answer never authorises a delete: the temp
  # directory is kept and named in a warning (the passing verdict stands), whether the query fails before removal (the
  # snapshot and its registration both survive) or while verifying afterwards.
  local call when
  for call in 1 3; do
    case "$call" in 1) when="before removal" ;; *) when="while verifying" ;; esac
    if ! inject '  listing="$(git -C "$REPO" worktree list --porcelain)" || return 1' \
      "  QUERIES=\$((\${QUERIES:-0} + 1)); [ \"\$QUERIES\" -ne $call ] || return 1; listing=\"\$(git -C \"\$REPO\" worktree list --porcelain)\" || return 1"; then
      check "the failing-query copy was made ($when)" "no" "yes"
