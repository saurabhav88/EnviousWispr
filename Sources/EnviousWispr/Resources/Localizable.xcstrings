    "whatsNew.right-option-push-to-talk.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry right-option-push-to-talk).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-to-talk now defaults to a single tap of Right Option. Faster to reach than a two-key combo, and easier to remember. You can still remap it in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Push-to-Talk genügt jetzt standardmäßig ein Druck auf die rechte Wahltaste. Das ist schneller erreichbar und leichter zu merken als eine Tastenkombination. In den Einstellungen kannst du die Belegung weiterhin ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyer pour parler utilise maintenant par défaut une seule pression sur la touche Option droite. C’est plus rapide qu’une combinaison de deux touches et plus facile à retenir. Vous pouvez toujours modifier ce raccourci dans les Réglages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsar para hablar ahora usa de forma predeterminada una sola pulsación de Opción derecha. Es más rápido que una combinación de dos teclas y más fácil de recordar. Aún puedes reasignarlo en Ajustes."
          }
        }
      }
    },
