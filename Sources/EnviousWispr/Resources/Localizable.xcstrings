        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa “Guardar” para terminar o elige otra."
          }
        }
      }
    },
    "Press Try again, or continue without AI polish.\nYou can turn it on later in Settings." : {
      "comment" : "Setup Getting ready subtitle: the polish model failed to load.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
