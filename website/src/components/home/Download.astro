---
import DownloadClosing from '../DownloadClosing.astro';
---

<DownloadClosing
  id="download"
  source="bottom-cta"
  description="Free dictation and AI polish, on your Mac. No account. No subscription."
>
  <div class="brew-install" id="install">
    <span>Prefer Homebrew?</span>
    <div>
      <code>brew install --cask saurabhav88/tap/enviouswispr</code>
      <button class="text-button" id="brew-copy" hidden>Copy</button>
    </div>
    <small role="status" id="brew-status"></small>
  </div>
</DownloadClosing>
