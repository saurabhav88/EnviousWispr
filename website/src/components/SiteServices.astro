      // #2953: anonymous visitors get a person too, so first-touch source
      // ($initial_referring_domain, $initial_utm_*) exists beside the last one.
      person_profiles: 'always',
      capture_pageview: true,
      capture_pageleave: true,
      autocapture: true,
      // #2953: defaults made explicit so a reader can see what is on.
      capture_dead_clicks: true,
      rageclick: true,
      // #2953: replay is switched on project-side (sampled, minimum duration);
      // the client side masks every input and any editable text, and blocks
