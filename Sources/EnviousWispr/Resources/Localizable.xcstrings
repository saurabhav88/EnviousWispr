        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für VoiceOver und Tastaturbedienung ausgelegt"
          }
        }
      }
    },
    "whatsNew.voiceover-and-keyboard.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry voiceover-and-keyboard).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr now reads cleanly with VoiceOver and is fully operable from the keyboard. Its keybind recorders, buttons, and update prompts announce themselves clearly and respond to keyboard control."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ist jetzt mit VoiceOver gut lesbar und vollständig per Tastatur bedienbar. Die Steuerelemente zum Festlegen von Tastenkürzeln, Tasten und Update-Hinweise werden von VoiceOver verständlich angekündigt und lassen sich per Tastatur bedienen."
          }
        }
      }
    },
    "whatsNew.clearer-polish-on-older-macs.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry clearer-polish-on-older-macs).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clearer polish on older Macs"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klarere Nachbearbeitung auf älteren Macs"
          }
        }
      }
    },
    "whatsNew.clearer-polish-on-older-macs.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry clearer-polish-on-older-macs).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Macs that cannot run Apple's on-device polish, EnviousWispr no longer shows a confusing \"polish failed\" note. It simply hands you your clean transcription, and onboarding now explains your polish options up front."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Macs, die Apples Nachbearbeitung auf dem Gerät nicht unterstützen, zeigt EnviousWispr keinen verwirrenden Hinweis „Nachbearbeitung fehlgeschlagen“ mehr. Du erhältst einfach deine saubere Transkription. Bei der Einrichtung werden deine Optionen für die Nachbearbeitung jetzt früh erklärt."
          }
        }
      }
    },
    "whatsNew.words-stay-out-of-diagnostics.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry words-stay-out-of-diagnostics).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your words stay out of diagnostics"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wörter bleiben aus Diagnoseberichten heraus"
          }
        }
      }
    },
    "whatsNew.words-stay-out-of-diagnostics.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry words-stay-out-of-diagnostics).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We added another layer to make sure your dictated words can never end up in crash reports or diagnostics. What you say stays yours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zusätzliche Schutzschicht verhindert, dass diktierte Wörter in Absturzberichten oder Diagnosedaten landen. Was du sagst, bleibt dein Inhalt."
          }
        }
      }
    },
    "whatsNew.open-source-and-verifiable.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry open-source-and-verifiable).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open source, and easy to verify"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Source und leicht überprüfbar"
          }
        }
      }
    },
    "whatsNew.open-source-and-verifiable.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry open-source-and-verifiable).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr is open source under the GPLv3 license, and every download now points you straight to the full source. You can see exactly what the app does."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ist unter der GPLv3-Lizenz Open Source. Bei jedem Download findest du jetzt einen direkten Link zum vollständigen Quellcode. So kannst du nachvollziehen, was die App tut."
          }
        }
      }
    },
    "whatsNew.paste-works-in-word-excel-pages.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-works-in-word-excel-pages).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting now lands in Word, Excel, and more"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfügen funktioniert jetzt in Word, Excel und weiteren Apps"
          }
        }
      }
    },
    "whatsNew.paste-works-in-word-excel-pages.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-works-in-word-excel-pages).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We fixed an issue where in some apps (Word, Excel, Pages, Numbers, OneNote, Sublime Text, Firefox) your dictation would say \"Copied\" but never actually paste. Your words now land in the document like everywhere else."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In manchen Apps – darunter Word, Excel, Pages, Numbers, OneNote, Sublime Text und Firefox – meldete ein Diktat bisher „Kopiert“, ohne den Text tatsächlich einzufügen. Jetzt erscheinen deine Wörter wie in anderen Apps direkt im Dokument."
          }
        }
      }
    },
    "whatsNew.small-ui-tweaks.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry small-ui-tweaks).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small UI tweaks for a cleaner experience"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Änderungen für eine klarere Oberfläche"
          }
        }
      }
    },
    "whatsNew.small-ui-tweaks.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry small-ui-tweaks).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tidier sidebar status card, History columns that stay readable in small windows, more reliable update delivery, and an AI badge that only appears when AI actually ran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine aufgeräumtere Statuskarte in der Seitenleiste, lesbare Verlaufsspalten auch in kleinen Fenstern, zuverlässigere Updates und ein KI-Symbol, das nur erscheint, wenn tatsächlich KI verwendet wurde."
          }
        }
      }
    },
    "whatsNew.import-names-from-contacts.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry import-names-from-contacts).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring in the names of people you know"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen aus deinen Kontakten übernehmen"
          }
        }
      }
    },
    "whatsNew.import-names-from-contacts.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry import-names-from-contacts).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One tap on \"Import from Contacts\" adds the people in your address book to your custom words, so a coworker's or friend's hard-to-spell name comes out right the first time. Everything stays on your Mac. Your contacts are never uploaded. EnviousWispr also quietly learns the common ways each name gets misheard, so it catches those too."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Klick auf „Aus Kontakten importieren“ übernimmst du Namen aus deinem Adressbuch in deine eigenen Wörter. So werden auch schwer zu schreibende Namen von Freunden oder Kollegen gleich richtig erkannt. Alles bleibt auf deinem Mac; deine Kontakte werden nie hochgeladen. EnviousWispr lernt außerdem häufige Fehlhörvarianten der Namen, um auch diese zu erkennen."
          }
        }
      }
    },
    "whatsNew.vocabulary-packs.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry vocabulary-packs).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocabulary packs for brands and jargon"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wortschatzpakete für Marken und Fachbegriffe"
          }
        }
      }
    },
    "whatsNew.vocabulary-packs.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry vocabulary-packs).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on a pack and EnviousWispr recognizes those words and capitalizes them the way they're meant to be written (AngularJS, Nivea, Acosta). Each pack has a searchable list, so you can see every word it covers and the spoken variants it catches."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere ein Paket, und EnviousWispr erkennt dessen Wörter und schreibt sie mit der richtigen Groß- und Kleinschreibung, etwa AngularJS, Nivea und Acosta. Jedes Paket enthält eine durchsuchbare Liste aller Wörter und ihrer erkannten Sprechvarianten."
          }
        }
      }
    },
    "whatsNew.no-swallowed-press-after-idle.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry no-swallowed-press-after-idle).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more swallowed first press after a break"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Tastendruck nach einer Pause geht nicht mehr verloren"
          }
        }
      }
    },
    "whatsNew.no-swallowed-press-after-idle.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry no-swallowed-press-after-idle).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you left the app idle for a while, your next recording could get eaten while it flashed a \"warming up\" notice, even though it was basically ready. It now quietly re-wakes in a fraction of a second and captures your words, including the very first one."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach längerer Inaktivität konnte die nächste Aufnahme verloren gehen, während kurz „Wird vorbereitet“ erschien – obwohl die App praktisch bereit war. Sie wird jetzt in einem Sekundenbruchteil wieder aktiv und erfasst auch dein erstes Wort."
          }
        }
      }
    },
    "whatsNew.simpler-settings-performance.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry simpler-settings-performance).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One less Settings tab to hunt through"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Reiter weniger in den Einstellungen"
          }
        }
      }
    },
    "whatsNew.simpler-settings-performance.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry simpler-settings-performance).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"Performance\" tab held just one control: how long to keep the engine loaded between recordings. It now sits at the bottom of the Transcription screen, right where it belongs, so Settings has one less place to look."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Reiter „Leistung“ enthielt nur eine Einstellung: wie lange die Spracherkennung zwischen Aufnahmen geladen bleibt. Sie steht jetzt unten auf der Seite „Transkription“. Damit musst du einen Reiter weniger durchsuchen."
          }
        }
      }
    },
    "whatsNew.automatic-update-checks.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry automatic-update-checks).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr keeps itself current"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr hält sich selbst aktuell"
          }
        }
      }
    },
    "whatsNew.automatic-update-checks.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry automatic-update-checks).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app now looks for new versions on its own: when you open it, when you come back to it, and quietly in the background. So a waiting improvement finds you instead of you having to go looking. There's also a clear \"Check for Updates\" control in Settings if you ever want to look right now."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App sucht jetzt selbst nach neuen Versionen: beim Öffnen, wenn du zu ihr zurückkehrst und unauffällig im Hintergrund. Verbesserungen finden so ihren Weg zu dir. Wenn du sofort nachsehen möchtest, gibt es in den Einstellungen weiterhin „Nach Updates suchen“."
          }
        }
      }
    },
    "whatsNew.soft-and-distant-speech-captured.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry soft-and-distant-speech-captured).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft and distant speech no longer gets dropped"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leise und entfernte Sprache geht nicht mehr verloren"
          }
        }
      }
    },
    "whatsNew.soft-and-distant-speech-captured.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry soft-and-distant-speech-captured).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you spoke quietly, whispered, or sat back from your mic, EnviousWispr would sometimes capture nothing at all. It now hears those faint and far-away words and writes them down, including a soft first word that used to get clipped off the start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du leise gesprochen, geflüstert oder weiter vom Mikrofon entfernt gesessen hast, konnte EnviousWispr manchmal gar nichts erfassen. Jetzt werden auch leise und entfernte Wörter aufgenommen – einschließlich eines leisen ersten Wortes, das zuvor abgeschnitten werden konnte."
          }
        }
      }
    },
    "whatsNew.no-false-warming-up-notice.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry no-false-warming-up-notice).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more false \"warming up\" notice"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein falscher Hinweis „Wird vorbereitet“ mehr"
          }
        }
      }
    },
    "whatsNew.no-false-warming-up-notice.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry no-false-warming-up-notice).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapping record again right after a quick tap or a \"changed my mind\" cancel could flash the \"warming up\" notice as if the app were starting cold, even though it was already warm and ready. That stray notice is gone: a warm app just records."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du direkt nach einem kurzen Tastendruck oder einem abgebrochenen Diktat erneut aufnehmen wolltest, konnte „Wird vorbereitet“ erscheinen, obwohl die App längst bereit war. Dieser Hinweis ist weg: Eine bereite App nimmt sofort auf."
          }
        }
      }
    },
    "whatsNew.removed-recording-environment-picker.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry removed-recording-environment-picker).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removed a setting that promised something it didn't do"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine wirkungslose Einstellung entfernt"
          }
        }
      }
    },
    "whatsNew.removed-recording-environment-picker.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry removed-recording-environment-picker).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The \"Recording Environment\" choice (Quiet, Normal, Noisy) sounded like it changed how well the app hears you in different surroundings. It never did that. We removed it so Settings only shows controls that actually do what they say."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auswahl „Aufnahmeumgebung“ mit „Ruhig“, „Normal“ und „Laut“ klang, als würde sie die Erkennung an deine Umgebung anpassen. Das tat sie nie. Wir haben sie entfernt, damit die Einstellungen nur wirksame Optionen zeigen."
          }
        }
      }
    },
    "whatsNew.speak-naturally-see-it-written.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry speak-naturally-see-it-written).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speak it naturally, see it written"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natürlich sprechen, richtig geschrieben sehen"
          }
        }
      }
    },
    "whatsNew.speak-naturally-see-it-written.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry speak-naturally-see-it-written).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr now formats what you dictate the way you actually mean it, automatically: phone numbers, money, percentages, years, dates, times, ordinals, decimals, number ranges, emails, and web addresses. Say \"five five five, one two three, four five six seven\" and you get 555-123-4567; \"eighty million dollars\" becomes $80 million; \"nineteen eighty seven\" becomes 1987. It even works when AI polish is turned off."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr formatiert Diktiertes jetzt automatisch so, wie du es meinst: Telefonnummern, Geldbeträge, Prozentwerte, Jahreszahlen, Daten, Uhrzeiten, Ordnungszahlen, Dezimalzahlen, Zahlenbereiche, E-Mail- und Webadressen. Aus „fünf fünf fünf, eins zwei drei, vier fünf sechs sieben“ wird 555-123-4567; aus „achtzig Millionen Dollar“ wird „80 Millionen Dollar“ und aus „neunzehnhundertsiebenundachtzig“ wird 1987. Das funktioniert auch bei ausgeschalteter KI-Nachbearbeitung."
          }
        }
      }
    },
    "whatsNew.more-reliable-updates.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry more-reliable-updates).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More reliable updates"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuverlässigere Updates"
          }
        }
      }
    },
    "whatsNew.more-reliable-updates.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry more-reliable-updates).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We improved how EnviousWispr installs new versions, so updates land cleanly instead of getting stuck partway. And if an update ever has trouble, the copy you already have keeps working."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr installiert neue Versionen jetzt zuverlässiger, statt während des Updates hängen zu bleiben. Sollte ein Update dennoch Probleme machen, funktioniert deine vorhandene App weiter."
          }
        }
      }
    },
    "whatsNew.polish-keeps-your-words.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry polish-keeps-your-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polish keeps your words, not your commands"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachbearbeitung behält deine Wörter, nicht deine Befehle"
          }
        }
      }
    },
    "whatsNew.polish-keeps-your-words.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry polish-keeps-your-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictate something that sounds like an instruction, like \"draft a Slack to Matt about the launch\", and on-device polish used to sometimes go write that message instead of cleaning up what you said. It now recognizes the difference and keeps your actual words."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Diktat wie eine Anweisung klang, etwa „schreib Matt eine Slack-Nachricht zum Start“, verfasste die Nachbearbeitung auf dem Gerät manchmal die Nachricht, statt deine gesprochenen Worte zu bereinigen. Jetzt erkennt sie den Unterschied und bewahrt deinen tatsächlichen Text."
          }
        }
      }
    },
    "whatsNew.honest-warm-up-then-instant.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry honest-warm-up-then-instant).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An honest warm-up, then instant presses"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichtbare Vorbereitung, danach sofortige Aufnahme"
          }
        }
      }
    },
    "whatsNew.honest-warm-up-then-instant.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry honest-warm-up-then-instant).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right after launch the speech engine takes a moment to warm up. You now see a clear indicator while that happens, instead of a start that looks frozen. Once it is warm, every press begins instantly with no flicker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkt nach dem Start braucht die Spracherkennung einen Moment zur Vorbereitung. Währenddessen siehst du jetzt eine klare Anzeige statt eines scheinbar eingefrorenen Starts. Danach beginnt jede Aufnahme sofort und ohne Flackern."
          }
        }
      }
    },
    "whatsNew.whisperkit-on-gpu.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry whisperkit-on-gpu).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faster WhisperKit transcription"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellere Transkription mit WhisperKit"
          }
        }
      }
    },
    "whatsNew.whisperkit-on-gpu.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry whisperkit-on-gpu).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We moved the WhisperKit speech engine from your Mac's Neural Engine onto its GPU. In our testing that is the faster path for WhisperKit, so transcription warms up and finishes quicker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WhisperKit nutzt jetzt die GPU deines Mac statt seiner Neural Engine. In unseren Tests ist das für WhisperKit schneller: Die Erkennung wird früher bereit und transkribiert zügiger."
          }
        }
      }
    },
    "whatsNew.steadier-under-the-hood-2-1.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry steadier-under-the-hood-2-1).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A steadier app under the hood"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine stabilere App im Hintergrund"
          }
        }
      }
    },
    "whatsNew.steadier-under-the-hood-2-1.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry steadier-under-the-hood-2-1).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We finished a major rebuild of how EnviousWispr is assembled and packaged. You won't see it directly, but it makes the app sturdier and lets us ship improvements to you faster and more safely."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben EnviousWispr grundlegend umgebaut und dabei auch überarbeitet, wie die App erstellt und verpackt wird. Du siehst das nicht direkt, aber es macht die App robuster und hilft uns, Verbesserungen schneller und sicherer bereitzustellen."
          }
        }
      }
    },
    "whatsNew.spoken-emoji.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry spoken-emoji).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speak an emoji"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji diktieren"
          }
        }
      }
    },
    "whatsNew.spoken-emoji.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry spoken-emoji).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the emoji's name followed by the word \"emoji\" while you dictate, like \"smiley face emoji\" or \"thumbs up emoji\", and EnviousWispr drops the glyph right in."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag beim Diktieren den Namen eines Emoji und danach „Emoji“, etwa „lachendes Gesicht Emoji“ oder „Daumen hoch Emoji“. EnviousWispr fügt das Zeichen direkt ein."
          }
        }
      }
    },
    "whatsNew.smart-language-detection.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smart-language-detection).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smarter language detection"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelligentere Spracherkennung"
          }
        }
      }
    },
    "whatsNew.smart-language-detection.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smart-language-detection).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the Multi-Language speech engine, EnviousWispr now notices when you keep dictating in the same non-English language and offers to lock it in. A fixed language makes transcription both faster and more accurate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der mehrsprachigen Spracherkennung bemerkt EnviousWispr jetzt, wenn du wiederholt in derselben anderen Sprache als Englisch diktierst, und bietet an, diese Sprache fest einzustellen. Eine feste Sprache macht die Transkription schneller und genauer."
          }
        }
      }
    },
    "whatsNew.newer-ai-polish-models.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry newer-ai-polish-models).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Newer AI Polish models"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuere Modelle für die KI-Nachbearbeitung"
          }
        }
      }
    },
    "whatsNew.newer-ai-polish-models.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry newer-ai-polish-models).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Polish now works with the latest models. We recommend Gemini 3.5 Flash, or OpenAI 5.4 mini or nano, for the best balance of speed and quality."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Nachbearbeitung unterstützt jetzt die neuesten Modelle. Für ein gutes Verhältnis von Tempo und Qualität empfehlen wir Gemini 3.5 Flash oder OpenAI 5.4 mini beziehungsweise nano."
          }
        }
      }
    },
    "whatsNew.steadier-under-the-hood.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry steadier-under-the-hood).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A steadier app under the hood"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine stabilere App im Hintergrund"
          }
        }
      }
    },
    "whatsNew.steadier-under-the-hood.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry steadier-under-the-hood).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We continued a major rebuild of how the app manages itself internally. You won't see it directly, but it makes EnviousWispr more stable and quicker for us to improve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben den größeren Umbau der internen App-Verwaltung fortgesetzt. Du siehst ihn nicht direkt, aber er macht EnviousWispr stabiler und erleichtert uns Verbesserungen."
          }
        }
      }
    },
    "whatsNew.right-option-push-to-talk.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry right-option-push-to-talk).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One key to talk"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Taste zum Sprechen"
          }
        }
      }
    },
    "whatsNew.right-option-push-to-talk.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry right-option-push-to-talk).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-to-talk now defaults to a single tap of Right Option. Faster to reach than a two-key combo, and easier to remember. You can still remap it in Settings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Push-to-Talk genügt jetzt standardmäßig ein Druck auf die rechte Wahltaste. Das ist schneller erreichbar und leichter zu merken als eine Tastenkombination. In den Einstellungen kannst du die Belegung weiterhin ändern."
          }
        }
      }
    },
    "whatsNew.ai-polish-keys-in-keychain.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry ai-polish-keys-in-keychain).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
