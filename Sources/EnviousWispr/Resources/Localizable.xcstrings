        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Korrekturen"
          }
        }
      }
    },
    "%@ fixes · e.g. %@" : {
      "comment" : "Your Words, vocabulary packs: under a pack. the first %@ is its number of fixes (never 1), the second example words separated by commas.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
