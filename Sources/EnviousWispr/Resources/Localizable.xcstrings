    "whatsNew.latest-cloud-models-and-smaller-fixes.bullet.1" : {
      "comment" : "Settings > What's New: point 2 of the list under one feature announcement (entry latest-cloud-models-and-smaller-fixes).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More time to undo a self-learned word."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Zeit, um das automatische Lernen eines Wortes rückgängig zu machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de temps pour annuler l’apprentissage automatique d’un mot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más tiempo para deshacer la incorporación de una palabra aprendida automáticamente."
          }
        }
      }
    },
    "whatsNew.latest-cloud-models-and-smaller-fixes.bullet.2" : {
      "comment" : "Settings > What's New: point 3 of the list under one feature announcement (entry latest-cloud-models-and-smaller-fixes).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop recording on silence can now wait up to 5 seconds of silence before it stops."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aufnahme bei Stille stoppen“ kann jetzt bis zu 5 Sekunden Stille abwarten, bevor die Aufnahme endet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter l’enregistrement en cas de silence peut désormais attendre jusqu’à 5 secondes de silence avant d’arrêter l’enregistrement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción “Detener la grabación al detectar silencio” ahora puede esperar hasta 5 segundos de silencio antes de detener la grabación."
          }
        }
      }
    },
    "whatsNew.latest-cloud-models-and-smaller-fixes.bullet.3" : {
      "comment" : "Settings > What's New: point 4 of the list under one feature announcement (entry latest-cloud-models-and-smaller-fixes).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
