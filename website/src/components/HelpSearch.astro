---
// Search trigger plus the overlay it opens. Presentation only: every ranking
// decision lives in src/utils/help-search.ts, which the assertion suites import
// directly so no test reconstructs the configuration.
interface Props {
  /** The index page renders a large inline field; other pages a compact button. */
  variant?: 'inline' | 'compact';
  /**
   * Render the dialog itself. EXACTLY ONE instance per page may do this.
   * The trigger is reusable; the dialog is not — two of them means duplicate
   * IDs for the overlay, label, input, status and results, so getElementById
   * silently binds everything to whichever comes first, the other dialog is
   * unreachable, and every aria reference is ambiguous.
   */
  withDialog?: boolean;
}
const { variant = 'compact', withDialog = true } = Astro.props;
---

{variant === 'inline' ? (
  <button type="button" class="help-search-inline" data-help-search-open aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <span>Search the help centre</span>
    <kbd>/</kbd>
  </button>
) : (
  <button type="button" class="help-search-compact" data-help-search-open aria-haspopup="dialog" aria-label="Search the help centre">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <span>Search</span>
    <kbd>/</kbd>
  </button>
)}

{withDialog && (
<div class="help-search-overlay" id="help-search-overlay" hidden>
  <div class="help-search-backdrop" data-help-search-close></div>
  <div class="help-search-panel" role="dialog" aria-modal="true" aria-labelledby="help-search-label">
    <label class="visually-hidden" id="help-search-label" for="help-search-input">Search the help centre</label>
    <div class="help-search-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input
        type="text"
        id="help-search-input"
        placeholder="What are you trying to do?"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="help-search-results"
        aria-autocomplete="list"
      />
      <button type="button" class="help-search-esc" data-help-search-close aria-label="Close search"><kbd>esc</kbd></button>
    </div>
    <p class="help-search-status" id="help-search-status" role="status" aria-live="polite"></p>
    <ul class="help-search-results" id="help-search-results" role="listbox" aria-label="Search results"></ul>
  </div>
</div>
)}

<script>
  const overlay = document.getElementById('help-search-overlay') as HTMLElement | null;
  const input = document.getElementById('help-search-input') as HTMLInputElement | null;
  const list = document.getElementById('help-search-results') as HTMLElement | null;
  const status = document.getElementById('help-search-status') as HTMLElement | null;
  if (overlay && input && list && status) {
    let engine: { search: (q: string) => { matchKind: string; results: any[] }; snippet: (r: any, q: string) => string } | null = null;
    let loading: Promise<void> | null = null;
    let active = -1;
    let lastFocus: HTMLElement | null = null;

    // One in-flight promise, memoised: opening twice while the corpus is still
    // downloading must not start a second fetch.
    function load(): Promise<void> {
      if (loading) return loading;
      loading = (async () => {
        const [{ buildHelpIndex, searchHelp, snippet }, docsRes] = await Promise.all([
          import('../utils/help-search'),
          fetch('/help-search-index.json'),
        ]);
        if (!docsRes.ok) throw new Error(`corpus ${docsRes.status}`);
        const index = buildHelpIndex(await docsRes.json());
        engine = { search: (q) => searchHelp(index, q), snippet: (r, q) => snippet(r, q) };
        // Render whatever is already typed. Someone who types (or clicks an
        // example chip) before the corpus lands would otherwise sit looking at
        // an empty dialog until they changed the text, because render() ran
        // once against a null engine and nothing re-ran it.
        render();
      })().catch((err) => {
        // Fails CLOSED and says so. An empty result list here would read as
        // "we have no article about that", which is a different and false claim.
        loading = null;
        engine = null;
        status.textContent = 'Search is unavailable right now. Browse by category below.';
        list.innerHTML = '';
        throw err;
      });
      return loading;
    }

    function open() {
      lastFocus = document.activeElement as HTMLElement;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      input.focus();
      // Re-render on EVERY open, not just the first. close() sets
      // aria-expanded=false, and load() is memoised, so reopening a dialog that
      // already has results returned the resolved promise without rendering:
      // the old results stayed on screen while the combobox reported itself
      // collapsed and could still point aria-activedescendant at a stale row.
      render();
      load().then(render).catch(() => {});
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      input.setAttribute('aria-expanded', 'false');
      lastFocus?.focus();
    }

    function render() {
      const q = input.value.trim();
      active = -1;
      input.removeAttribute('aria-activedescendant');
      if (!engine || !q) {
        list.innerHTML = '';
        status.textContent = '';
        input.setAttribute('aria-expanded', 'false');
        return;
      }
      const { matchKind, results } = engine.search(q);
      input.setAttribute('aria-expanded', results.length ? 'true' : 'false');

      if (!results.length) {
        list.innerHTML = '';
        status.textContent = `Nothing matches “${q}”. Try a different word, or browse by category.`;
        return;
      }
      status.textContent = matchKind === 'closest'
        ? `No exact match. ${results.length} closest article${results.length === 1 ? '' : 's'}.`
        : `${results.length} article${results.length === 1 ? '' : 's'}.`;

      list.innerHTML = results
        .map((r, i) => `
          <li role="option" id="help-search-opt-${i}" aria-selected="false" data-index="${i}">
            <a href="/help/${r.id}/">
              <span class="r-title">${escapeHtml(r.title)}</span>
              <span class="r-cat">${escapeHtml(r.categoryLabel)}</span>
              <span class="r-snip">${escapeHtml(engine!.snippet(r, q))}</span>
            </a>
          </li>`)
        .join('');
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    }

    function move(delta: number) {
      const items = Array.from(list.querySelectorAll('li'));
      if (!items.length) return;
      active = (active + delta + items.length) % items.length;
      items.forEach((li, i) => {
        li.setAttribute('aria-selected', i === active ? 'true' : 'false');
        li.classList.toggle('is-active', i === active);
      });
      // Focus stays on the combobox by design, so without this a screen reader
      // is told nothing when the arrow keys move: the visual class change is
      // the only signal, which is no signal at all for Aaron.
      input.setAttribute('aria-activedescendant', items[active].id);
      items[active].scrollIntoView({ block: 'nearest' });
    }

    document.querySelectorAll('[data-help-search-open]').forEach((b) => b.addEventListener('click', open));
    document.querySelectorAll('[data-help-search-close]').forEach((b) => b.addEventListener('click', close));
    input.addEventListener('input', render);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') {
        const link = list.querySelectorAll('li')[active]?.querySelector('a') as HTMLAnchorElement | undefined;
        if (link) { e.preventDefault(); window.location.href = link.href; }
      }
    });

    // Escape and Tab are handled on the DIALOG, not the input: focus moves to
    // the close button and to results, and an Escape bound to the input stops
    // working the moment it does. Tab is cycled so it cannot reach the page
    // behind an open modal.
    overlay.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key !== 'Tab') return;
      const focusable = [input, ...overlay.querySelectorAll<HTMLElement>('button, a[href]')]
        .filter((el) => el && el.offsetParent !== null);
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });

    document.addEventListener('keydown', (e) => {
      if (!overlay.hidden) return;
      const t = e.target as HTMLElement;
      const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
      if (typing) return;
      if (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k')) {
        e.preventDefault();
        open();
      }
    });
  }
</script>

<style is:global>
  /* Result rows are built at runtime via innerHTML, so they never get Astro's
     scoping attribute and a scoped selector silently does not apply. These are
     global for that reason, namespaced under .help-search-results so nothing
     else can match them. Caught in a browser: every build check passed while
     results rendered as one run-on default-blue link. */
  .help-search-results a {
    display: grid; gap: 3px; padding: 11px 12px; border-radius: 10px;
    text-decoration: none; color: inherit;
  }
  .help-search-results li.is-active a, .help-search-results a:hover { background: var(--accent-soft); }
  .help-search-results .r-title { font-weight: 650; color: var(--text); font-size: 15px; }
  .help-search-results .r-cat { font-family: var(--font-mono); font-size: 11px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.04em; }
  .help-search-results .r-snip { font-size: 13px; color: var(--text-2); line-height: 1.45; }
</style>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .help-search-inline, .help-search-compact {
    display: flex; align-items: center; gap: 10px; width: 100%;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-btn); color: var(--text-3);
    font-family: var(--font-body); cursor: pointer; text-align: left;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .help-search-inline { padding: 15px 18px; font-size: 16px; }
  .help-search-compact { padding: 9px 12px; font-size: 14px; }
  .help-search-inline:hover, .help-search-compact:hover,
  .help-search-inline:focus-visible, .help-search-compact:focus-visible {
    border-color: var(--accent); color: var(--text-2);
  }
  .help-search-inline span, .help-search-compact span { flex: 1; }

  kbd {
    font-family: var(--font-mono); font-size: 11px; color: var(--text-3);
    border: 1px solid var(--border); border-radius: 5px; padding: 2px 6px;
    background: var(--bg);
  }

  .help-search-overlay { position: fixed; inset: 0; z-index: 2000; }
  .help-search-backdrop { position: absolute; inset: 0; background: rgba(15, 10, 26, 0.4); backdrop-filter: blur(3px); }

  .help-search-panel {
    position: relative; max-width: 640px; margin: 10vh auto 0;
    background: var(--bg); border: 1px solid var(--border-hover);
    border-radius: var(--radius-card); box-shadow: 0 24px 60px rgba(15, 10, 26, 0.22);
    overflow: hidden;
  }

  .help-search-field { display: flex; align-items: center; gap: 10px; padding: 16px 18px; border-bottom: 1px solid var(--border); color: var(--text-3); }
  .help-search-field input {
    flex: 1; border: 0; outline: 0; background: transparent;
    font-family: var(--font-body); font-size: 17px; color: var(--text);
  }
  .help-search-esc { background: none; border: 0; cursor: pointer; padding: 0; }

  .help-search-status { margin: 0; padding: 10px 18px; font-size: 13px; color: var(--text-3); }
  .help-search-status:empty { display: none; }

  .help-search-results { list-style: none; margin: 0; padding: 0 8px 8px; max-height: 55vh; overflow-y: auto; }

  @media (prefers-reduced-motion: reduce) {
    .help-search-inline, .help-search-compact { transition: none; }
  }
</style>
