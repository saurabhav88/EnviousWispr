import '../styles/home/index.css';
import Hero from '../components/home/Hero.astro';
import CompatibleApps from '../components/home/CompatibleApps.astro';
import Workflow from '../components/home/Workflow.astro';
import SpeechEngines from '../components/home/SpeechEngines.astro';
import Providers from '../components/home/Providers.astro';
import Cleanup from '../components/home/Cleanup.astro';
import UseCases from '../components/home/UseCases.astro';
import Evidence from '../components/home/Evidence.astro';
