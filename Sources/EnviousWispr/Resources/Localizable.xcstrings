    "whatsNew.words-stay-out-of-diagnostics.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry words-stay-out-of-diagnostics).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We added another layer to make sure your dictated words can never end up in crash reports or diagnostics. What you say stays yours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine zusätzliche Schutzschicht verhindert, dass diktierte Wörter in Absturzberichten oder Diagnosedaten landen. Was du sagst, bleibt dein Inhalt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons ajouté une protection supplémentaire pour que vos mots dictés ne puissent jamais se retrouver dans les rapports de plantage ou les données de diagnostic. Ce que vous dites reste à vous."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos añadido otra medida de protección para que el texto que dictas nunca se incluya en informes de cierres inesperados ni en datos de diagnóstico. Lo que dices sigue siendo tuyo."
          }
        }
      }
    },
    "whatsNew.open-source-and-verifiable.title" : {
