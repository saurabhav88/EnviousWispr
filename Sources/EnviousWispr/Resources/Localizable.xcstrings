    "whatsNew.spoken-punctuation-more-languages.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry spoken-punctuation-more-languages).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added spoken punctuation support for German, French, Spanish, and Italian using localized trigger words (e.g., \"Diktiere Punkt\" in German)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprochene Satzzeichen gibt es jetzt auf Deutsch, Französisch, Spanisch und Italienisch, mit Startwörtern in der jeweiligen Sprache (z. B. „Diktiere Punkt“ auf Deutsch)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prise en charge de la ponctuation dictée en allemand, français, espagnol et italien, avec des mots-clés localisés, par exemple « Diktiere Punkt » en allemand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos añadido compatibilidad con la puntuación hablada en alemán, francés, español e italiano mediante comandos de voz en cada idioma, como “Diktiere Punkt” en alemán."
          }
        }
      }
    },
