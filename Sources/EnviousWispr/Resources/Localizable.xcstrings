        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inglés: di “period” para insertar un punto"
          }
        }
      }
    },
    "EnviousMeet" : {
      "comment" : "Menu bar menu, VoiceOver: the icon beside the meeting recording item.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet"
          }
        }
      }
    },
    "EnviousMeet can ask to record when a call app starts using your microphone." : {
      "comment" : "EnviousMeet page: the short line under When a call starts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet kann dich fragen, ob du einen Anruf aufnehmen möchtest, sobald eine Anruf-App dein Mikrofon nutzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet peut vous proposer d’enregistrer lorsqu’une app d’appel commence à utiliser votre micro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet puede preguntarte si quieres grabar cuando una app de llamadas empiece a usar tu micrófono."
          }
        }
      }
    },
    "EnviousMeet can't see your mute button, so your voice is being recorded." : {
      "comment" : "EnviousMeet, while recording: the mute button can no longer be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet kann deine Stummschalttaste nicht erkennen, daher wird deine Stimme aufgenommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet ne peut pas voir votre bouton de désactivation du son ; votre voix est donc enregistrée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet no puede leer el estado de tu botón de silencio, así que sigue grabando tu voz."
          }
        }
      }
    },
    "EnviousMeet checks for calls on your Mac and never sends this anywhere." : {
      "comment" : "EnviousMeet Call Apps tab: the privacy line under the list of call apps.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet prüft Anrufe auf deinem Mac und sendet diese Angaben nirgendwohin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet recherche les appels sur votre Mac et ne transmet jamais ces informations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet comprueba si hay llamadas en tu Mac y nunca envía esa información a ningún sitio."
          }
        }
      }
    },
    "EnviousMeet checks which app uses your microphone and whether a call window or meeting page is open. It checks on your Mac and never sends this anywhere. Meetings in a browser covers Google Meet, Zoom, Microsoft Teams, Webex, Whereby and Jitsi in Chrome, Safari, Arc, Dia, Edge, Brave, Opera, Vivaldi, Zen, Comet and ChatGPT Atlas." : {
      "comment" : "EnviousMeet page: help for Notice calls in. App and browser names are not translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet prüft, welche App dein Mikrofon nutzt und ob ein Anruffenster oder eine Meeting-Seite geöffnet ist. Diese Prüfung erfolgt auf deinem Mac. Die Informationen bleiben dort und werden nicht übertragen. „Meetings im Browser“ umfasst Google Meet, Zoom, Microsoft Teams, Webex, Whereby und Jitsi in Chrome, Safari, Arc, Dia, Edge, Brave, Opera, Vivaldi, Zen, Comet und ChatGPT Atlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet vérifie quelle app utilise votre micro et si une fenêtre d’appel ou une page de réunion est ouverte. Ces vérifications sont effectuées sur votre Mac et aucune information n’est transmise. « Réunions dans un navigateur » couvre Google Meet, Zoom, Microsoft Teams, Webex, Whereby et Jitsi dans Chrome, Safari, Arc, Dia, Edge, Brave, Opera, Vivaldi, Zen, Comet et ChatGPT Atlas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet comprueba qué app usa tu micrófono y si hay una ventana de llamada o una página de reunión abierta. Hace la comprobación en tu Mac y nunca envía esa información a ningún sitio. La opción “Reuniones en un navegador” es compatible con Google Meet, Zoom, Microsoft Teams, Webex, Whereby y Jitsi en Chrome, Safari, Arc, Dia, Edge, Brave, Opera, Vivaldi, Zen, Comet y ChatGPT Atlas."
          }
        }
      }
    },
    "EnviousMeet could not start recording" : {
      "comment" : "EnviousMeet: Yes to Record this call?, but the recording could not start.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet konnte die Aufnahme nicht starten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet n’a pas pu démarrer l’enregistrement"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet no ha podido empezar a grabar"
          }
        }
      }
    },
    "EnviousMeet needs the microphone and call sound to record. Calendar is optional." : {
      "comment" : "EnviousMeet setup: the line under the permissions title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet braucht das Mikrofon und den Ton vom Mac, um aufzunehmen. Der Kalender ist optional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet a besoin du micro et du son des appels pour enregistrer. Le calendrier est facultatif."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet necesita acceso al micrófono y al audio de la llamada para grabar. El acceso al calendario es opcional."
          }
        }
      }
    },
    "EnviousMeet needs the microphone to record. Calendar is optional." : {
      "comment" : "EnviousMeet setup: the line under the permissions title on a Mac that cannot record the call sound (below macOS 14.2).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet braucht das Mikrofon, um aufzunehmen. Der Kalender ist optional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet a besoin du micro pour enregistrer. Le calendrier est facultatif."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet necesita acceso al micrófono para grabar. El acceso al calendario es opcional."
          }
        }
      }
    },
    "EnviousMeet needs your attention before it can record" : {
      "comment" : "EnviousMeet: a call started, but a permission or the call sound explainer is needed first.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet braucht deine Hilfe, bevor es aufnehmen kann"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet a besoin de votre attention avant de pouvoir enregistrer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet necesita que hagas algo antes de poder grabar"
          }
        }
      }
    },
    "EnviousMeet notices your calls" : {
      "comment" : "EnviousMeet setup: how-it-works card 1 title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet erkennt deine Anrufe"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet détecte vos appels"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet detecta tus llamadas"
          }
        }
      }
    },
    "EnviousMeet records your voice with the microphone you dictate with." : {
      "comment" : "EnviousMeet page: help for the microphone permission row.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet nimmt deine Stimme mit dem Mikrofon auf, mit dem du diktierst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet enregistre votre voix avec le micro que vous utilisez pour dicter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet graba tu voz con el micrófono que usas para dictar."
          }
        }
      }
    },
    "EnviousMeet uses Accessibility to see whether a call window or meeting page is open when an app starts using your microphone. In Zoom, Teams and Meet calls, it also reads who is talking, so a meeting can show people's names instead of numbered speakers when it can tell them apart. It also sees when you're muted in those calls. It reads this on your Mac and never sends it to Envious Labs. Allow it before a call starts. Pasting your dictation uses the same permission." : {
      "comment" : "EnviousMeet page: help for the Accessibility permission row.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet nutzt die Bedienungshilfen, um zu prüfen, ob ein Anruffenster oder eine Meeting-Seite geöffnet ist, sobald eine App beginnt, dein Mikrofon zu nutzen. In Anrufen über Zoom, Teams und Meet liest es außerdem, wer gerade spricht, damit ein Meeting Namen statt nummerierter Sprecher anzeigen kann, wenn es die Personen auseinanderhalten kann. Es erkennt in diesen Anrufen auch, wann du stummgeschaltet bist. Diese Informationen liest es auf deinem Mac aus und sendet sie nie an Envious Labs. Erlaube den Zugriff vor Beginn eines Anrufs. Das Einfügen deines Diktats nutzt dieselbe Berechtigung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet utilise l’Accessibilité pour vérifier si une fenêtre d’appel ou une page de réunion est ouverte lorsqu’une app commence à utiliser votre micro. Lors des appels Zoom, Teams et Meet, l’app lit également qui parle, afin qu’une réunion puisse afficher les noms des personnes plutôt que des intervenants numérotés lorsqu’elle peut les différencier. Elle détecte également lorsque votre micro est coupé lors de ces appels. Ces informations sont lues sur votre Mac et ne sont jamais envoyées à Envious Labs. Autorisez cet accès avant le début d’un appel. Le collage de votre dictée utilise la même autorisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet usa el permiso de Accesibilidad para comprobar si hay una ventana de llamada o una página de reunión abierta cuando una app empieza a usar tu micrófono. En las llamadas de Zoom, Teams y Meet también detecta quién habla. Cuando puede distinguir a los participantes, muestra sus nombres en vez de identificarlos con números. En esas llamadas también detecta si tu micrófono está silenciado. EnviousMeet consulta estos datos en tu Mac y nunca los envía a Envious Labs. Concede el permiso antes de que empiece la llamada. Este mismo permiso permite pegar tus dictados."
          }
        }
      }
    },
    "EnviousMeet uses Parakeet and dictation uses Whisper. Dictating during a meeting can load both engines and slow down your Mac." : {
      "comment" : "EnviousMeet page, Transcript engine row: warning when meetings and dictation use different speech engines.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet verwendet Parakeet, beim Diktieren wird Whisper verwendet. Wenn du während eines Meetings diktierst, können beide Engines geladen werden und deinen Mac verlangsamen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet utilise Parakeet et la dictée utilise Whisper. Dicter pendant une réunion peut charger les deux moteurs et ralentir votre Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet usa Parakeet y el dictado usa Whisper. Dictar durante una reunión puede cargar ambos motores y ralentizar tu Mac."
          }
        }
      }
    },
    "EnviousMeet uses Whisper and dictation uses Parakeet. Dictating during a meeting can load both engines and slow down your Mac." : {
      "comment" : "EnviousMeet page, Transcript engine row: warning when meetings and dictation use different speech engines.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet verwendet Whisper, beim Diktieren wird Parakeet verwendet. Wenn du während eines Meetings diktierst, können beide Engines geladen werden und deinen Mac verlangsamen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet utilise Whisper et la dictée utilise Parakeet. Dicter pendant une réunion peut charger les deux moteurs et ralentir votre Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousMeet usa Whisper y el dictado usa Parakeet. Dictar durante una reunión puede cargar ambos motores y ralentizar tu Mac."
          }
        }
      }
    },
    "EnviousWispr brings Mail back and pastes." : {
      "comment" : "Closing film caption: the app returns to Mail, the starting app, and pastes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr wechselt zurück zu Mail und fügt deinen Text ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr revient dans Mail et colle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr vuelve a Mail y pega el texto."
          }
        }
      }
    },
    "EnviousWispr can't reach your microphone. Another app's audio driver may be stuck. Restarting your Mac usually fixes this." : {
      "comment" : "Pill and meeting notice: the microphone did not answer when recording started. The cause is unknown; another app's audio driver is only a possibility, so keep 'may'. Restarting the Mac is the usual fix.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr kann nicht auf dein Mikrofon zugreifen. Vielleicht hängt der Audiotreiber einer anderen App. Ein Neustart deines Macs behebt das meistens."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ne parvient pas à accéder à votre micro. Le pilote audio d’une autre app est peut-être bloqué. Redémarrer votre Mac règle généralement le problème."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr no puede acceder a tu micrófono. Puede que el controlador de audio de otra app se haya quedado bloqueado. Reiniciar el Mac suele solucionarlo."
          }
        }
      }
    },
    "EnviousWispr can't read %@ files yet. Try a file you exported from EnviousWispr, or a plain text list." : {
      "comment" : "Your Words, import: error. %@ is the file's type, such as a file extension.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr kann %@-Dateien noch nicht lesen. Versuche es mit einer aus EnviousWispr exportierten Datei oder einer einfachen Textliste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ne peut pas encore lire les fichiers %@. Essayez un fichier exporté depuis EnviousWispr ou une simple liste de texte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr todavía no puede leer archivos %@. Prueba con un archivo que hayas exportado desde EnviousWispr o con una lista de texto sin formato."
          }
        }
      }
    },
    "EnviousWispr can't read %@ files yet. Try the EnviousWispr Snippets.json you exported, a CSV, or a plain list." : {
      "comment" : "Snippets, import: error. %@ is the file's extension, already quoted. Keep the file name EnviousWispr Snippets.json as is.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr kann %@-Dateien noch nicht lesen. Versuche es mit deiner exportierten „EnviousWispr Snippets.json“, einer CSV oder einer einfachen Liste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ne peut pas encore lire les fichiers %@. Essayez le fichier EnviousWispr Snippets.json que vous avez exporté, un fichier CSV ou une simple liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr todavía no puede leer archivos %@. Prueba con el archivo EnviousWispr Snippets.json que has exportado, un CSV o una lista de texto sin formato."
          }
        }
      }
    },
    "EnviousWispr copies your words." : {
      "comment" : "Closing film caption: with no text field the text is put on the clipboard.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr kopiert deine Worte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr copie votre texte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr copia tus palabras."
          }
        }
      }
    },
    "EnviousWispr could not confirm this model's name with Ollama. Try again in a moment." : {
      "comment" : "AI Polish, Ollama model list: adding a hosted model failed; a hosted model's name could not be confirmed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr konnte den Namen dieses Modells nicht bei Ollama bestätigen. Versuche es gleich noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr n’a pas pu confirmer le nom de ce modèle auprès d’Ollama. Réessayez dans un instant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr no ha podido confirmar con Ollama el nombre de este modelo. Inténtalo de nuevo dentro de un momento."
          }
        }
      }
    },
    "EnviousWispr couldn't save the audio." : {
      "comment" : "History Save audio alert: saving the audio failed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr konnte die Aufnahme nicht sichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr n’a pas pu enregistrer le fichier audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr no pudo guardar el audio."
          }
        }
      }
    },
    "EnviousWispr couldn’t open this recording. Try sharing it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr konnte diese Aufnahme nicht öffnen. Teile sie erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr n’a pas pu ouvrir cet enregistrement. Essayez de le partager à nouveau."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr no ha podido abrir esta grabación. Intenta compartirla de nuevo."
          }
        }
      }
    },
    "EnviousWispr didn’t hear any speech.\nPick another microphone, or hold %@ and speak." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr hat keine Sprache erkannt.\nWähle ein anderes Mikrofon oder halte %@ gedrückt und sprich."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr n’a détecté aucune parole.\nSélectionnez un autre micro ou maintenez %@ enfoncé et parlez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr no ha detectado voz.\nElige otro micrófono o mantén pulsado %@ y habla."
          }
        }
      }
    },
    "EnviousWispr is in front, so there is nothing of yours to read. Select the word in the app you are writing in, then try again." : {
      "comment" : "Quick Add panel: why the selected text could not be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ist im Vordergrund, dort gibt es nichts von dir zu lesen. Wähle das Wort in der App aus, in der du schreibst, und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr est au premier plan et n’a donc rien à lire. Sélectionnez le mot dans l’app où vous écrivez, puis réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr está en primer plano y no puede leer la selección de otra app. Selecciona la palabra en la app donde estás escribiendo y vuelve a intentarlo."
          }
        }
      }
    },
    "EnviousWispr is now in your Applications folder." : {
      "comment" : "Move to Applications result, the app was copied but did not reopen: the heading. EnviousWispr is the app name; keep it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr befindet sich jetzt in deinem Ordner „Programme“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr se trouve maintenant dans votre dossier Applications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr está ahora en tu carpeta Aplicaciones."
          }
        }
      }
    },
    "EnviousWispr is open source, so you can check exactly what we send." : {
      "comment" : "Permissions settings, Privacy: line before the link to the data help article.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ist Open Source, du kannst also genau prüfen, was wir senden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr est open source. Vous pouvez donc vérifier exactement ce que nous envoyons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr es de código abierto, así que puedes comprobar exactamente qué enviamos."
          }
        }
      }
    },
    "EnviousWispr is running from a temporary location, so it cannot receive updates. EnviousWispr can fix this and reopen automatically." : {
      "comment" : "Move to Applications prompt: why the app should move. EnviousWispr is the app name; keep it.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr läuft von einem temporären Speicherort und kann daher keine Updates empfangen. EnviousWispr kann das beheben und sich automatisch neu öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr est exécuté depuis un emplacement temporaire et ne peut donc pas recevoir de mises à jour. EnviousWispr peut résoudre ce problème et se rouvrir automatiquement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr se está ejecutando desde una ubicación temporal, por lo que no puede recibir actualizaciones. EnviousWispr puede solucionarlo y volver a abrirse automáticamente."
          }
        }
      }
    },
    "EnviousWispr keeps a recording of each saved dictation on this Mac, so you can play it back in History. Recordings are kept for the period you chose in Settings > App Settings > Recordings. Turning off Save dictation recordings there stops new ones without deleting the ones you have. Delete a recording in History, or all of them with Delete all dictation recordings. The text always stays." : {
      "comment" : "History: the one-time recording notice when the user chose a keep period.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr speichert zu jedem gespeicherten Diktat eine Aufnahme auf diesem Mac, damit du sie im Verlauf abspielen kannst. Aufnahmen bleiben für die Aufbewahrungsdauer, die du unter Einstellungen > App-Einstellungen > Aufnahmen gewählt hast. Schaltest du dort „Diktataufnahmen speichern“ aus, entstehen keine neuen, vorhandene bleiben erhalten. Lösche eine Aufnahme im Verlauf oder alle mit „Alle Diktataufnahmen löschen“. Der Text bleibt immer erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr conserve sur ce Mac un enregistrement de chaque dictée enregistrée, afin que vous puissiez le réécouter dans l’Historique. Les enregistrements sont conservés pendant la durée que vous avez choisie dans Réglages > Réglages de l’app > Enregistrements. Désactiver l’option Enregistrer les enregistrements des dictées à cet endroit empêche d’en créer de nouveaux, sans supprimer ceux que vous avez déjà. Supprimez un enregistrement dans l’Historique, ou tous les enregistrements avec Supprimer tous les enregistrements des dictées. Le texte est toujours conservé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr conserva una grabación de cada dictado guardado en este Mac, para que puedas reproducirla en Historial. Las grabaciones se conservan durante el periodo que hayas elegido en Ajustes > Ajustes de la app > Grabaciones. Si desactivas allí “Guardar grabaciones de dictado”, no se crearán nuevas, pero las que ya tienes no se eliminarán. Elimina una grabación en Historial o elimínalas todas con “Eliminar todas las grabaciones de dictado”. El texto siempre se conserva."
          }
        }
      }
    },
    "EnviousWispr keeps a recording of each saved dictation on this Mac, so you can play it back in History. Recordings stay until you delete them, or for a keep period you choose in Settings > App Settings > Recordings. Turning off Save dictation recordings there stops new ones without deleting the ones you have. Delete a recording in History, or all of them with Delete all dictation recordings. The text always stays." : {
      "comment" : "History: the one-time recording notice with the default keep period.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr speichert zu jedem gespeicherten Diktat eine Aufnahme auf diesem Mac, damit du sie im Verlauf abspielen kannst. Aufnahmen bleiben, bis du sie löschst, oder für eine Aufbewahrungsdauer, die du unter Einstellungen > App-Einstellungen > Aufnahmen wählst. Schaltest du dort „Diktataufnahmen speichern“ aus, entstehen keine neuen, vorhandene bleiben erhalten. Lösche eine Aufnahme im Verlauf oder alle mit „Alle Diktataufnahmen löschen“. Der Text bleibt immer erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr conserve sur ce Mac un enregistrement de chaque dictée enregistrée, afin que vous puissiez le réécouter dans l’Historique. Les enregistrements sont conservés jusqu’à leur suppression, ou pendant la durée que vous choisissez dans Réglages > Réglages de l’app > Enregistrements. Désactiver l’option Enregistrer les enregistrements des dictées à cet endroit empêche d’en créer de nouveaux, sans supprimer ceux que vous avez déjà. Supprimez un enregistrement dans l’Historique, ou tous les enregistrements avec Supprimer tous les enregistrements des dictées. Le texte est toujours conservé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr conserva una grabación de cada dictado guardado en este Mac, para que puedas reproducirla en Historial. Las grabaciones se conservan hasta que las elimines o durante el periodo que elijas en Ajustes > Ajustes de la app > Grabaciones. Si desactivas allí “Guardar grabaciones de dictado”, no se crearán nuevas, pero las que ya tienes no se eliminarán. Elimina una grabación en Historial o elimínalas todas con “Eliminar todas las grabaciones de dictado”. El texto siempre se conserva."
          }
        }
      }
    },
    "EnviousWispr learns it." : {
      "comment" : "Closing film caption: the app adds the corrected word to its dictionary.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr lernt es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr l’apprend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr lo aprende."
          }
        }
      }
    },
    "EnviousWispr needs Accessibility permission to read your selection. Turn it on in System Settings, then try again." : {
      "comment" : "Quick Add panel: why the selected text could not be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr benötigt Zugriff auf die Bedienungshilfen, um deine Auswahl zu lesen. Aktiviere ihn in den Systemeinstellungen und versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr a besoin de l’autorisation d’Accessibilité pour lire votre sélection. Activez-la dans Réglages Système, puis réessayez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr necesita permiso de Accesibilidad para leer tu selección. Actívalo en Ajustes del Sistema y vuelve a intentarlo."
          }
        }
      }
    },
    "EnviousWispr needs a speech engine to transcribe this call. Nothing is being recorded." : {
      "comment" : "EnviousMeet: under No speech engine downloaded.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
