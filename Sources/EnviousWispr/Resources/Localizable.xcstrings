      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr now auto-detects the language you are speaking and transcribes accordingly. German, Japanese, Arabic, Tamil, Mandarin and 95 others work out of the box with no setting change needed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr erkennt jetzt automatisch, welche Sprache du sprichst, und transkribiert entsprechend. Deutsch, Japanisch, Arabisch, Tamil, Mandarin und 95 weitere Sprachen funktionieren ohne Änderung der Einstellungen."
          }
        }
      }
    },
    "whatsNew.apple-intelligence-multilingual.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry apple-intelligence-multilingual).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
