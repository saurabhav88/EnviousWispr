    },
    "Ollama returned two valid names for this model. Add it in Ollama, then refresh this list." : {
      "comment" : "AI Polish, Ollama model list: adding a hosted model failed; two names came back for a hosted model.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama hat zwei gültige Namen für dieses Modell zurückgegeben. Füge es in Ollama hinzu und aktualisiere dann diese Liste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama a renvoyé deux noms valides pour ce modèle. Ajoutez-le dans Ollama, puis actualisez cette liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama ha devuelto dos nombres válidos para este modelo. Añádelo en Ollama y actualiza esta lista."
          }
        }
      }
    },
    "Ollama runs AI models on your Mac. No API keys, completely free. After installing, come back and click refresh." : {
      "comment" : "AI Polish, Ollama setup: what installing Ollama gets you.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama führt KI-Modelle auf deinem Mac aus. Keine API-Schlüssel, komplett kostenlos. Komm nach der Installation zurück und klicke auf Aktualisieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama exécute des modèles d’IA sur votre Mac. Aucune clé d’API, c’est entièrement gratuit. Après l’installation, revenez ici et cliquez sur Actualiser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama ejecuta modelos de IA en tu Mac. Sin claves de API y completamente gratis. Después de instalarlo, vuelve aquí y haz clic en Actualizar."
          }
        }
      }
    },
    "Ollama runs open models you choose. Local polish runs on this Mac; hosted polish sends text to Ollama's servers." : {
      "comment" : "AI Polish, Why use Ollama: first paragraph.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama führt offene Modelle deiner Wahl aus. Lokales Polish läuft auf diesem Mac; gehostetes Polish sendet Text an Ollamas Server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama exécute les modèles ouverts de votre choix. La retouche locale s’effectue sur ce Mac, tandis que la retouche hébergée envoie le texte aux serveurs d’Ollama."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama ejecuta los modelos abiertos que elijas. El Pulido local se realiza en este Mac. El Pulido en la nube envía el texto a los servidores de Ollama."
          }
        }
      }
    },
    "Ollama's servers" : {
      "comment" : "Transcribe a File, Review step: where the cleanup runs.",
      "localizations" : {
        "de" : {
