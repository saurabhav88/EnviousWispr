          }
        }
      }
    },
    "whatsNew.paste-to-starting-chrome-window.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-to-starting-chrome-window).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastes go to the Chrome window you started in"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfügen im ursprünglichen Chrome-Fenster"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collages s’effectuent dans la fenêtre Chrome de départ"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto se pega en la ventana de Chrome donde empezaste"
          }
