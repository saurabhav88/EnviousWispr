    },
    "whatsNew.smoother-model-switching.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smoother-model-switching).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching between local AI polish models now frees up the previous model cleanly, so your Mac stays responsive and recordings keep working."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel zwischen lokalen Modellen zur KI-Nachbearbeitung wird das bisherige Modell jetzt sauber freigegeben. Dein Mac bleibt reaktionsschnell und Aufnahmen funktionieren weiter."
          }
        }
      }
    },
    "whatsNew.more-reliable-recordings.title" : {
