    },
    "whatsNew.language-aware-cleanup.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry language-aware-cleanup).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We've taught our polishing systems to better recognize when to remove filler words depending on the language spoken."
