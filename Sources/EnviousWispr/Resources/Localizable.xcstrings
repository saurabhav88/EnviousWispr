    "whatsNew.separate-dictionary-controls.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry separate-dictionary-controls).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separate controls for learned words"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernen und Korrigieren getrennt steuern"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôler séparément les mots appris"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controles separados para las palabras aprendidas"
          }
        }
      }
    },
    "whatsNew.separate-dictionary-controls.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry separate-dictionary-controls).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether your dictionary learns new words and whether it fixes words it already learned. Words you added yourself still work when learned fixes are off."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege getrennt fest, ob dein Wörterbuch neue Wörter lernt und ob es gelernte Korrekturen anwendet. Solange das Wörterbuch aktiviert ist, werden selbst hinzugefügte Wörter auch ohne gelernte Korrekturen berücksichtigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si votre dictionnaire apprend de nouveaux mots et s’il corrige les mots qu’il a déjà appris. Les mots que vous avez ajoutés vous-même continuent de fonctionner lorsque les corrections apprises sont désactivées."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si quieres que tu diccionario aprenda palabras nuevas y si quieres que aplique las correcciones que ya ha aprendido. Las palabras que hayas añadido seguirán usándose aunque desactives esas correcciones."
          }
        }
      }
    },
    "whatsNew.enviouswispr-in-french.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry enviouswispr-in-french).",
