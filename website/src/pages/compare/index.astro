---
import ThemedLayout from '../../layouts/ThemedLayout.astro';
import DownloadButton from '../../components/features/DownloadButton.astro';
import DownloadClosing from '../../components/DownloadClosing.astro';
import { Image } from 'astro:assets';
import reviewFrame from '../../assets/home/review-frame.webp';
import proof from '../../data/home/proof.json';
import { checked, products, groups, directory } from '../../data/compare.js';
import '../../styles/home/foundation.css';
import '../../styles/compare.css';

const siteUrl = 'https://enviouswispr.com';
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Comparisons', item: `${siteUrl}/compare/` },
  ],
};
const itemList = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: `Compare ${directory.length} dictation tools with EnviousWispr`,
  itemListElement: directory.map(([name, slug], index) => ({
    '@type': 'ListItem', position: index + 1,
    url: `${siteUrl}/compare/${slug}/`, name: `EnviousWispr vs ${name}`,
  })),
};
---

<ThemedLayout
  title="Compare Mac Dictation Apps: Price, Privacy & AI Cleanup | EnviousWispr"
  description="Compare EnviousWispr, Wispr Flow, Superwhisper, MacWhisper and Apple Dictation side by side. See price, offline use and AI cleanup, plus 17 detailed comparisons."
  activePage="compare" canonicalPath="/compare/"
>
  <Fragment slot="head">
    {[breadcrumb, itemList].map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </Fragment>

  <div class="compare-page">
  <header class="compare-intro wrap">
    <div>
      <p class="eyebrow">Compare Mac dictation apps</p>
      <h1>Compare the apps.<br /><span>Find your fit.</span></h1>
    </div>
    <div class="compare-intro-copy">
      <p>Where your voice goes. How your words are cleaned up. What you pay. See the differences before you choose.</p>
      <DownloadButton source="compare-hero" label="Try EnviousWispr free" />
      <small>macOS 14+ · Apple Silicon · No account</small>
    </div>
  </header>

  <section class="compare-overview wrap" aria-labelledby="overview-title">
    <div class="compare-section-top">
      <h2 id="overview-title">The essentials.</h2>
      <a href="#all-comparisons">All {directory.length} comparisons <span aria-hidden="true">↗</span></a>
    </div>
    <p class="compare-scroll-hint" id="table-help">Swipe across for apps and scroll down for features. Names stay in view.</p>
    <div class="compare-table-region" tabindex="0" role="region" aria-label="Dictation app comparison" aria-describedby="table-help">
      <table class="compare-matrix">
        <caption class="compare-sr-only">Five Mac dictation options compared by cost, privacy, setup and everyday use. Details checked {checked}.</caption>
        <colgroup><col class="compare-label-column" />{products.map(() => <col />)}</colgroup>
        <thead>
          <tr>
            <th scope="col" class="compare-corner"><span>Find what<br />matters to you.</span></th>
            {products.map(product => (
              <th scope="col" class:list={['compare-product', { 'compare-own': product.own }]}>
                <div class="compare-product-mark" aria-hidden="true">
                  {product.mark ? <img src={product.mark} alt="" width="36" height="36" /> : <span class="compare-monogram">MW</span>}
                </div>
                <span class="compare-product-name">{product.name}</span>
                <span class="compare-product-note">{product.note}</span>
              </th>
            ))}
          </tr>
        </thead>
        {groups.map((group, index) => (
          <tbody aria-label={group.title}>
            <tr class="compare-group-heading"><th colSpan={products.length + 1} scope="rowgroup"><span><b aria-hidden="true">0{index + 1}</b>{group.title}</span></th></tr>
            {group.rows.map(row => (
              <tr class="compare-feature-row">
                <th scope="row">{row.label}</th>
                {products.map(product => (
                  <td class:list={{ 'compare-own': product.own }}>
                    <strong>{row.cells[product.id].title}</strong>
                    {row.cells[product.id].note && <span>{row.cells[product.id].note}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
        <tfoot><tr><th scope="row">Explore further</th>{products.map(product => <td class:list={{ 'compare-own': product.own }}><a href={product.url} aria-label={product.own ? 'Explore EnviousWispr features' : `Full comparison with ${product.name}`}>{product.own ? 'Our features' : 'Full comparison'} <span aria-hidden="true">↗</span></a></td>)}</tr></tfoot>
      </table>
    </div>
    <div class="compare-table-notes">
      <p><strong>¹ Local or cloud, your choice.</strong> EnviousWispr keeps audio on your Mac. If you choose cloud polish, selected text and cleanup context go directly to your provider. Providers may charge for usage. Apple Intelligence polish requires macOS 26+ and availability.</p>
      <p>Checked {checked}. Prices are in the currencies shown; taxes and regional pricing may vary. Features can depend on your plan, model and setup. <a href="#comparison-sources">See primary sources ↓</a></p>
    </div>
  </section>

  <section class="compare-decisions wrap" aria-labelledby="tradeoffs-title">
    <div class="compare-section-heading">
      <p class="eyebrow">The trade-offs</p>
      <h2 id="tradeoffs-title">A good fit beats<br /><span>the longest feature list.</span></h2>
    </div>
    <div class="compare-fit-grid">
      <article class="compare-fit-own">
        <img src="/favicon.svg" alt="" width="42" height="42" loading="lazy" />
        <h3>Choose EnviousWispr for free, private dictation.</h3>
        <p>Dictate into your apps, transcribe a recording, and clean up the text with local AI. No account or subscription. Your audio stays on your Mac.</p>
        <p class="compare-fit-limit"><strong>The trade-off:</strong> you need Apple Silicon and macOS 14+. If cross-platform access or a broader team workflow matters more, look at those capabilities first.</p>
        <a href="/why-offline/" class="text-link">See how offline works <span aria-hidden="true">↗</span></a>
      </article>
      <article class="compare-fit-alternatives">
        <h3>Another app may fit you better.</h3>
        <dl>
          <div><dt>Across devices and teams</dt><dd><a href="/compare/wisprflow/">Wispr Flow</a> offers a broader cloud service with cross-platform dictation and team features.</dd></div>
          <div><dt>More model and mode control</dt><dd><a href="/compare/superwhisper/">Superwhisper</a> offers configurable voice models, prompts and writing modes.</dd></div>
          <div><dt>Subtitles and batch workflows</dt><dd><a href="/compare/macwhisper/">MacWhisper</a> combines files, meetings and dictation with export and automation tools.</dd></div>
          <div><dt>Start with what you already have</dt><dd><a href="/compare/apple-dictation/">Apple Dictation</a> is built into macOS. It is a useful first option to try.</dd></div>
        </dl>
      </article>
    </div>
  </section>

  <section class="compare-evidence wrap" aria-labelledby="evidence-title">
    <div>
      <p class="eyebrow">See the results</p>
      <h2 id="evidence-title">A feature list is<br />half the story.</h2>
      <p>How does the text actually turn out? Mostly Mac compared seven dictation apps using the same passages. Watch the examples and the reviewer’s conclusions.</p>
      <a class="text-link" href={proof[0].url} target="_blank" rel="noopener">Watch the independent comparison <span aria-hidden="true">↗</span></a>
      <small>This is one reviewer’s test, not a guarantee for every voice, language or Mac.</small>
    </div>
    <a class="compare-review-image" href={proof[0].url} target="_blank" rel="noopener" aria-label="Watch Mostly Mac’s EnviousWispr review from 6 minutes 25 seconds">
      <Image src={reviewFrame} alt="Mostly Mac demonstrating EnviousWispr in a comparison of dictation apps" widths={[480, 800]} sizes="(max-width: 760px) 90vw, 42vw" width={800} format="webp" loading="lazy" />
      <span class="compare-play" aria-hidden="true">▶</span>
      <span class="compare-review-caption">Mostly Mac <span>EnviousWispr segment · 6:25 ↗</span></span>
    </a>
  </section>

  <section class="compare-directory wrap" id="all-comparisons" aria-labelledby="directory-title">
    <div class="compare-directory-heading">
      <div><p class="eyebrow">Take a closer look</p><h2 id="directory-title">Your shortlist.<br /><span>The full picture.</span></h2><p>EnviousWispr alongside {directory.length} dictation, transcription and developer tools.</p></div>
      <form class="compare-search" role="search" hidden>
        <label for="compare-search">Find a comparison</label>
        <div><input id="compare-search" type="search" placeholder="Search by app name" autocomplete="off" /><button type="reset">Clear</button></div>
      </form>
    </div>
    <p class="compare-search-status" role="status" aria-live="polite" hidden></p>
    <nav class="compare-directory-links" aria-label="All detailed comparisons">
      {directory.map(([name, slug]) => <a href={`/compare/${slug}/`} data-comparison-name={name}><span><small>EnviousWispr vs</small><strong>{name}</strong></span><span aria-hidden="true">↗</span></a>)}
    </nav>
    <!-- Signpost to the recommendation page (#2340). The index is a directory; this is the
         visible route to the page that answers "which one should I use". -->
    <div class="compare-guides">
      <a href="/compare/best-dictation-apps-for-mac/"><span>Need help narrowing it down?<strong>Best dictation apps by use case</strong></span><span aria-hidden="true">↗</span></a>
      <a href="/compare/wisprflow-alternatives/"><span>Considering a switch?<strong>Free Wispr Flow alternatives</strong></span><span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="compare-sources wrap" id="comparison-sources" aria-labelledby="sources-title">
    <div class="compare-section-top"><h2 id="sources-title">Check the sources.</h2><span>Table checked {checked}</span></div>
    <p>This comparison is published by Envious Labs, the maker of EnviousWispr. Product facts come from the sources below. Our fit recommendations are editorial judgments.</p>
    <div class="compare-source-grid">
      {products.map(product => <div><h3>{product.name}</h3>{product.sources.map(([label, url]) => <a href={url} target={url.startsWith('https:') ? '_blank' : undefined} rel={url.startsWith('https:') ? 'noopener' : undefined}>{label} <span aria-hidden="true">↗</span></a>)}</div>)}
    </div>
  </section>

  <DownloadClosing title="Make room for your words." source="compare-closing" />
  </div>
</ThemedLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.compare-search');
  const input = document.querySelector<HTMLInputElement>('#compare-search');
  const status = document.querySelector<HTMLElement>('.compare-search-status');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-comparison-name]')];
  if (form && input && status) {
    const filter = (query: string) => {
      const search = query.trim().toLocaleLowerCase().replace(/\s+/g, '');
      let count = 0;
      for (const link of links) {
        link.hidden = !link.dataset.comparisonName.toLocaleLowerCase().replace(/\s+/g, '').includes(search);
        if (!link.hidden) count++;
      }
      status.hidden = !search;
      status.textContent = count ? `${count} comparison${count === 1 ? '' : 's'} found.` : 'No matching app. Clear your search to see every comparison.';
    };
    form.addEventListener('submit', event => event.preventDefault());
    input.addEventListener('input', () => filter(input.value));
    form.addEventListener('reset', () => { filter(''); input.focus(); });
    input.value = '';
    form.hidden = false;
  }
</script>
