          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes seguir dictando mientras EnviousMeet graba."
          }
        }
      }
    },
    "You can keep setting up and resume later." : {
      "comment" : "Setup Downloads footer note: a problem.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mit der Einrichtung weitermachen und den Download später fortsetzen."
