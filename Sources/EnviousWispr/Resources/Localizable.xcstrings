      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Push to Talk with a modifier key such as Right Option, hold it and press Space to go hands-free."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte im Modus „Zum Sprechen drücken“ deine Sondertaste, etwa die rechte Wahltaste, gedrückt und drücke die Leertaste, um freihändig zu diktieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Appuyer pour parler et une touche modificatrice telle qu’Option droite, maintenez cette touche enfoncée et appuyez sur la barre d’espace pour dicter mains libres."
          }
        },
        "es" : {
