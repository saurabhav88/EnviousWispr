        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktierte Emoji bleiben nach der Nachbearbeitung genau dort, wo du sie eingefügt hast. Sie verschwinden nicht mehr und landen nicht an der falschen Stelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictez un emoji : il reste maintenant exactement là où vous l’avez placé après la Retouche. Les emoji ne disparaissent plus et ne se retrouvent plus au mauvais endroit."
          }
        },
