            "state" : "translated",
            "value" : "Diese Version ist nicht gespeichert"
          }
        }
      }
    },
    "This version of EnviousWispr cannot run that preview engine." : {
      "comment" : "Live Preview settings, preview engine: unavailable in this build.\nOn-screen preview status: this app build lacks the preview engine's files.",
      "localizations" : {
