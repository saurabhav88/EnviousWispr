        }
      }
    },
    "Audio of a meeting that is recording or being transcribed is never removed. Without its audio, a meeting can't be transcribed again." : {
      "comment" : "App Settings, Recordings: help for Keep meeting audio.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
