    },
    "Select a misheard word anywhere, then press this to add it to Your Words. Terminal windows do not share their selection, so it will not work there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere irgendwo ein falsch erkanntes Wort und drücke dann dieses Tastenkürzel, um es zu „Deine Wörter“ hinzuzufügen. Terminal-Fenster geben ihre Auswahl nicht weiter. Dort funktioniert es nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un mot mal reconnu où que ce soit, puis appuyez sur ce raccourci pour l’ajouter à « Vos mots ». Les fenêtres Terminal ne partagent pas leur sélection : cela ne fonctionnera donc pas dans ces fenêtres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona una palabra que se haya transcrito mal en cualquier lugar y usa este atajo para añadirla a Tus palabras. El atajo no funciona en Terminal porque sus ventanas no comparten el texto seleccionado."
          }
        }
      }
    },
