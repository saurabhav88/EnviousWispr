    "whatsNew.sharper-on-device-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry sharper-on-device-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The built-in, fully on-device polish got a real tune-up. It cleans up filler and phrasing more reliably, keeps the natural way you start a sentence, and leaves your wording alone when it should."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die integrierte Nachbearbeitung auf dem Gerät wurde verbessert. Sie entfernt Füllwörter und holprige Formulierungen zuverlässiger, bewahrt natürliche Satzanfänge und lässt deine Wortwahl in Ruhe, wenn keine Änderung nötig ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Retouche intégrée, entièrement effectuée sur l’appareil, a été nettement améliorée. Elle supprime plus efficacement les mots de remplissage et les formulations maladroites, conserve vos débuts de phrase naturels et laisse votre formulation intacte lorsqu’aucune modification n’est nécessaire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Pulido integrado que funciona completamente en el dispositivo ha mejorado mucho. Elimina las muletillas y mejora la redacción de forma más fiable, conserva la manera natural en la que empiezas una frase y respeta tus palabras cuando no hace falta cambiarlas."
          }
        }
      }
    },
    "whatsNew.emoji-stay-put.title" : {
