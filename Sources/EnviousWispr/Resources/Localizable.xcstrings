      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zu deinen Wörtern hinzugefügt"
          }
        }
      }
    },
    "%@ already knows \"%@\"" : {
      "comment" : "Quick Add panel: the word already has that spelling. The first %@ is the word, the second the misheard text; use this language's quotation marks.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ already knows \"%2$@\""
          }
