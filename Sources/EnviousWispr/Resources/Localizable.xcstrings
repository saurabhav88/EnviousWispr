      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der letzten Prüfung meldete macOS, dass Apple Intelligence auf diesem Mac nicht aktiviert war. Du kannst weiter diktieren oder unter Einstellungen > KI-Nachbearbeitung ein anderes Modell wählen."
          }
        },
        "fr" : {
          "stringUnit" : {
