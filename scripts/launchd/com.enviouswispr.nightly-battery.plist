<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Nightly hardware battery (#3013). Install by hand, once:
       cp scripts/launchd/com.enviouswispr.nightly-battery.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.enviouswispr.nightly-battery.plist
       Edit ProgramArguments if the main checkout is not at the path below. -->
  <key>Label</key>
  <string>com.enviouswispr.nightly-battery</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/m4pro_sv/Developer/EnviousLabs/EnviousWispr/scripts/nightly-local-battery.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/m4pro_sv/Library/Logs/EnviousWispr/nightly-battery.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/m4pro_sv/Library/Logs/EnviousWispr/nightly-battery.launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
