    "whatsNew.cleaner-audio-settings.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry cleaner-audio-settings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removed the noise suppression toggle. It wasn't doing what its name suggested, and a quieter settings panel is one less thing to wonder about."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schalter für Rauschunterdrückung wurde entfernt. Er tat nicht das, was sein Name versprach. So gibt es in den Einstellungen eine unklare Option weniger."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons supprimé le réglage de réduction du bruit. Il ne faisait pas ce que son nom indiquait, et des Réglages audio plus simples vous évitent de vous interroger sur une option de plus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos eliminado el interruptor de supresión de ruido. No hacía lo que sugería su nombre, y un panel de ajustes más despejado significa una cosa menos que tener en cuenta."
          }
        }
      }
    },
