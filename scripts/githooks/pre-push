  add_test_lines New.swift 101
  git -C "$repo" add -A; git -C "$repo" commit --quiet -m "tests"
  rpush origin rec; rc=$?
  check "R2 over the floor with no trailer blocks and prints the repair command" \
    "$rc|$(grep -c 'no commit in the range carries' "$tmp/push.out")|$(grep -c 'git commit --allow-empty --trailer "Recipe: #N"' "$tmp/push.out")|$(grep -c "base ${base_main:0:12}" "$tmp/push.out")" "1|1|1|1"
  git -C "$repo" commit --quiet --allow-empty -m "two" -m "$(printf 'Recipe: #7\nRecipe: parent-red X')"
  r_dup="$(git -C "$repo" rev-parse HEAD)"
  rpush origin rec; rc=$?
  check "R3 two trailers on the newest declaring commit block" "$rc|$(grep -c 'carries 2 of them' "$tmp/push.out")" "1|1"
  git -C "$repo" commit --quiet --allow-empty --trailer "Recipe: #7" -m "test: name recipe #7"
  r_fix="$(git -C "$repo" rev-parse HEAD)"
  rpush origin rec; rc=$?
