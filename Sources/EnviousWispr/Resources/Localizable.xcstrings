    "whatsNew.enviouswispr-in-the-share-menu.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry enviouswispr-in-the-share-menu).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share an audio or video file from a Mac app with Transcribe with EnviousWispr to get a transcript. Turn it on once in the macOS Share menu, check your settings, then press Start transcription."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile eine Audio- oder Videodatei aus einer Mac-App über „Mit EnviousWispr transkribieren“, um ein Transkript zu erhalten. Aktiviere die Funktion einmalig im Teilen-Menü von macOS, prüfe deine Einstellungen und klicke dann auf „Transkription starten“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez un fichier audio ou vidéo depuis une app Mac avec Transcrire avec EnviousWispr pour obtenir une transcription. Activez cette option une fois dans le menu Partager de macOS, vérifiez vos réglages, puis cliquez sur Démarrer la transcription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para obtener una transcripción, comparte un archivo de audio o vídeo desde una app de tu Mac con la opción “Transcribir con EnviousWispr”. Activa esta opción una sola vez en el menú Compartir de macOS, revisa tus ajustes y pulsa “Iniciar transcripción”."
          }
        }
      }
    },
