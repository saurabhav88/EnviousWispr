    "%@ alternate spellings may not be added, because other words already use them." : {
      "comment" : "Your Words, import review: a row's note. %@ is the number of misheard forms, never 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alternative Schreibweisen können nicht hinzugefügt werden, weil andere Wörter sie bereits verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ajouter %@ variantes, car elles sont déjà associées à d’autres mots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ variantes ortográficas no se pueden añadir porque ya las usan otras palabras."
          }
        }
      }
    },
    "%@ alternate spellings were skipped, because other words already use them." : {
      "comment" : "Your Words, import result: %@ is the number of misheard forms not added, never 1.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alternative Schreibweisen wurden übersprungen, weil andere Wörter sie bereits verwenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ variantes ont été ignorées, car elles sont déjà associées à d’autres mots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han omitido %@ variantes ortográficas porque ya las usan otras palabras."
          }
        }
      }
    },
    "%@ by Superwhisper" : {
      "comment" : "AI Polish, Ollama: credit above the writing-style dials when the Ollama model is S1-mini. %@ is S1-mini. Keep Superwhisper as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ von Superwhisper"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par Superwhisper"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de Superwhisper"
          }
        }
      }
    },
    "%@ by Superwhisper is a small cleanup model that runs on this Mac and works offline, with no API key to manage." : {
      "comment" : "AI Polish, Why use S1-mini: first paragraph. %@ is the model name, S1-mini. Keep Superwhisper as written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ von Superwhisper ist ein kleines Bereinigungsmodell, das auf diesem Mac läuft und offline funktioniert, ohne API-Schlüssel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par Superwhisper est un petit modèle de retouche qui fonctionne sur ce Mac et hors ligne, sans clé API à gérer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de Superwhisper es un modelo pequeño de pulido que funciona en este Mac y sin conexión, sin necesidad de gestionar ninguna clave de API."
          }
        }
      }
    },
