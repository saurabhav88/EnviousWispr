    "whatsNew.input-channel-selection.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry input-channel-selection).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multi-input audio interfaces like the Focusrite Scarlett are now properly supported. Select your specific mic input channel in microphone settings to route your audio cleanly, with no more input error messages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audiointerfaces mit mehreren Eingängen, etwa Focusrite Scarlett, werden jetzt richtig unterstützt. Wähle in den Mikrofoneinstellungen den gewünschten Eingangskanal aus, damit dein Audio ohne Eingabefehler ankommt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les interfaces audio à entrées multiples, comme Focusrite Scarlett, sont désormais correctement prises en charge. Sélectionnez le canal d’entrée de votre micro dans les réglages du micro pour acheminer votre audio proprement, sans messages d’erreur liés à l’entrée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las interfaces de audio con varias entradas, como Focusrite Scarlett, ahora son compatibles. Selecciona el canal de entrada del micrófono en los ajustes del micrófono para dirigir el audio correctamente y dejar de recibir mensajes de error de entrada."
          }
        }
      }
    },
