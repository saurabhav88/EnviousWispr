    "whatsNew.small-things-that-now-just-work.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eight fixes across dictation, paste and History."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acht Korrekturen für Diktate, Einfügen und Verlauf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huit corrections pour la dictée, le collage et l’Historique."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocho correcciones en el dictado, el pegado y el Historial."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.0" : {
      "comment" : "Settings > What's New: point 1 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stalled transcription recovery: Canceling a dictation that fails to finish now halts the process immediately while preserving your recorded audio."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängende Transkription: Wenn du ein Diktat abbrichst, das nicht fertig wird, stoppt der Vorgang sofort. Deine Aufnahme bleibt erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération après un blocage de la transcription : l’annulation d’une dictée qui ne se termine pas arrête désormais immédiatement le processus tout en conservant votre enregistrement audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación de transcripciones bloqueadas: al cancelar un dictado que no termina, el proceso se detiene de inmediato y el audio grabado se conserva."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.1" : {
      "comment" : "Settings > What's New: point 2 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decimal formatting: Numbers spoken digit by digit around a decimal point (e.g., \"two four oh seven point one two three\") now format properly as a single decimal number."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezimalzahlen: Ziffer für Ziffer gesprochene Zahlen rund um ein Dezimalkomma werden jetzt korrekt als eine Dezimalzahl formatiert, etwa „zwei vier null sieben Komma eins zwei drei“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formatage des nombres décimaux : les nombres dictés chiffre par chiffre autour d’un séparateur décimal, par exemple « deux quatre zéro sept virgule un deux trois », sont désormais correctement formatés en un seul nombre décimal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato decimal: cuando dictas los dígitos de uno en uno a ambos lados del separador decimal, como en “two four oh seven point one two three”, la app los escribe correctamente como un solo número decimal."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.2" : {
      "comment" : "Settings > What's New: point 3 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick Add persistence: Quick Add continues to display the heard phrase on screen even when nothing in your list matches it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnell hinzufügen: Der erkannte Ausdruck bleibt sichtbar, auch wenn kein Eintrag in deiner Liste dazu passt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservation de l’Ajout rapide : l’Ajout rapide continue d’afficher à l’écran la phrase entendue, même si aucun élément de votre liste ne lui correspond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir rápidamente mantiene la frase en pantalla: la frase reconocida sigue visible aunque no coincida con ningún elemento de tu lista."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.3" : {
      "comment" : "Settings > What's New: point 4 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcut conflict priority: When the cancel shortcut shares a key combination with Quick Add, cancel now reliably takes priority."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastenkürzelkonflikt: Wenn „Abbrechen“ und „Schnell hinzufügen“ dieselbe Tastenkombination verwenden, hat „Abbrechen“ jetzt zuverlässig Vorrang."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priorité en cas de conflit de raccourcis : lorsque le raccourci d’annulation utilise la même combinaison de touches que l’Ajout rapide, l’annulation est désormais prioritaire."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prioridad ante conflictos de atajos: si Cancelar y Añadir rápidamente tienen la misma combinación de teclas, ahora Cancelar tiene prioridad de forma fiable."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.4" : {
      "comment" : "Settings > What's New: point 5 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste timeout protection: Bringing an unresponsive target app to the front before pasting now aborts after 500 ms instead of freezing the app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitlimit beim Einfügen: Reagiert die Ziel-App nicht, wird der Versuch, sie vor dem Einfügen nach vorn zu holen, nach 500 ms abgebrochen. EnviousWispr bleibt bedienbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protection contre les délais d’attente du collage : l’affichage au premier plan d’une app cible qui ne répond pas avant le collage est désormais abandonné après 500 ms au lieu de bloquer l’app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite de espera al pegar: si la app de destino no responde al intentar traerla al primer plano, EnviousWispr cancela la operación después de 500 ms en lugar de quedarse bloqueado."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.5" : {
      "comment" : "Settings > What's New: point 6 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safer crash recovery: Crash recovery retains the key to a saved recording until the audio file itself is confirmed safely removed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherere Wiederherstellung: Nach einem Absturz bleibt der Schlüssel zu einer gespeicherten Aufnahme erhalten, bis das Löschen der Audiodatei bestätigt ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération plus sûre après un plantage : l’app conserve la clé de l’enregistrement sauvegardé jusqu’à ce qu’elle ait vérifié que le fichier audio a bien été supprimé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación más segura tras un cierre inesperado: la app conserva la clave de la grabación guardada hasta confirmar que el archivo de audio se ha eliminado de forma segura."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.6" : {
      "comment" : "Settings > What's New: point 7 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Process cleanup on launch: Any lingering background servers left over from an earlier session are automatically terminated on startup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufräumen beim Start: Hintergrundserver aus einer früheren Sitzung werden beim Start automatisch beendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettoyage des processus au lancement : les serveurs d’arrière-plan persistants d’une session précédente sont automatiquement arrêtés au démarrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpieza al iniciar: cualquier servidor en segundo plano que haya quedado de una sesión anterior se cierra automáticamente al iniciar."
          }
        }
      }
    },
    "whatsNew.small-things-that-now-just-work.bullet.7" : {
      "comment" : "Settings > What's New: point 8 of the list under one feature announcement (entry small-things-that-now-just-work).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History type filters: History now distinguishes between Dictations (live keybind speech) and Transcripts (imported files). A new filter switch at the top of the list lets you quickly toggle between All, Dictations, and Transcripts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filter im Verlauf: Der Verlauf unterscheidet jetzt zwischen Diktaten über ein Tastenkürzel und Transkripten aus importierten Dateien. Oben in der Liste kannst du zwischen „Alle“, „Diktate“ und „Transkripte“ wechseln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtres par type dans l’Historique : l’Historique distingue désormais les dictées lancées à l’aide d’un raccourci des transcriptions de fichiers importés. Un nouveau sélecteur en haut de la liste permet de passer rapidement de « Tout » à « Dictées » ou « Transcriptions »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtros por tipo en el Historial: ahora el Historial distingue entre los dictados que haces en directo con un atajo y las transcripciones de archivos importados. Un nuevo selector en la parte superior de la lista te permite alternar rápidamente entre Todo, Dictados y Transcripciones."
          }
        }
      }
    },
    "whatsNew.model-lives-in-our-own-folder.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry model-lives-in-our-own-folder).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speech model now lives in its own folder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sprachmodell hat jetzt einen eigenen Ordner"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle vocal dispose désormais de son propre dossier"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo de voz ahora tiene su propia carpeta"
          }
        }
      }
    },
    "whatsNew.model-lives-in-our-own-folder.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry model-lives-in-our-own-folder).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr keeps its speech model somewhere that belongs to it, and leaves every other app's files alone. If the model is already on your Mac it gets reused in seconds instead of downloaded again, even if you are offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr speichert sein Sprachmodell in einem eigenen Ordner und lässt Dateien anderer Apps unangetastet. Liegt das Modell bereits auf deinem Mac, wird es in Sekunden wiederverwendet statt erneut heruntergeladen – auch offline."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr conserve son modèle vocal dans un dossier qui lui est réservé et ne touche pas aux fichiers des autres apps. Si le modèle se trouve déjà sur votre Mac, il est réutilisé en quelques secondes au lieu d’être téléchargé à nouveau, même hors ligne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr guarda su modelo de voz en una ubicación propia y deja intactos los archivos de las demás apps. Si el modelo ya está en tu Mac, lo reutiliza en cuestión de segundos en lugar de descargarlo otra vez, incluso si no tienes conexión."
          }
        }
      }
    },
    "whatsNew.model-repairs-itself.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry model-repairs-itself).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A damaged speech model fixes itself"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein beschädigtes Sprachmodell repariert sich selbst"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modèle vocal endommagé se répare tout seul"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modelo de voz dañado se repara solo"
          }
        }
      }
    },
    "whatsNew.model-repairs-itself.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry model-repairs-itself).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If part of the speech model goes missing or gets corrupted, EnviousWispr repairs it on its own. Where a copy is already on your Mac it uses that one. Otherwise it fetches just the missing piece instead of the whole model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlt ein Teil des Sprachmodells oder ist er beschädigt, repariert EnviousWispr ihn selbst. Gibt es bereits eine Kopie auf deinem Mac, wird sie verwendet. Andernfalls lädt die App nur den fehlenden Teil statt des gesamten Modells."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une partie du modèle vocal disparaît ou est endommagée, EnviousWispr la répare automatiquement. Si une copie se trouve déjà sur votre Mac, l’app l’utilise. Sinon, elle télécharge uniquement l’élément manquant au lieu du modèle complet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si falta una parte del modelo de voz o está dañada, EnviousWispr repara el modelo automáticamente. Si ya hay una copia en tu Mac, la usa. Si no, descarga solo la parte que necesita en lugar del modelo completo."
          }
        }
      }
    },
    "whatsNew.snippets.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry snippets).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing \"Snippets\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu: „Textbausteine“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez les « Extraits de texte »"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presentamos “Fragmentos de texto”"
          }
        }
      }
    },
    "whatsNew.snippets.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry snippets).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop retyping the same information. Save your email address, LinkedIn, Calendly link, or common email templates as snippets. Speak your keyword followed by your customizable trigger phrase, and the text drops straight into your active cursor field. New installs come preloaded with six examples to help you get started. To set it up: Settings > Snippets."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe häufig verwendete Angaben nicht immer wieder neu. Speichere deine E-Mail-Adresse, einen LinkedIn- oder Calendly-Link oder häufige E-Mail-Vorlagen als Textbausteine. Sprich dein Schlüsselwort gefolgt von deinem anpassbaren Auslöser, und der Text erscheint direkt an der aktuellen Cursorposition. Bei neuen Installationen helfen dir sechs Beispiele beim Einstieg. Einrichtung: Einstellungen > Textbausteine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne saisissez plus jamais les mêmes informations. Enregistrez votre adresse e-mail, votre lien LinkedIn ou Calendly, ou vos modèles d’e-mail courants sous forme d’extraits de texte. Prononcez votre mot-clé suivi de votre phrase déclencheuse personnalisable, et le texte s’insère directement dans le champ où se trouve votre curseur. Les nouvelles installations sont préremplies avec six exemples pour vous aider à démarrer. Pour configurer cette fonctionnalité : Réglages > Extraits de texte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja de escribir la misma información una y otra vez. Guarda tu dirección de correo electrónico, tus enlaces de LinkedIn o Calendly, o tus plantillas de correo habituales como fragmentos de texto. Di tu palabra clave seguida de tu frase de activación personalizable y el texto aparecerá directamente en el campo donde esté el cursor. Las instalaciones nuevas incluyen seis ejemplos para ayudarte a empezar. Puedes configurar esta función en Ajustes > Fragmentos de texto."
          }
        }
      }
    },
    "whatsNew.eg1-1-2.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry eg1-1-2).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing \"Email Formatting\" for EG-1"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu für EG-1: „E-Mail-Formatierung“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez le « Formatage des e-mails » pour EG-1"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te presentamos “Formato de correo” para EG-1"
          }
        }
      }
    },
    "whatsNew.eg1-1-2.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry eg1-1-2).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With EG-1, you can now dictate emails aloud and have them automatically converted into clean, ready-to-send formats. The model retains all its standard text-polishing capabilities, too."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit EG-1 kannst du E-Mails jetzt diktieren und automatisch in ein sauberes, versandfertiges Format bringen lassen. Die übrigen Funktionen zur Textnachbearbeitung bleiben erhalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec EG-1, vous pouvez désormais dicter vos e-mails à voix haute et les convertir automatiquement dans un format propre, prêt à l’envoi. Le modèle conserve également toutes ses fonctions habituelles de retouche de texte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con EG-1, ahora puedes dictar correos electrónicos y obtener automáticamente mensajes bien estructurados y listos para enviar. El modelo conserva todas sus funciones habituales de Pulido con IA."
          }
        }
      }
    },
    "whatsNew.s1-mini-local-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry s1-mini-local-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing \"S1-mini by Superwhisper\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu: „S1-mini von Superwhisper“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez « S1-mini de Superwhisper »"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te presentamos “S1-mini de Superwhisper”"
          }
        }
      }
    },
    "whatsNew.s1-mini-local-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry s1-mini-local-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1-mini, Superwhisper's custom-tuned local model, is now available for offline polishing. It is completely free, downloads in just 484 MB, and gives you three quick dials to shape your text: Tone, Structure, and Context. EG-1 is still the go-to for maximum polish quality, but S1-mini delivers solid on-device results on a much smaller footprint."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1-mini, das eigens angepasste lokale Modell von Superwhisper, ist jetzt für die Offline-Nachbearbeitung verfügbar. Es ist kostenlos, benötigt nur 484 MB Download und bietet drei schnelle Regler für deinen Text: Ton, Struktur und Kontext. EG-1 bleibt die erste Wahl für höchste Qualität, während S1-mini mit deutlich weniger Speicherbedarf gute Ergebnisse direkt auf dem Gerät liefert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1-mini, le modèle local spécialement adapté par Superwhisper, est désormais disponible pour la retouche hors ligne. Il est entièrement gratuit, ne nécessite que 484 Mo au téléchargement et vous offre trois réglages rapides pour façonner votre texte : Ton, Structure et Contexte. EG-1 reste le choix privilégié pour une qualité de retouche maximale, mais S1-mini fournit de bons résultats directement sur l’appareil, avec une empreinte bien plus réduite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1-mini, el modelo local que Superwhisper ha ajustado, ya está disponible para pulir texto sin conexión. Es gratis, la descarga es de solo 484 MB y tienes tres controles para ajustar el texto: Tono, Estructura y Contexto. EG-1 sigue siendo la opción recomendada para obtener la máxima calidad de Pulido con IA, pero S1-mini ofrece buenos resultados en tu Mac con un modelo mucho más pequeño."
          }
        }
      }
    },
    "whatsNew.dictionary-page-rebuilt.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry dictionary-page-rebuilt).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-designed Your Words into Dictionary"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus „Deine Wörter“ wird „Wörterbuch“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refonte de « Vos mots », désormais « Dictionnaire »"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tus palabras” ahora es “Diccionario”"
          }
        }
      }
    },
    "whatsNew.dictionary-page-rebuilt.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry dictionary-page-rebuilt).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Your Words\" is now \"Dictionary.\" Vocab packs are fully editable, and the interface has been overhauled to make managing your custom vocabulary smoother and more intuitive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Deine Wörter“ heißt jetzt „Wörterbuch“. Wortschatzpakete lassen sich vollständig bearbeiten. Die überarbeitete Oberfläche macht die Verwaltung deines eigenen Wortschatzes einfacher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Vos mots » s’appelle désormais « Dictionnaire ». Les lexiques sont entièrement modifiables et l’interface a été repensée pour rendre la gestion de votre vocabulaire personnalisé plus simple et intuitive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tus palabras” ahora es “Diccionario”. Los vocabularios se pueden editar por completo y la interfaz se ha renovado para que gestionar tus palabras personalizadas sea más sencillo e intuitivo."
          }
        }
      }
    },
    "whatsNew.input-channel-selection.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry input-channel-selection).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support for multi input devices"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstützung für Geräte mit mehreren Eingängen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prise en charge des périphériques à plusieurs entrées"
          }
        },
        "es" : {
