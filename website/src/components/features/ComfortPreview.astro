---
// Make it yours hero visual (#2816): the recording pill in three designs and
// two positions, the mock's pill block. Two picker groups for pickers.js.
import { pills, positions, railBars } from '../../data/features/customization.js';
import Logo from '../home/Logo.astro';
---

<div class="comfort-preview" data-picker="comfort">
  <div class="comfort-space bottom" id="comfort-space">
    <span class="space-caption">Room for your writing.</span>
    <div class="comfort-pill capsule" id="comfort-pill">
      <span class="comfort-logo"><Logo /></span><span class="comfort-clock">0:08</span>
      <span class="comfort-rail" aria-hidden="true">{railBars.map((h) => <i style={`height:${h}px`} />)}</span>
      <span class="comfort-mode">Hands-free</span>
      <p>A little room for your thoughts.</p>
    </div>
  </div>
  <div class="comfort-choices" aria-label="Recording pill design" data-choice-group data-kind="classname" data-target="comfort-pill" data-base="comfort-pill">
    {
      pills.map((p, i) => (
        <button type="button" class:list={{ selected: i === 0 }} data-choice={p.key} aria-pressed={i === 0 ? 'true' : 'false'} disabled data-enables>
          {p.name}
        </button>
      ))
    }
  </div>
  <div class="position-choices" data-choice-group data-kind="classname" data-target="comfort-space" data-base="comfort-space">
    <span>Where it appears</span>
    {
      positions.map((p) => (
        <button type="button" class:list={{ selected: p.key === 'bottom' }} data-choice={p.key} aria-pressed={p.key === 'bottom' ? 'true' : 'false'} disabled data-enables>
          {p.name}
        </button>
      ))
    }
  </div>
  <small>Illustrative design preview</small>
</div>
