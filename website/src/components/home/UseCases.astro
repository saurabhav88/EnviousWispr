---
import { getImage } from 'astro:assets';
import cases from '../../data/home/cases.json';
import AppDemo from './AppDemo.astro';
import { useCaseArt as images } from '../../utils/home/use-case-art.js';
const assets = await Promise.all(
  cases.map(async (item) => {
    const src = images[item.image];
    if (!src) throw new Error(`UseCases: no import for cases.json image "${item.image}"`);
    const widths = [480, 800, 1200];
    const outputs = await Promise.all(
      widths.map((width) => getImage({ src, width, format: 'webp', quality: 82 })),
    );
    return {
      src: outputs[1].src,
      srcset: outputs.map((v, i) => v.src + ' ' + widths[i] + 'w').join(', '),
      // Dimensions come from the 800w output, never from `src`: any property
      // read on an imported ImageMetadata marks the ORIGINAL as referenced
      // (astro/assets/utils/proxy.js), and the full-size master (1.4 to
      // 1.9 MB each, 14 MB for the nine) is then kept in dist although no
      // page loads it. check-dist-weight.mjs fails the build if that returns.
      width: outputs[1].attributes.width,
      height: outputs[1].attributes.height,
    };
  }),
);
const apps = ['vscode', 'clinical', 'keep', 'gmail', 'docs', 'slack', 'discord', 'notes', 'teams'];
---

<section class="people section-surface" id="people" aria-labelledby="people-title">
  <div class="wrap">
    <div class="section-heading">
      <p class="eyebrow">For your day</p><h2 id="people-title">
        See yourself <span class="accent-ink">using EnviousWispr.</span>
      </h2><p>From code to email to study notes. Speak directly into the apps you already use.</p>
    </div><div class="audience-choices" role="group" aria-label="Choose your writing workflow">
      {
        cases.map((item, i) => (
          <button data-audience={i} type="button" aria-pressed={String(i === 0)} disabled>
            <span aria-hidden="true">{item.emoji}</span>
            {item.name}
          </button>
        ))
      }
    </div>
    <div class="carousel-frame">
      <button type="button" class="carousel-side is-prev" id="case-prev" disabled aria-label="Previous use case"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <div class="home-carousel case-carousel" tabindex="0" role="region" aria-label="Ways to use EnviousWispr">
        {cases.map((item, i) => (
          <article class="case-frame" aria-labelledby={`case-title-${i}`}>
            <div class="case-stage" data-case={i}>
              <div class="case-copy">
                <h3 id={`case-title-${i}`}>{item.title}</h3>
                <p>{item.note}</p>
                <span class="case-status">{item.upcoming ? 'Android coming soon' : item.sampleLabel || ''}</span>
              </div>
              <figure class="case-person">
                <img class="case-scene" src={assets[i].src} srcset={assets[i].srcset}
                  sizes="(max-width:600px) 90vw, 50vw" width={assets[i].width} height={assets[i].height}
                  loading="lazy" decoding="async" draggable="false"
                  alt={'Illustrated ' + item.name.toLowerCase() + ' speaking toward a ' + (item.upcoming ? 'phone' : 'computer')} />
              </figure>
              <div class:list={['case-screen', { 'is-phone': item.upcoming === true }]} data-phase="finished">
                <AppDemo app={apps[i]} text={item.final} lang={item.lang || 'en'} focusable
                  context={{ to: i === 3 ? 'Jordan' : undefined,
                    title: i === 4 ? 'City life · Essay draft' : i === 7 ? 'Family message' : 'Story notes',
                    room: i === 6 ? 'episode-planning' : undefined }} />
              </div>
            </div>
          </article>
        ))}
      </div>
      <button type="button" class="carousel-side is-next" id="case-next" disabled aria-label="Next use case"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
    </div>
    <p class="case-swipe-hint" aria-hidden="true">Swipe to explore more ways to use it ↔</p>
    <div class="case-controls">
      <div>
        <button class="text-button" id="case-tour" disabled>Pause tour</button><span id="case-count"
          >1 / {cases.length}</span
        >
      </div>
    </div><a href="/blog/" class="text-link">Explore more ways to use dictation ↗</a>
  </div>
</section>
