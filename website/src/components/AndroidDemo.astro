---
// The Android app's own setup demo, scene 3 ("Tap the bubble to start. Tap the
// check to finish."), drawn for the web (#4161). Geometry, colours, timing and
// the email follow EnviousWispr-Android app/src/main/java/com/envi/wispr/ui/
// OnboardingDemo.kt (GmailCard, tapFrame, DemoPill, DemoRail, DemoHand) and
// OnboardingDemoScript.kt (TAP, TAP_EMAIL, TAP_LANDS); the bubble and pill
// sizes are RecordingAccessibilityOverlay's, in the default SMOKE look.
// The page renders the finished frame, so it reads correctly with no script or
// with reduced motion; scripts/android-demo.js plays the scene on a loop.
import Logo from './home/Logo.astro';
import '../styles/android-demo.css';

const email = ['Hi Priya,', '', 'Can we move our call to Thursday at 3 pm?', '', 'Thanks so much!'];
const rows = [
  { keys: '1234567890'.split('') },
  { keys: 'QWERTYUIOP'.split('') },
  { keys: 'ASDFGHJKL'.split(''), inset: true },
  { keys: ['⇧', ...'ZXCVBNM'.split(''), '⌫'], wide: ['⇧', '⌫'] },
  { keys: ['?123', ',', '☺', ' ', '.', '↵'], wide: ['?123', '↵'], fn: ['?123', ',', '☺', '.', '↵'] },
];
const bars = Array.from({ length: 11 });
const steps = ['Tap the bubble', 'Speak', 'Words land'];
---

<figure class="android-demo" data-android-demo data-step="2">
  <div
    class="ad-card"
    role="img"
    aria-label="An email to Priya Shah on an Android phone. A finger taps the EnviousWispr bubble beside the keyboard, the recording pill opens, the finger taps the check, and the finished email lands in the message at once."
  >
    <div class="ad-bar" aria-hidden="true"><span>←</span><span>✎ ⊘ ➤ ⋮</span></div>
    <div class="ad-row" aria-hidden="true"><span>To</span><span class="ad-chip">Priya Shah</span><span class="ad-chev">⌄</span></div>
    <div class="ad-row" aria-hidden="true"><span>Our call this week</span></div>
    <div class="ad-body" aria-hidden="true">
      <span class="ad-cursor"></span>
      <p class="ad-email">{email.map((line) => (line ? <span>{line}</span> : <span class="ad-gap" />))}</p>
    </div>
    <div class="ad-keyboard" aria-hidden="true">
      <div class="ad-tools"><span>▦</span><span class="ad-gif">GIF</span><span>✦</span><span>▤</span><span>⚙</span><span class="ad-mic">🎙</span></div>
      {
        rows.map((row) => (
          <div class:list={['ad-keys', { inset: row.inset }]}>
            {row.keys.map((key) => (
              <span class:list={['ad-key', { wide: row.wide?.includes(key), fn: row.fn?.includes(key), space: key === ' ' }]}>{key}</span>
            ))}
          </div>
        ))
      }
    </div>
    <div class="ad-bubble" aria-hidden="true"><span class="ad-ground"><Logo class="ad-lips" /></span></div>
    <div class="ad-pill" aria-hidden="true">
      <span class="ad-clock">0:00</span>
      <span class="ad-rail">{bars.map(() => <i />)}</span>
      <span class="ad-control ad-cancel"><svg viewBox="0 0 40 40"><path d="M13.5 13.5l13 13M26.5 13.5l-13 13" /></svg></span>
      <span class="ad-control ad-accept"><svg viewBox="0 0 40 40"><path d="M13.5 20l4.9 4.6 8.1-8.5" /></svg></span>
    </div>
    <span class="ad-ring" aria-hidden="true"></span>
    <svg class="ad-hand" viewBox="0 0 80 100" aria-hidden="true">
      <defs>
        <linearGradient id="ad-skin" x1="0" x2="1">
          <stop offset="0" stop-color="#e8af88" /><stop offset=".5" stop-color="#f8cfaa" /><stop offset="1" stop-color="#dd9f78" />
        </linearGradient>
      </defs>
      <g class="ad-hand-pose">
        <rect x="18" y="78" width="50" height="22" rx="6" fill="#8b5cf6" />
        <rect x="12" y="34" width="46" height="46" rx="16" fill="url(#ad-skin)" />
        <rect x="48" y="40" width="18" height="30" rx="9" fill="url(#ad-skin)" />
        <rect x="12" y="0" width="16" height="50" rx="8" fill="url(#ad-skin)" />
      </g>
    </svg>
  </div>
  <figcaption class="ad-steps">
    <ol>{steps.map((step, i) => <li data-step-index={i}><span>{i + 1}</span>{step}</li>)}</ol>
    <div class="ad-toggle-slot"><button type="button" class="ad-toggle" data-android-demo-toggle hidden>Pause</button></div>
  </figcaption>
</figure>

<script>
  import '../scripts/android-demo.js';
</script>
