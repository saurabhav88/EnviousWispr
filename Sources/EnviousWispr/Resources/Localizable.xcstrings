            "value" : "„%@“"
          }
        }
      }
    },
    "\"%@\" added to %@" : {
      "comment" : "Quick Add panel: confirmation after adding a spelling. The first %@ is the misheard text, the second the word; use this language's quotation marks.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" added to %2$@"
          }
        },
