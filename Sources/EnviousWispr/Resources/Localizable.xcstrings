    "Add words when you correct your dictation. Turn this off to stop learning new words. Words you already taught can still be fixed." : {
      "comment" : "Dictionary: explains the switch that collects learned words.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dein Diktat korrigierst, lernt das Wörterbuch neue Wörter. Schalte diese Option aus, damit es keine neuen Wörter mehr lernt. Bereits gelernte Korrekturen können weiterhin angewendet werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ajoute des mots lorsque vous corrigez une dictée. Désactivez cette option pour que l’app cesse d’apprendre de nouveaux mots. Elle pourra toujours corriger les mots que vous lui avez déjà appris."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app añade palabras cuando corriges un dictado. Si desactivas esta opción, dejará de aprender palabras nuevas, pero seguirá corrigiendo las que ya le enseñaste."
          }
        }
      }
    },
    "Add your %@ API key to use AI polish." : {
      "comment" : "AI Polish, leave pop-up reason. %@ is a provider name, such as OpenAI.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deinen %@-API-Schlüssel hinzu, um die KI-Nachbearbeitung zu nutzen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez votre clé API %@ pour utiliser la Retouche IA."
          }
        },
