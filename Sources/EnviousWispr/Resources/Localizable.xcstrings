    "whatsNew.enviouswispr-in-french.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry enviouswispr-in-french).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Français in Settings > App Settings > Appearance > Language, then relaunch to apply. System default follows your Mac's language."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Français“ unter Einstellungen > App-Einstellungen > Erscheinungsbild > Sprache und starte die App dann neu. „Systemstandard“ folgt der Sprache deines Macs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Français » dans Réglages > Réglages de l’app > Apparence > Langue, puis redémarrez l’app pour appliquer le changement. « Par défaut du système » suit la langue de votre Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige “Français” en Ajustes > Ajustes de la app > Aspecto > Idioma y vuelve a abrir la app para aplicar el cambio. “Predeterminado del sistema” usa el idioma de tu Mac."
          }
        }
      }
    },
    "whatsNew.enviouswispr-in-spanish.title" : {
