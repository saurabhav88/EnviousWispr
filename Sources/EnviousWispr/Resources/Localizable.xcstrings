          }
        }
      }
    },
    "Your audio never leaves this Mac. Only the text goes to %@, under your own key." : {
      "comment" : "Transcribe a File: the footer's privacy sentence, before the run. %@ is the cloud provider, used with the user's own API key.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahme verlässt diesen Mac nie. Nur der Text wird mit deinem eigenen API-Schlüssel an %@ gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre audio ne quitte jamais ce Mac. Seul le texte est envoyé à %@, avec votre propre clé."
          }
        },
        "es" : {
