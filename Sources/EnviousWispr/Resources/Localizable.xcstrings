    },
    "%@ has more than %@ dictionary entries, including entries it may hide or disable. EnviousWispr stopped without importing anything." : {
      "comment" : "Import from another dictation app: an error. the first %@ is that app's name, the second the entry limit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has more than %2$@ dictionary entries, including entries it may hide or disable. EnviousWispr stopped without importing anything."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat mehr als %2$@ Wörterbucheinträge, auch wenn einige ausgeblendet oder deaktiviert sind. EnviousWispr hat den Vorgang beendet, ohne etwas zu importieren."
          }
        }
      }
    },
    "%@ has more than %@ entries where it keeps snippets, counting ones that can't be snippets here. EnviousWispr stopped without importing anything." : {
      "comment" : "Snippets, import from another app: error. The first %@ is the other app's name, the second a large limit (never 1).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has more than %2$@ entries where it keeps snippets, counting ones that can't be snippets here. EnviousWispr stopped without importing anything."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat mehr als %2$@ Einträge im Speicher für Textbausteine, auch wenn einige davon hier nicht als Textbausteine verwendet werden können. EnviousWispr hat den Vorgang beendet, ohne etwas zu importieren."
          }
        }
      }
    },
