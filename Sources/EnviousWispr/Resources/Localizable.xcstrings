            "state" : "translated",
            "value" : "Ce mot ne figure plus parmi vos mots. Rien n’a été supprimé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta palabra ya no está entre tus palabras. No se ha eliminado nada."
          }
        }
      }
    },
    "This word is no longer in your words. Your changes weren't saved." : {
      "comment" : "Dictionary word editor: Save stopped because the word was deleted meanwhile.",
