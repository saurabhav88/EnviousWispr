  if wait "$pid"; then rc=0; else rc=$?; fi
  check "an interrupted hook blocks the push" "$rc|$(grep -c 'BLOCKED (interrupted)' "$tmp/int.out")" "130|1"
  local slow slow_child; slow="$(cat "$tmp/slow.pid" 2> /dev/null)"; slow_child="$(cat "$tmp/slow.pid.child" 2> /dev/null)"
  check "precondition: the slow check and its child were running when interrupted" "$([ -n "$slow" ] && [ -n "$slow_child" ] && echo yes || echo no)" "yes"
  sleep 0.2
  check "interruption stopped the check itself" "$([ -n "$slow" ] && kill -0 "$slow" 2> /dev/null && echo running || echo stopped)" "stopped"
  check "interruption stopped the check's own child process" "$([ -n "$slow_child" ] && kill -0 "$slow_child" 2> /dev/null && echo running || echo stopped)" "stopped"
  # Fallback cleanup of this test's own processes only, after the assertions.
