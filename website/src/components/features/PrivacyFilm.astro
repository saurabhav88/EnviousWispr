---
// Why Offline film (#2816), the mock's privacy_demo.py. The scene art is a
// fixed illustration (no user content), emitted verbatim from a template so
// every path matches the approved drawing; the lips use LoopLips without glow.
import LoopLips from './LoopLips.astro';
const people = [120, 180, 240]
  .map(
    (x, i) =>
      `<g class="cloud-exec" style="--delay:${i * -0.2}s" transform="translate(${x},62)"><path d="M-21 43v-27q21-12 42 0v27" fill="var(--surface)" stroke="var(--line)"/><circle cx="0" cy="0" r="12" fill="var(--person-skin)"/><path d="M-12-3q-2-19 14-12q13 1 10 14l-5-9q-9 5-19 7" fill="#403047"/><path d="M-8-2q3-4 6 0m4 0q3-4 6 0" fill="none" stroke="#322535" stroke-width="2"/><path d="M-5 5q5 10 10 0z" fill="#322535"/><path d="M-18 39v-13q18-20 36 0v13" fill="var(--accent)"/><path d="m-4 13 4 13 4-13" fill="white"/></g>`,
  )
  .join('');
const art = `<svg class="privacy-scene-art" viewBox="0 0 360 340"><g class="privacy-cloud"><path d="M76 120C25 108 35 55 80 53C85 8 137 6 158 31C187-6 239 6 250 41C300 21 331 66 311 93C347 119 319 150 282 146H89Z" fill="var(--card)" stroke="var(--line)" stroke-width="2"/>${people}<ellipse cx="180" cy="108" rx="87" ry="15" fill="var(--body)"/><path d="M135 120v18m89-18v18" stroke="var(--body)" stroke-width="5"/><g fill="var(--card)" stroke="var(--line)"><rect x="109" y="94" width="14" height="10" rx="2"/><rect x="227" y="94" width="14" height="10" rx="2"/></g><path d="M153 101h34l-3 8h-34z" fill="var(--surface)"/><g class="cloud-money" fill="var(--accent)" font-size="16" font-weight="700"><text x="87" y="55">$</text><text x="151" y="29">$</text><text x="246" y="62">$</text></g><g class="cloud-server"><rect x="274" y="81" width="24" height="45" rx="4" fill="var(--surface)" stroke="var(--line)"/><path d="M277 94h18m-18 12h18" stroke="var(--line)"/><circle cx="282" cy="88" r="2" fill="var(--accent)"/><circle cx="282" cy="101" r="2" fill="var(--accent)"/><circle cx="282" cy="115" r="2" fill="var(--accent)"/></g><text x="270" y="49" font-size="14" fill="var(--accent)" transform="rotate(12 270 49)">ha ha!</text></g><path class="privacy-wire-upper" d="M224 196Q224 169 180 162V144" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/><path class="privacy-wire-bridge" d="M224 196V212" fill="none" stroke="var(--accent)" stroke-width="3"/><path class="privacy-wire-lower" d="M224 259V212" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/><g class="privacy-packets"><g class="word-packet packet-one"><rect x="155" y="207" width="88" height="22" rx="6"/><text x="163" y="222">my notes…</text></g><g class="word-packet packet-two"><rect x="151" y="207" width="98" height="22" rx="6"/><text x="159" y="222">the proposal…</text></g><g class="word-packet packet-three"><rect x="145" y="207" width="106" height="22" rx="6"/><text x="153" y="222">next quarter…</text></g></g><g class="privacy-person"><circle cx="103" cy="223" r="24" fill="var(--person-skin)"/><path d="M77 223q-6-42 29-34q33 0 20 38l-7-22q-22 10-42 18" fill="#403047"/><circle cx="118" cy="219" r="2.5" fill="#322535"/><path class="talking-mouth" d="M120 232q5 7 9 0" fill="none" stroke="#743e3c" stroke-width="2.5" stroke-linecap="round"/><path d="M94 276v29" stroke="var(--line)" stroke-width="2"/><path d="M70 308v-34q34-43 65 0v34" fill="var(--accent)"/><path d="m122 277 29 15 28 6" stroke="var(--person-skin)" stroke-width="13" fill="none" stroke-linecap="round"/><g class="privacy-laptop"><path d="m203 249 35 3-10 52-25-4z" fill="var(--body)" stroke="var(--body)" stroke-width="2"/><path d="m207 254 25 2-8 41-17-2z" fill="var(--soft)" stroke="var(--accent)" stroke-width="1.5"/><path d="m146 300 58-3 24 7-67 3z" fill="var(--card)" stroke="var(--body)" stroke-width="2"/><path d="m162 301 36-1m-26 4 25-1" stroke="var(--line)" stroke-width="2"/><path d="m212 268 13 1m-15 8 13 1m-14 7 9 1" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" opacity=".6"/></g><g class="privacy-mug" transform="translate(197 0)"><rect x="48" y="285" width="15" height="20" rx="3" fill="var(--accent)" stroke="var(--accent)"/><path d="M63 291q12 0 0 10" fill="none" stroke="var(--accent)" stroke-width="2"/><path d="M50 273q-5 4 1 8m7-11q-5 4 1 8" stroke="var(--body)" fill="none" opacity=".6"/></g><path d="M57 308h250" stroke="var(--body)" stroke-width="4" stroke-linecap="round"/><path d="m133 219 16-5m-13 17h18" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/></g><g class="privacy-cut-tool" transform="translate(240 204)"><g class="cut-entry"><g class="cut-upper"><path d="M-20-19 0 0 28 10" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/><ellipse cx="-26" cy="-24" rx="11" ry="8" fill="var(--card)" stroke="var(--accent)" stroke-width="5"/></g><g class="cut-lower"><path d="M-20 19 0 0 28-10" stroke="var(--ink)" stroke-width="5" stroke-linecap="round"/><ellipse cx="-26" cy="24" rx="11" ry="8" fill="var(--card)" stroke="var(--accent)" stroke-width="5"/></g><circle r="4" fill="var(--accent)"/><g class="cut-spark" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M13-22l3-8m6 18 8-4m-18 36 3 8"/></g></g></g></svg>`;
---

<div class="privacy-film" data-privacy-film data-scene="0">
  <div class="privacy-film-head"><span data-privacy-title>When dictation uses the cloud</span><button type="button" data-privacy-play aria-label="Pause privacy demo">Ⅱ</button></div>
  <div class="privacy-stage" aria-hidden="true">
    <div class="privacy-cloud-story">
      <div class="privacy-local-mark"><LoopLips glowId="privacy-lip-glow" plain /></div>
      <Fragment set:html={art} />
      <h3 data-privacy-story>Your words are<br /><span class="privacy-money">$$$</span> for corporations.</h3>
    </div>
  </div>
  <div class="privacy-film-foot"><span data-privacy-caption>Your words are sent to a server.</span></div>
  <span class="privacy-film-note">Illustrated comparison. EnviousWispr’s local mode keeps processing on your Mac.</span>
  <span class="privacy-film-description">A cartoon shows words moving from a computer to a cloud boardroom. Scissors cut the connection. EnviousWispr is introduced as a free, open-source Mac app with offline transcription and local AI polishing.</span>
</div>
