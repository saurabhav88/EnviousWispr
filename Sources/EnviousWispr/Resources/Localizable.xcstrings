    "whatsNew.gemma-3-nano.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry gemma-3-nano).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google's 4B Gemma 3 Nano is now available in the Ollama model picker. A tight on-device option for AI polish when you want speed and privacy and don't need a large model."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googles Gemma 3 Nano mit vier Milliarden Parametern ist jetzt in der Ollama-Modellauswahl verfügbar. Eine kompakte Option auf dem Gerät für die KI-Nachbearbeitung, wenn dir Tempo und Datenschutz wichtig sind und du kein großes Modell brauchst."
          }
        }
      }
    },
    "whatsNew.gemma4-polish-fixed.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry gemma4-polish-fixed).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemma 4 polish works again"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachbearbeitung mit Gemma 4 funktioniert wieder"
          }
        }
      }
    },
    "whatsNew.gemma4-polish-fixed.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry gemma4-polish-fixed).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local AI polish with Gemma 4 was quietly falling back to the raw transcript on every dictation. It now produces cleaned-up output reliably. Fillers are removed, punctuation is added, and lists are formatted, all running offline on your Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die lokale KI-Nachbearbeitung mit Gemma 4 lieferte bisher bei jedem Diktat unbemerkt das rohe Transkript zurück. Jetzt erzeugt sie zuverlässig bearbeiteten Text: Füllwörter werden entfernt, Satzzeichen ergänzt und Listen formatiert – vollständig offline auf deinem Mac."
          }
        }
      }
    },
    "whatsNew.thinking-models-supported.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry thinking-models-supported).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better support for reasoning models"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Unterstützung für Modelle mit Denkmodus"
          }
        }
      }
    },
    "whatsNew.thinking-models-supported.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry thinking-models-supported).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking models like Gemma 4, Qwen 3, QwQ, DeepSeek R1, and gpt-oss now have enough room to finish reasoning and still produce a clean polished answer. Smaller local models still run on the tight budget that keeps them fast and reliable."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle wie Gemma 4, Qwen 3, QwQ, DeepSeek R1 und gpt-oss haben jetzt genug Raum, um ihre Schlussfolgerung abzuschließen und anschließend sauberen, nachbearbeiteten Text auszugeben. Kleinere lokale Modelle behalten ihre knappen Grenzen, damit sie schnell und zuverlässig bleiben."
          }
        }
      }
    },
    "whatsNew.multilingual-auto-detect.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry multilingual-auto-detect).",
