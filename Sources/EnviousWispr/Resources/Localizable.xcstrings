            "value" : "Dieses Transkript hat sich inzwischen geändert, daher wurde nichts ersetzt. Versuche es erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette transcription a changé entre-temps. Rien n’a été remplacé. Réessayez."
