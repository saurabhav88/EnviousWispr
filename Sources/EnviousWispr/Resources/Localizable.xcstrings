    "whatsNew.enviouswispr-in-german.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry enviouswispr-in-german).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Deutsch in Settings > Appearance > Language, then relaunch to apply. System default follows your Mac's language."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Deutsch“ unter Einstellungen > Erscheinungsbild > Sprache und starte die App dann neu. „Systemstandard“ folgt der Sprache deines Macs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Deutsch dans Réglages > Apparence > Langue, puis relancez l’app pour appliquer la modification. Le réglage par défaut du système suit la langue de votre Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Deutsch en Ajustes > Aspecto > Idioma y vuelve a abrir la app para aplicar el cambio. La opción predeterminada del sistema usa el idioma de tu Mac."
          }
        }
      }
    },
    "whatsNew.paste-last-dictation.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-last-dictation).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste Last Dictation"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letztes Diktat einfügen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coller la dernière dictée"
          }
        },
