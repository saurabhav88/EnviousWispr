    "whatsNew.cleaner-audio-settings.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry cleaner-audio-settings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removed the noise suppression toggle. It wasn't doing what its name suggested, and a quieter settings panel is one less thing to wonder about."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schalter für Rauschunterdrückung wurde entfernt. Er tat nicht das, was sein Name versprach. So gibt es in den Einstellungen eine unklare Option weniger."
          }
        }
      }
    },
    "whatsNew.update-banner-stays-put.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry update-banner-stays-put).",
