            "state" : "translated",
            "value" : "Anpassbare Aufnahmetöne"
          }
        }
      }
    },
    "whatsNew.recording-sound-cues.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry recording-sound-cues).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional chimes when recording starts and stops. Twelve to choose from, soft to loud. Off by default."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional ertönt beim Starten und Stoppen einer Aufnahme ein Signal. Zwölf Töne stehen zur Wahl, von dezent bis deutlich. Standardmäßig sind sie ausgeschaltet."
          }
        }
      }
    },
    "whatsNew.recording-pill-position.title" : {
