    "whatsNew.paste-chromium-electron.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-chromium-electron).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictating into Chrome, Slack, Discord, VS Code, and other Electron-based apps now pastes cleanly even when the focused text field isn't fully reported. Previously the text would sometimes sit on the clipboard instead of landing in place."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktierter Text wird jetzt auch in Chrome, Slack, Discord, VS Code und anderen Electron-Apps richtig eingefügt, wenn das aktive Textfeld nicht vollständig gemeldet wird. Bisher blieb der Text manchmal nur in der Zwischenablage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée dans Chrome, Slack, Discord, VS Code et d’autres apps basées sur Electron est maintenant collée correctement, même lorsque le champ de texte sélectionné n’est pas entièrement détecté. Auparavant, le texte restait parfois dans le presse-papiers au lieu d’être inséré au bon endroit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora el dictado se pega correctamente en Chrome, Slack, Discord, VS Code y otras apps basadas en Electron, incluso cuando la app de destino no proporciona toda la información sobre el campo de texto activo. Antes, el texto a veces se quedaba en el portapapeles en vez de pegarse donde correspondía."
          }
        }
      }
    },
