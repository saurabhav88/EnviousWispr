    "whatsNew.smoother-model-switching.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smoother-model-switching).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switching between local AI polish models now frees up the previous model cleanly, so your Mac stays responsive and recordings keep working."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel zwischen lokalen Modellen zur KI-Nachbearbeitung wird das bisherige Modell jetzt sauber freigegeben. Dein Mac bleibt reaktionsschnell und Aufnahmen funktionieren weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous passez d’un modèle de retouche IA local à un autre, le modèle précédent est désormais libéré proprement. Votre Mac reste réactif et les enregistrements continuent de fonctionner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiar de modelo local de Pulido con IA, la app libera la memoria que ocupaba el modelo anterior. Así tu Mac sigue respondiendo bien y puedes seguir grabando."
          }
        }
      }
    },
