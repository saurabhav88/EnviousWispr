    "whatsNew.keybind-conflict-warning.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry keybind-conflict-warning).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If macOS says a key combination is already taken, Settings > Keybinds now shows a warning under that shortcut. Choose a different key combination to fix it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn macOS meldet, dass eine Tastenkombination bereits vergeben ist, zeigt Einstellungen > Tastenkürzel jetzt eine Warnung unter diesem Kürzel. Wähle eine andere Tastenkombination, um das zu beheben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si macOS indique qu’une combinaison de touches est déjà utilisée, Réglages > Raccourcis clavier affiche désormais un avertissement sous le raccourci concerné. Choisissez une autre combinaison de touches pour résoudre le problème."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si macOS indica que una combinación de teclas ya está en uso, Ajustes > Atajos de teclado ahora muestra un aviso debajo de ese atajo. Elige otra combinación de teclas para solucionarlo."
          }
        }
      }
    },
    "whatsNew.clipboard-restored-in-chrome.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry clipboard-restored-in-chrome).",
