---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import ThemedLayout from "./ThemedLayout.astro";
import BlogCard from "../components/blog/BlogCard.astro";
import BlogIcon from "../components/blog/BlogIcon.astro";
import ArticleContents from "../components/blog/ArticleContents.astro";
import BlogShareRow from "../components/BlogShareRow.astro";
import DownloadClosing from "../components/DownloadClosing.astro";
import { presentPost, type BlogCardData } from "../utils/blog-presentation";
import founder from "../assets/home/founder.png";
import "../styles/themed-base.css";
import "../styles/blog.css";

interface Props {
  post: CollectionEntry<"blog">;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts: BlogCardData[];
}
const { post, headings, relatedPosts } = Astro.props;
const card = await presentPost(post);
const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  authorUrl,
  image,
  tags,
} = post.data;
const isFounder = author === "Saurabh Vaish";
const profile =
  authorUrl ??
  (isFounder ? "https://enviouswispr.com/authors/saurabh-vaish/" : undefined);
const avatar = isFounder
  ? await getImage({
      src: founder,
      width: 120,
      height: 120,
      fit: "cover",
      format: "webp",
      quality: 80,
    })
  : null;
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
const canonical = `https://enviouswispr.com${card.url}`;
const ogImage = image || card.artwork?.social || "/og-image.png";
const authorSchema = {
  "@type": author === "Envious Labs" ? "Organization" : "Person",
  name: author,
  ...(profile ? { url: profile } : {}),
  ...(isFounder
    ? {
        jobTitle: "Founder",
        worksFor: {
          "@type": "Organization",
          name: "Envious Labs",
          url: "https://enviouslabs.co",
        },
        sameAs: [
          "https://github.com/saurabhav88",
          "https://www.linkedin.com/in/saurabh-a-vaish-568253a6/",
          "https://x.com/EnviousLabs",
        ],
        knowsAbout: [
          "AI dictation",
          "speech-to-text",
          "on-device AI",
          "macOS development",
          "Apple Silicon",
          "accessibility",
          "privacy-first software",
          "open source software",
        ],
      }
    : {}),
};
const faqs = post.data.faqs;
const structured = JSON.stringify([
  // Preserve authored FAQ data; this does not promise search rich results.
  ...(faqs && faqs.length >= 3
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faqs.map(({ question, answer }) => ({
            "@type": "Question",
            name: question,
            acceptedAnswer: { "@type": "Answer", text: answer },
          })),
        },
      ]
    : []),
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    image: ogImage.startsWith("http")
      ? ogImage
      : `https://enviouswispr.com${ogImage}`,
    datePublished: pubDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    author: authorSchema,
    publisher: {
      "@type": "Organization",
      name: "Envious Labs",
      url: "https://enviouswispr.com",
      logo: {
        "@type": "ImageObject",
        url: "https://enviouswispr.com/favicon.svg",
      },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://enviouswispr.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: "https://enviouswispr.com/blog/",
      },
      { "@type": "ListItem", position: 3, name: title, item: canonical },
    ],
  },
]).replace(/</g, "\\u003c");
---

<ThemedLayout
  title={`${title} | EnviousWispr`}
  description={description}
  activePage="blog"
  canonicalPath={card.url}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={`${title} | EnviousWispr`}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && (
      <meta
        property="article:modified_time"
        content={updatedDate.toISOString()}
      />
    )}
    <meta property="article:author" content={author} />
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <script type="application/ld+json" set:html={structured}></script>
  </Fragment>
  <div class="wrap article-wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">/</span>
      <span>{card.topicLabel}</span>
    </nav>
    <div class="reading-layout">
      <article class="reading-main">
        <header class="reading-header">
          <span class="topic">{card.topicLabel}</span>
          <h1>{title}</h1>
          <p class="article-deck">{description}</p>
          <div class="article-byline">
            {avatar && <img src={avatar.src} alt="" width="42" height="42" />}
            <div>
              {profile ? (
                <a href={profile} rel="author">
                  {author}
                </a>
              ) : (
                <strong>{author}</strong>
              )}
              <span>
                <time datetime={pubDate.toISOString()}>
                  {formatDate(pubDate)}
                </time>{" "}
                · {card.minutes} min read
                {updatedDate && (
                  <>
                    {" "}
                    · Updated{" "}
                    <time datetime={updatedDate.toISOString()}>
                      {formatDate(updatedDate)}
                    </time>
                  </>
                )}
              </span>
            </div>
          </div>
        </header>
        {card.artwork && (
          <div class="article-hero">
            <img
              class="artwork-image"
              src={card.artwork.src}
              srcset={card.artwork.srcset}
              sizes="(min-width: 1150px) 790px, (min-width: 851px) 65vw, calc(100vw - 40px)"
              width={card.artwork.width}
              height={card.artwork.height}
              alt=""
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )}
        <ArticleContents headings={headings} mobile />
        <div class="reading-body">
          <slot />
        </div>
        <BlogShareRow />
        <div
          id="share-status"
          class="visually-hidden"
          aria-live="polite"
          aria-atomic="true"
        ></div>
        <aside class="author-note" aria-label="About the author">
          {avatar && (
            <img
              src={avatar.src}
              alt=""
              width="60"
              height="60"
              loading="lazy"
            />
          )}
          <div>
            <strong>{author}</strong>
            <p>
              {isFounder
                ? "Building EnviousWispr, a free dictation app for Mac. Sharing what we learn along the way."
                : `Articles from ${author}.`}
            </p>
          </div>
        </aside>
      </article>
      <aside class="reading-rail" aria-label="Article navigation">
        <ArticleContents headings={headings} />
        <div class="rail-share">
          <button class="copy-link" data-share="copy">
            <BlogIcon name="copy" />
            <span class="rail-btn-label">Copy link</span>
          </button>
        </div>
        <a class="rail-back" href="/blog/">
          ← All articles
        </a>
      </aside>
    </div>
    {relatedPosts.length > 0 && (
      <section class="related-section" aria-label="Related articles">
        <div class="related-heading">
          <h2>Keep exploring</h2>
          <a class="text-link" href="/blog/">
            All articles <BlogIcon />
          </a>
        </div>
        <div class="article-grid">
          {relatedPosts.map((related) => (
            <BlogCard post={related} heading="h3" />
          ))}
        </div>
      </section>
    )}
  </div>
  <DownloadClosing source="blog-post" />
</ThemedLayout>
<script>
  import "../scripts/blog-article";
</script>
