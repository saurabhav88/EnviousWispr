      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Modelle bleiben auf diesem Mac; gehostete Modelle senden Text an Ollamas Server. Vorbereiten lädt ein lokales Modell vor deinem nächsten Diktat in den Speicher."
          }
        },
        "fr" : {
