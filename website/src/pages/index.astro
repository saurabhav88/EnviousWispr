  canonicalPath="/"
>
  <StructuredData slot="head" />
  <HeroArtPreload slot="head" />
  <Hero />
  <CompatibleApps />
  <Workflow />
  <SpeechEngines />
  <Providers />
  <Cleanup />
  <UseCases />
  <Evidence />
  <Comparisons />
  <Founder />
