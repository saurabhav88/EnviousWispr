    },
    "The summary engine isn't ready. Check it in Summaries settings, then try again." : {
      "comment" : "History, a meeting: the summary engine (Ollama not running, Apple Intelligence not available, no key) is not ready.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
