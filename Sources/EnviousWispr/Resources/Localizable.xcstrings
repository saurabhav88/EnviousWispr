    "whatsNew.update-when-ready.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry update-when-ready).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New versions show up as a quiet in-app banner instead of an interrupting popup. You stay in flow, then update on your schedule."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Versionen erscheinen als unaufdringlicher Hinweis in der App statt als unterbrechendes Pop-up. Du kannst deine Arbeit fortsetzen und das Update später installieren."
          }
        }
      }
    },
    "whatsNew.stronger-privacy-by-default.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry stronger-privacy-by-default).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stronger privacy, by default"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Datenschutz als Standard"
          }
        }
      }
    },
    "whatsNew.stronger-privacy-by-default.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry stronger-privacy-by-default).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud polish now opts out of training storage where supported. Crash reports scrub sensitive details before they leave your Mac. Stored files have tighter permissions. Gemini request logging is off. The Privacy section explains what each cloud provider keeps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud-Nachbearbeitung schließt die Speicherung zu Trainingszwecken aus, wo der Anbieter dies unterstützt. Absturzberichte werden vor dem Verlassen deines Mac von sensiblen Angaben bereinigt. Gespeicherte Dateien haben strengere Zugriffsrechte. Die Protokollierung von Gemini-Anfragen ist ausgeschaltet. Unter „Datenschutz“ erfährst du, was die einzelnen Cloud-Anbieter aufbewahren."
          }
        }
      }
    },
    "whatsNew.smoother-model-switching.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smoother-model-switching).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smoother model switching"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reibungsloserer Modellwechsel"
          }
