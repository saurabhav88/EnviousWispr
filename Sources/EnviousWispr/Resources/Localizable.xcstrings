    "whatsNew.stronger-privacy-by-default.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry stronger-privacy-by-default).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stronger privacy, by default"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Datenschutz als Standard"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une confidentialité renforcée par défaut"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más privacidad de forma predeterminada"
          }
        }
      }
    },
    "whatsNew.stronger-privacy-by-default.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry stronger-privacy-by-default).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloud polish now opts out of training storage where supported. Crash reports scrub sensitive details before they leave your Mac. Stored files have tighter permissions. Gemini request logging is off. The Privacy section explains what each cloud provider keeps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud-Nachbearbeitung schließt die Speicherung zu Trainingszwecken aus, wo der Anbieter dies unterstützt. Absturzberichte werden vor dem Verlassen deines Mac von sensiblen Angaben bereinigt. Gespeicherte Dateien haben strengere Zugriffsrechte. Die Protokollierung von Gemini-Anfragen ist ausgeschaltet. Unter „Datenschutz“ erfährst du, was die einzelnen Cloud-Anbieter aufbewahren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le fournisseur le permet, la retouche dans le cloud désactive le stockage à des fins d’entraînement. Les rapports de plantage sont débarrassés des données sensibles avant de quitter votre Mac. Les fichiers stockés bénéficient d’autorisations plus strictes. La journalisation des requêtes Gemini est désactivée. La section Confidentialité explique ce que conserve chaque fournisseur cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el proveedor lo permite, EnviousWispr solicita que los datos del Pulido en la nube no se guarden para entrenar modelos. La app elimina los datos confidenciales de los informes de cierres inesperados antes de enviarlos desde tu Mac. Los archivos guardados tienen permisos más restrictivos y el registro de solicitudes de Gemini está desactivado. En Privacidad puedes consultar qué datos conserva cada proveedor en la nube."
          }
        }
      }
    },
    "whatsNew.smoother-model-switching.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smoother-model-switching).",
      "extractionState" : "manual",
      "localizations" : {
