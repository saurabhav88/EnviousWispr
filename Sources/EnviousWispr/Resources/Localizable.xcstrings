    "OpenAI API Key" : {
      "comment" : "AI Polish: label and VoiceOver name of the API key field.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI-API-Schlüssel"
