    </div>
    <div class="compare-table-wrap reveal">
      <table class="compare-table compare-table--duo">
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">EnviousWispr</th>
            <th scope="col">Otter.ai</th>
          </tr>
