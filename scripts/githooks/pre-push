  rpush origin "$cat_a:refs/heads/cat-older"; rc=$?
  check "C7 a non-HEAD push is judged with ITS commit's digest, not HEAD's" \
    "$rc|$(grep -c -- "--expect-inputs $(digest_of "$cat_a")" "$CATALOG_TRACE")|$(grep -c -- "--expect-inputs $(digest_of "$cat_b")" "$CATALOG_TRACE")" "0|1|0"
  echo "let a = dirty" > "$repo/Sources/EnviousWisprCore/A.swift"
  : > "$CATALOG_TRACE"
  rpush origin "cat-add:cat-dirty"; rc=$?
  check "C8 dirty files in the pushing checkout never change the digest" \
    "$rc|$(grep -c -- "--expect-inputs $(digest_of "$cat_b")" "$CATALOG_TRACE")" "0|1"
  git -C "$repo" checkout --quiet -- Sources/EnviousWisprCore/A.swift
  : > "$CATALOG_TRACE"
  rpush origin "$cat_a:refs/heads/cat-two-a" "$cat_b:refs/heads/cat-two-b"; rc=$?
  check "C9 two refs in one push: each commit judged with its own digest" \
    "$rc|$(stub_calls)|$(grep -c -- "--expect-inputs $(digest_of "$cat_a")" "$CATALOG_TRACE")|$(grep -c -- "--expect-inputs $(digest_of "$cat_b")" "$CATALOG_TRACE")" \
    "0|2|1|1"

  # C10. Another checkout of the same repository HAS a Dev build; the pushing one does not.
  w2="$tmp/worktree-two"
  git -C "$repo" worktree add --quiet -b cat-w2 "$w2" cat-add
  # The pushing checkout's OWN validation receipt (#3729 PR-C): the base tree's, which covers
  # these Sources/ commits under the stand-in classifiers.
  mkdir -p "$w2/.derivedData/Test" && cp "$RECEIPT_FILE" "$w2/.derivedData/Test/"
  echo "let d = 1" > "$w2/Sources/EnviousWisprCore/D.swift"; git -C "$w2" add -A; git -C "$w2" commit --quiet -m "from w2"
  : > "$CATALOG_TRACE"
  PATH="$fakebin:$PATH" git -C "$w2" push origin cat-w2 > "$tmp/push.out" 2>&1; rc=$?
  check "C10 no fallback to another checkout's Dev build" \
    "$rc|$(grep -c "catalog: COULD NOT RUN (no Dev build in $w2" "$tmp/push.out")|$(stub_calls)" "0|1|0"
  # With a Dev build in BOTH checkouts, the pushing checkout's is the one passed.
  mkdir -p "$w2/.derivedData/Dev"
  : > "$CATALOG_TRACE"
  PATH="$fakebin:$PATH" git -C "$w2" push origin cat-w2:cat-w2-again > "$tmp/push.out" 2>&1; rc=$?
  check "C10b both checkouts have a Dev build: the pushing checkout's is the one judged" \
    "$rc|$(grep -c -- "--derived-data $w2/.derivedData/Dev " "$CATALOG_TRACE")|$(grep -c -- "--derived-data $repo/.derivedData/Dev " "$CATALOG_TRACE")" \
    "0|1|0"
  git -C "$repo" worktree remove --force "$w2"

  # C11. Past its deadline (the stand-in ignores TERM): COULD NOT RUN, stopped, allowed.
  if ! inject 'CATALOG_SECONDS=120 # the catalog check: local only (digest, snapshot copy, two xcstringstool syncs)' 'CATALOG_SECONDS=3'; then
    check "the short-catalog-deadline copy was made" "no" "yes"
  else
    rm -f "$CATALOG_TRACE.pid"
    CATALOG_STUB_SLEEP=30 rpush origin "cat-add:cat-slow"; rc=$?
    cat_pid="$(cat "$CATALOG_TRACE.pid" 2> /dev/null)"
    check "C11 a catalog check past its deadline: COULD NOT RUN, stopped, allowed" \
      "$rc|$(grep -c 'catalog: COULD NOT RUN (took longer than 3 s)' "$tmp/push.out")|$([ -n "$cat_pid" ] && kill -0 "$cat_pid" 2> /dev/null && echo running || echo stopped)" \
      "0|1|stopped"
    [ -n "$cat_pid" ] && kill -KILL "$cat_pid" 2> /dev/null
  fi
  cp "$hook" "$tmp/hooks/pre-push"

  # C12. Interrupted while the catalog check runs: blocked, stopped, no snapshot left.
  rm -f "$CATALOG_TRACE.pid"
  printf 'refs/heads/cat-add %s refs/heads/cat-int %s\n' "$cat_b" "$ZERO_SHA" > "$tmp/stdin"
  (cd "$repo" && CATALOG_STUB_SLEEP=30 exec "$BASH" "$hook" origin "$remote" < "$tmp/stdin" > "$tmp/int.out" 2>&1) &
  pid=$!
  waited=0
  while [ ! -s "$CATALOG_TRACE.pid" ] && [ "$waited" -lt 300 ]; do sleep 0.1; waited=$((waited + 1)); done
  cat_pid="$(cat "$CATALOG_TRACE.pid" 2> /dev/null)"
  check "C12 precondition: the catalog check started" "$([ -n "$cat_pid" ] && echo yes || echo no)" "yes"
  kill -TERM "$pid" 2> /dev/null
  if wait "$pid"; then rc=0; else rc=$?; fi
  sleep 0.2
  check "C12 interrupting the catalog check blocks, stops it and leaves no snapshot" \
    "$rc|$([ -n "$cat_pid" ] && kill -0 "$cat_pid" 2> /dev/null && echo running || echo stopped)|$(git -C "$repo" worktree list --porcelain | grep -c 'ew-pre-push')" \
    "130|stopped|0"
  [ -n "$cat_pid" ] && kill -KILL "$cat_pid" 2> /dev/null

  # C13. A pushed commit whose own helper cannot answer which paths changed is COULD NOT RUN.
  git -C "$repo" checkout --quiet -b cat-broken-helper cat-add
  printf '%s\n' '#!/usr/bin/env python3' '# "changed-inputs"' 'import sys; sys.exit(2)' > "$repo/scripts/lib/l10n-build-receipt.py"
  git -C "$repo" commit --quiet -am "helper that cannot say"
  : > "$CATALOG_TRACE"
  rpush origin cat-broken-helper; rc=$?
  check "C13 changed paths unknown: COULD NOT RUN, never 'nothing changed'" \
    "$rc|$(grep -c 'catalog: COULD NOT RUN (cannot tell which paths changed' "$tmp/push.out")|$(grep -c 'catalog: skipped' "$tmp/push.out")|$(stub_calls)" \
    "0|1|0|0"
  git -C "$repo" checkout --quiet main

  # P1-P18. The validation receipt (#3729 PR-C), through real pushes. APP/ is a build input
  # and EVAL/ an eval input under the stand-in classifiers; receipts come from the real helper.
  git -C "$repo" checkout --quiet -f main
  git -C "$repo" clean --quiet -fd
  remote_tip() { git -C "$remote" rev-parse --verify --quiet "refs/heads/$1" || echo none; }
  corrupt_receipt() { mkdir -p "$(dirname "$RECEIPT_FILE")" && printf '{broken\n' > "$RECEIPT_FILE"; }
  commit_file() { mkdir -p "$(dirname "$repo/$1")" && echo "${2:-x}" > "$repo/$1" && git -C "$repo" add -A && git -C "$repo" commit --quiet -m "$1"; }
  hits() { grep -c -- "$1" "$tmp/push.out"; }

  git -C "$repo" checkout --quiet -b p-docs main
  commit_file docs/p1.md
  corrupt_receipt
  push origin p-docs; rc=$?
  check "P1 a new ref without valid proof blocks, names the command, leaves the remote alone" \
    "$rc|$(hits 'receipt: BLOCKED (refs/heads/p-docs is a new ref, and the receipt is not valid proof')|$(hits "Run scripts/xcode-test.sh in $repo")|$(remote_tip p-docs)" \
    "1|1|1|none"
  make_receipt
  push origin p-docs; rc=$?
  check "P2 a new ref with covering proof passes" "$rc|$(hits 'receipt: refs/heads/p-docs covered')|$(remote_tip p-docs)" \
    "0|1|$(git -C "$repo" rev-parse p-docs)"

  commit_file docs/p3.md
  corrupt_receipt
  push origin p-docs; rc=$?
  check "P3 an existing ref whose range changes no input needs no proof, even beside a bad receipt" \
    "$rc|$(hits 'receipt: refs/heads/p-docs not required')" "0|1"

  before_p4="$(remote_tip p-docs)"
  commit_file APP/a.swift
  push origin p-docs; rc=$?
  check "P4 a range that changes a build input blocks without valid proof" \
    "$rc|$(hits 'changes build or eval inputs, and the receipt is not valid proof')|$(remote_tip p-docs)" "1|1|$before_p4"
  make_receipt
  push origin p-docs; rc=$?
  check "P5 the same range with proof of exactly that tree passes" "$rc|$(hits 'receipt: refs/heads/p-docs covered')" "0|1"

  commit_file APP/b.swift
  commit_file docs/p6.md
  push origin p-docs; rc=$?
  check "P6a a multi-commit range is judged at its endpoint: an older receipt does not cover a newer input" \
    "$rc|$(hits 'differs from it in build or eval inputs')" "1|1"
  make_receipt
  push origin p-docs; rc=$?
  check "P6b the endpoint's own receipt covers the whole range" "$rc" "0"

  git -C "$repo" checkout --quiet -b p-other
  commit_file APP/c.swift
  git -C "$repo" checkout --quiet p-docs
  push origin p-other; rc=$?
  check "P7 a non-HEAD tip is judged at its own tree, not the receipt's" \
    "$rc|$(hits 'receipt: BLOCKED (refs/heads/p-other is a new ref; the receipt proves tree')" "1|1"

  commit_file docs/p8.md
  corrupt_receipt
  push origin p-docs:p-docs p-docs:p-new8; rc=$?
  check "P8a one tip, two refs: the existing range is free, the new ref still needs proof" \
    "$rc|$(hits 'receipt: refs/heads/p-docs not required')|$(hits 'receipt: BLOCKED (refs/heads/p-new8 is a new ref')" "1|1|1"
  push origin p-docs:p-new8 p-docs:p-docs; rc=$?
  check "P8b the same push in the other order blocks the same way" \
    "$rc|$(hits 'receipt: refs/heads/p-docs not required')|$(hits 'receipt: BLOCKED (refs/heads/p-new8 is a new ref')" "1|1|1"
  make_receipt
  push origin p-docs:p-docs p-docs:p-new8; rc=$?
  check "P8c with proof both refs pass" "$rc|$(remote_tip p-new8)" "0|$(git -C "$repo" rev-parse p-docs)"

  printf 'refs/heads/p-docs %s refs/heads/p-docs %s\n' "$(git -C "$repo" rev-parse p-docs)" 1234567890123456789012345678901234567890 > "$tmp/stdin"
  corrupt_receipt
  (cd "$repo" && "$BASH" "$hook" origin "$remote" < "$tmp/stdin" > "$tmp/push.out" 2>&1); rc=$?
  check "P10 a remote revision this repository does not have needs proof" \
    "$rc|$(hits 'is not in this repository, and the receipt is not valid proof')" "1|1"

  git -C "$repo" mv APP/a.swift docs/a.md
  git -C "$repo" commit --quiet -m "rename source to docs"
  push origin p-docs; rc=$?
  check "P11 renaming a source file to docs still changes a build input" \
    "$rc|$(hits 'changes build or eval inputs, and the receipt is not valid proof')" "1|1"
  make_receipt
  push origin p-docs; rc=$?
  check "P11b with proof of the renamed tree it passes" "$rc" "0"

  git -C "$repo" tag -a -m annotated p-ann p-docs
  push origin refs/tags/p-ann:refs/heads/p-from-ann; rc=$?
  # The hook's own verdict: the remote then refuses a tag object on a branch, which is git's
  # rule, not this hook's, so the push status is not the subject here.
  check "P12 an annotated tag pushed to a branch is peeled and checked at its commit" \
    "$(hits "pre-push: checking $(git -C "$repo" rev-parse --short=12 p-docs)")|$(hits 'receipt: refs/heads/p-from-ann covered')|$(hits 'pre-push: OK')|$(hits 'hook fault')" "1|1|1|0"
  : "$rc"

  SELFTEST_XCODE_BUILD=28A1 push origin p-docs:p-new13; rc=$?
  check "P13 a receipt from another Xcode is not proof" "$rc|$(hits 'is not the selected 28A1')" "1|1"

  python3 -c 'import json, sys; p = sys.argv[1]; d = json.load(open(p)); d["tree"] = "0" * 40; json.dump(d, open(p, "w"))' "$RECEIPT_FILE"
  push origin p-docs:p-new14; rc=$?
  check "P14 a receipt naming an unknown tree is not proof" "$rc|$(hits 'not a tree object in this repository')" "1|1"
  make_receipt

  git -C "$repo" checkout --quiet -b p-badcls
  printf '%s\n' '#!/usr/bin/env bash' 'echo "needs_build=maybe" >> "$GITHUB_OUTPUT"' > "$repo/scripts/ci/classify-changes.sh"
  git -C "$repo" commit --quiet -am "a classifier with no verdict"
  push origin p-badcls; rc=$?
  check "P15 a classifier that writes no true|false verdict blocks" \
    "$rc|$(hits 'wrote no single needs_build=true|false line')" "1|1"
  git -C "$repo" checkout --quiet p-docs

  git -C "$repo" checkout --quiet -b p-newline
  commit_file "docs/two
lines.md"
  push origin p-newline; rc=$?
  check "P16 a path with a newline cannot be classified and blocks" "$rc|$(hits 'contains a newline')" "1|1"
  git -C "$repo" checkout --quiet p-docs

  make_receipt
  SELFTEST_DELETE_RECEIPT="$RECEIPT_FILE" push origin p-docs:p-r17a p-docs:p-r17b; rc=$?
  check "P17 a receipt removed while the hook runs does not change that push's proof" \
    "$rc|$(hits 'receipt: refs/heads/p-r17b covered')|$([ -e "$RECEIPT_FILE" ] && echo still-there || echo removed-mid-run)" \
    "0|1|removed-mid-run"
  make_receipt

  before_eval="$(remote_tip p-docs)"
  git -C "$repo" checkout --quiet -b p-eval p-docs
  commit_file EVAL/probe.swift
  push origin p-eval:p-docs; rc=$?
  check "P18a an eval-only change blocks with older proof and leaves the remote unchanged" \
    "$rc|$(hits 'differs from it in build or eval inputs')|$(remote_tip p-docs)" \
    "1|1|$before_eval"
  make_receipt
  push origin p-eval:p-docs; rc=$?
  check "P18b the same eval-only endpoint passes with covering proof" "$rc" "0"
  git -C "$repo" branch --quiet -f p-docs p-eval  # local p-docs follows the remote it now matches
  git -C "$repo" checkout --quiet p-docs

  # P15b-e: duplicate verdict lines, for both classifier keys, including a trailing empty
  # duplicate (which a shell substitution would have read as one verdict).
  for dup in "classify-changes.sh:needs_build:false:" "classify-changes.sh:needs_build:false:false" \
    "needs-eval-packages.sh:needs_eval_packages:false:" "needs-eval-packages.sh:needs_eval_packages:false:false"; do
    dscript="$(echo "$dup" | cut -d: -f1)"; dkey="$(echo "$dup" | cut -d: -f2)"
    dfirst="$(echo "$dup" | cut -d: -f3)"; dsecond="$(echo "$dup" | cut -d: -f4)"
    git -C "$repo" checkout --quiet -b "p-dup-$dkey-${dsecond:-empty}" p-docs
    printf '%s\n' '#!/usr/bin/env bash' "printf '$dkey=$dfirst\\n$dkey=$dsecond\\n' >> \"\$GITHUB_OUTPUT\"" > "$repo/scripts/ci/$dscript"
    git -C "$repo" commit --quiet -am "a classifier writing two $dkey lines"
    push origin "p-dup-$dkey-${dsecond:-empty}"; rc=$?
    check "P15 a duplicate $dkey verdict ($dkey=$dfirst then $dkey=$dsecond) blocks" \
      "$rc|$(hits "wrote no single $dkey=true|false line")" "1|1"
    git -C "$repo" checkout --quiet p-docs
  done
  make_receipt

  git -C "$repo" checkout --quiet -b p-rb main
  commit_file APP/r.swift
  make_receipt
  push origin p-rb; rc=$?
  check "P9a a branch with its own proof passes" "$rc" "0"
  git -C "$repo" checkout --quiet main
  commit_file docs/main-moved.md
  git -C "$repo" checkout --quiet p-rb
  git -C "$repo" rebase --quiet main
  push --force origin p-rb; rc=$?
  check "P9b a rebase with identical inputs passes" "$rc" "0"
  git -C "$repo" checkout --quiet main
  commit_file APP/m.swift
  git -C "$repo" checkout --quiet p-rb
  git -C "$repo" rebase --quiet main
  push --force origin p-rb; rc=$?
  check "P9c a rebase onto changed inputs blocks" "$rc|$(hits 'differs from it in build or eval inputs')" "1|1"

  # Resource controls: private copies that drop the receipt call, or move it after the tip
  # deduplication; each must let through a push the real hook blocks.
  git -C "$repo" checkout --quiet p-docs
  corrupt_receipt
  if ! inject '    if receipt_record "$remote_ref" "$remote_sha" "$tip" "$tree"; then :; else blocked=$((blocked + 1)); fi' '    :'; then
    check "the no-receipt control copy was made" "no" "yes"
  else
    push origin p-docs:p-ctl1; rc=$?
    check "control: without the receipt call, P1's kind of push would pass" "$rc" "0"
  fi
  if ! awk '
    $0 == "    if receipt_record \"$remote_ref\" \"$remote_sha\" \"$tip\" \"$tree\"; then :; else blocked=$((blocked + 1)); fi" { n++; next }
    $0 == "    seen=\"$seen $tip\"" { print; print "    if receipt_record \"$remote_ref\" \"$remote_sha\" \"$tip\" \"$tree\"; then :; else blocked=$((blocked + 1)); fi"; n++; next }
    { print } END { exit (n == 2 ? 0 : 1) }' "$hook" > "$tmp/hooks/pre-push"; then
    check "the after-dedup control copy was made" "no" "yes"
  else
    commit_file docs/ctl2.md
    push origin p-docs:p-docs p-docs:p-ctl2; rc=$?
    check "control: deciding the receipt after deduplication lets P8's second ref through" "$rc" "0"
  fi
  cp "$hook" "$tmp/hooks/pre-push"
  make_receipt
  git -C "$repo" checkout --quiet main

  # 12. every run removed its own snapshots and temp directories
  check "no snapshot worktree is left registered" "$(git -C "$repo" worktree list | grep -c 'ew-pre-push' || true)" "0"
  check "no hook temp directory is left behind" "$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'ew-pre-push.*' | wc -l | tr -d ' ')" "$leftovers_before"

  rm -rf "$tmp"
  echo "self-test: $cases cases, $fails failure(s)"
  [ "$fails" -eq 0 ]
}

if [ "${1:-}" = "--self-test" ]; then
  self_test
  exit $?
fi
# bash 3.2 (macOS /bin/bash) also fires this trap INSIDE a `$( ... )` whose failure the code
# handles (`if x="$(cmd)"; then`), at a deeper BASH_SUBSHELL, where hook_fault would delete WORK
# while the hook runs on (#3524 PR 3: measured with a failing `git merge-tree` and `pgrep -P`).
# Deeper than the hook's own level, the trap only ends that sub-command with its status; a
# failure at the hook's level is still a hook fault.
HOOK_DEPTH="${BASH_SUBSHELL:-0}"
# shellcheck disable=SC2154 # ew_rc is assigned inside the trap text itself
trap 'ew_rc=$?; if [ "${BASH_SUBSHELL:-0}" -gt "$HOOK_DEPTH" ]; then exit "$ew_rc"; fi; hook_fault "unexpected error at line $LINENO"' ERR
trap on_signal INT TERM
main "$@"
