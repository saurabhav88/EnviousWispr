          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido actualizar “Tus palabras”, así que todavía no se pueden buscar coincidencias. Inténtalo de nuevo."
          }
        }
      }
    },
    "Your audio and text both stay on this Mac." : {
      "comment" : "Transcribe a File: the footer's privacy sentence: nothing leaves the Mac.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahme und dein Text bleiben auf diesem Mac."
