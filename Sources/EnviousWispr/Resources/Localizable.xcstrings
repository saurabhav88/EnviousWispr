        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes continuar con la configuración y reanudarla más adelante."
          }
        }
      }
    },
    "You can keep setting up while this runs." : {
      "comment" : "Setup Downloads subtitle: downloading.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mit der Einrichtung weitermachen, während das läuft."
          }
