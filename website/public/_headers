/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://us.i.posthog.com https://us-assets.i.posthog.com https://client.crisp.chat https://*.crisp.chat https://app.termly.io https://www.youtube.com https://www.youtube-nocookie.com https://static.cloudflareinsights.com; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://*.crisp.chat wss://*.crisp.chat https://api.github.com https://cloudflareinsights.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://client.crisp.chat https://app.termly.io; font-src 'self' data: https://client.crisp.chat; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://app.termly.io https://game.crisp.chat; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

# Root files are replaced in place under a fixed name (a new preview card, a
# new favicon). Without a rule Cloudflare served the old /og-image.png for a
# year and a manual purge was needed. One hour lets a replacement land on its
# own; hashed /_astro/* assets keep the year above.
/og-image.png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate

/icons/*
  Cache-Control: public, max-age=3600, must-revalidate

/llms.txt
  Cache-Control: public, max-age=3600, must-revalidate

/appcast.xml
  Cache-Control: public, max-age=60
  X-Robots-Tag: noindex

/blog-search.json
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=0, must-revalidate
