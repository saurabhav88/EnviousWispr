    "On-screen preview pauses while Faster Transcription works during recording." : {
      "comment" : "On-screen preview status. Faster Transcription is the name of a setting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildschirmvorschau pausiert, solange „Schnellere Transkription“ während der Aufnahme transkribiert."
