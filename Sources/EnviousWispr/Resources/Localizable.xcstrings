          }
        }
      }
    },
    "Audio is not uploaded. Dictation recordings are kept for 1 day unless you choose Keep this recording. Change this in Settings > Recordings." : {
      "comment" : "History help: where recordings are stored and for how long (1 day).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio wird nicht hochgeladen. Diktataufnahmen werden 1 Tag lang aufbewahrt, außer du wählst „Diese Aufnahme behalten“. Ändere das unter Einstellungen > Aufnahmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio n’est pas envoyé. Les enregistrements de dictée sont conservés pendant 1 jour, sauf si vous choisissez « Conserver cet enregistrement ». Modifiez ce réglage dans Réglages > Enregistrements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio no se envía a ningún servidor. Las grabaciones de dictado se conservan durante 1 día, a menos que elijas “Conservar esta grabación”. Puedes cambiar este plazo en Ajustes > Ajustes de la app > Grabaciones."
          }
        }
      }
    },
    "Audio is not uploaded. Dictation recordings are kept for 30 days unless you choose Keep this recording. Change this in Settings > Recordings." : {
      "comment" : "History help: where recordings are stored and for how long (30 days).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio wird nicht hochgeladen. Diktataufnahmen werden 30 Tage lang aufbewahrt, außer du wählst „Diese Aufnahme behalten“. Ändere das unter Einstellungen > Aufnahmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio n’est pas envoyé. Les enregistrements de dictée sont conservés pendant 30 jours, sauf si vous choisissez « Conserver cet enregistrement ». Modifiez ce réglage dans Réglages > Enregistrements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio no se envía a ningún servidor. Las grabaciones de dictado se conservan durante 30 días, a menos que elijas “Conservar esta grabación”. Puedes cambiar este plazo en Ajustes > Ajustes de la app > Grabaciones."
          }
        }
      }
    },
    "Audio is not uploaded. Dictation recordings are kept for 7 days unless you choose Keep this recording. Change this in Settings > Recordings." : {
