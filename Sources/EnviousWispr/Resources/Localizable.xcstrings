    "Ollama Cloud models could not be loaded. Check your connection and try again." : {},
    "Ollama Cloud models have not been loaded yet." : {},
    "Ollama is a free tool you install once. Models on your Mac need no API key and no per-use cost, and they keep your dictation on your Mac. Ollama also offers hosted models, which run on Ollama's servers. Those are listed separately below and are never selected for you. A hosted model needs you signed in to Ollama, and some of them need a paid Ollama plan." : {},
    "Ollama is installed but isn't running yet." : {},
    "Ollama listed this model but did not return a name EnviousWispr can add. Try again after updating Ollama." : {
      "comment" : "AI Polish, Ollama model list: adding a hosted model failed; no usable name came back for a hosted model."
    },
    "Ollama needs a language model to polish your text." : {},
    "Ollama returned two valid names for this model. Add it in Ollama, then refresh this list." : {
      "comment" : "AI Polish, Ollama model list: adding a hosted model failed; two names came back for a hosted model."
    },
    "Ollama runs AI models on your Mac. No API keys, completely free." : {},
    "Ollama's servers" : {
      "comment" : "Transcribe a File, Review step: where the cleanup runs."
