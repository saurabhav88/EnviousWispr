    "$rc|$live_snaps|$([ -n "$slow" ] && kill -0 "$slow" 2> /dev/null && echo running || echo stopped)|$(git -C "$repo" worktree list --porcelain | grep -c 'ew-pre-push')" \
    "130|2|stopped|0"
  [ -n "$slow" ] && kill "$slow" 2> /dev/null
  git -C "$repo" checkout --quiet main

  # R17. The checker past its deadline (it ignores TERM): COULD NOT RUN, promptly, stopped.
  git -C "$repo" checkout --quiet -b stubborn main
  printf '%s\n' '#!/usr/bin/env python3' '# "--trailers"' 'import os, signal, time' \
    'signal.signal(signal.SIGTERM, signal.SIG_IGN)' \
    'open(os.environ["SELFTEST_SLOW_PID"], "w").write(str(os.getpid()))' 'time.sleep(30)' > "$repo/scripts/ci/check-test-recipe.py"
  git -C "$repo" commit --quiet -am "a checker that ignores TERM"
  if ! inject 'RECIPE_SECONDS=15  # the recipe check reads GitHub, so the same network cap applies' 'RECIPE_SECONDS=1'; then
    check "the short-checker-deadline copy was made" "no" "yes"
  else
    rm -f "$tmp/slow.pid"
    started="$(date +%s)"
    SELFTEST_SLOW_PID="$tmp/slow.pid" rpush origin stubborn; rc=$?
    elapsed=$(($(date +%s) - started))
    slow="$(cat "$tmp/slow.pid" 2> /dev/null)"
    check "R17 a checker past its deadline is COULD NOT RUN, stopped by KILL, and returns promptly" \
      "$rc|$(grep -c 'the check took longer than 1 s' "$tmp/push.out")|$([ -n "$slow" ] && kill -0 "$slow" 2> /dev/null && echo running || echo stopped)|$([ "$elapsed" -lt 10 ] && echo prompt || echo "slow ${elapsed}s")" \
      "0|1|stopped|prompt"
    [ -n "$slow" ] && kill -KILL "$slow" 2> /dev/null
  fi
  cp "$hook" "$tmp/hooks/pre-push"
  git -C "$repo" checkout --quiet main

  # R18. A fetch mapping that does not write origin/main, and a stale origin/main: the hook
  # still judges against the freshly fetched tip.
  local fresh stale
  fresh="$(git -C "$remote" rev-parse refs/heads/main)"
  stale="$(git -C "$repo" rev-parse "$fresh~1")"
  git -C "$repo" config remote.origin.fetch "+refs/heads/main:refs/remotes/origin/elsewhere"
  git -C "$repo" update-ref refs/remotes/origin/main "$stale"
  git -C "$repo" checkout --quiet -b mapping main
  git -C "$repo" commit --quiet --allow-empty -m "mapping probe"
  rpush origin mapping; rc=$?
  check "R18 a custom fetch mapping and a stale origin/main still judge against the fresh tip" \
    "$rc|$(grep -c "merged with origin/main ${fresh:0:12}" "$tmp/push.out")|$(git -C "$repo" rev-parse refs/remotes/origin/main)" \
    "0|1|$fresh"
  git -C "$repo" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  git -C "$repo" checkout --quiet main

  # R19. Signing turned on with a signer that does not exist: the throwaway landing commit
  # is still made, and the repository's signing setting is left exactly as it was.
  git -C "$repo" checkout --quiet -b signing main
  git -C "$repo" commit --quiet --allow-empty -m "signing probe"
  git -C "$repo" config commit.gpgSign true
  git -C "$repo" config gpg.program "$tmp/no-such-signer"
  rpush origin signing; rc=$?
  check "R19 an unavailable signer does not stop the landing snapshot; signing config unchanged" \
    "$rc|$(grep -c 'recipe: .* merged with origin/main' "$tmp/push.out")|$(git -C "$repo" config --get commit.gpgSign)|$(git -C "$repo" config --get gpg.program)" \
    "0|1|true|$tmp/no-such-signer"
  git -C "$repo" config --unset commit.gpgSign
  git -C "$repo" config --unset gpg.program
  git -C "$repo" checkout --quiet main

  # 12. every run removed its own snapshots and temp directories
  check "no snapshot worktree is left registered" "$(git -C "$repo" worktree list | grep -c 'ew-pre-push' || true)" "0"
  check "no hook temp directory is left behind" "$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'ew-pre-push.*' | wc -l | tr -d ' ')" "$leftovers_before"

  rm -rf "$tmp"
  echo "self-test: $cases cases, $fails failure(s)"
  [ "$fails" -eq 0 ]
}

if [ "${1:-}" = "--self-test" ]; then
  self_test
  exit $?
fi
trap 'hook_fault "unexpected error at line $LINENO"' ERR
trap on_signal INT TERM
main "$@"
