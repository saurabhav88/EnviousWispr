    "whatsNew.say-slash-get-a-slash.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry say-slash-get-a-slash).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context-aware slash formatting: Spoken slash commands and shorthand now format intelligently, even with Spoken punctuation turned off."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrägstriche mit Blick auf den Zusammenhang: Gesprochene Slash-Befehle und Kurzschreibweisen werden jetzt passend formatiert, auch wenn gesprochene Satzzeichen ausgeschaltet sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise en forme intelligente des barres obliques : les commandes avec barre oblique et les formes abrégées dictées sont désormais mises en forme intelligemment, même lorsque la ponctuation dictée est désactivée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato de la barra según el contexto: los comandos de voz con barra y las abreviaturas que dictas ahora se formatean según el contexto, aunque Puntuación hablada esté desactivada."
          }
        }
      }
    },
    "whatsNew.say-slash-get-a-slash.bullet.0" : {
      "comment" : "Settings > What's New: point 1 of the list under one feature announcement (entry say-slash-get-a-slash).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commands and flags: \"slash clear\" becomes /clear, \"command is slash wfp\" becomes command is /wfp"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehle und Optionen: Aus „slash clear“ wird /clear, aus „command is slash wfp“ wird command is /wfp"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commandes et options : « slash clear » devient /clear, et « command is slash wfp » devient command is /wfp"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos y opciones: “slash clear” se convierte en /clear y “command is slash wfp” se convierte en command is /wfp"
          }
        }
      }
    },
    "whatsNew.say-slash-get-a-slash.bullet.1" : {
      "comment" : "Settings > What's New: point 2 of the list under one feature announcement (entry say-slash-get-a-slash).",
