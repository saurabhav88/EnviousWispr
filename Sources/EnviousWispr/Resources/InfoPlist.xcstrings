{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "macOS permission prompt (NSAppleEventsUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr uses AppleScript to paste your dictated text into the active app when direct insertion is not available, and to pause Music or Spotify while you dictate if you choose that setting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr verwendet AppleScript, um deinen diktierten Text in die aktive App einzufügen, wenn das direkte Einfügen nicht möglich ist, und um Musik oder Spotify während des Diktierens anzuhalten, wenn du diese Einstellung wählst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr utilise AppleScript pour coller votre texte dicté dans l’app active lorsque l’insertion directe n’est pas disponible, et pour mettre en pause Musique ou Spotify pendant que vous dictez si vous choisissez ce réglage."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription" : {
      "comment" : "macOS permission prompt (NSAudioCaptureUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr records the sound your Mac plays, such as the other people on a call, only while you record a meeting. The recording stays on your Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr nimmt den Ton auf, den dein Mac abspielt, zum Beispiel die Stimmen anderer Personen bei einem Anruf, aber nur, während du ein Meeting aufnimmst. Die Aufnahme bleibt auf deinem Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr enregistre le son lu par votre Mac, comme celui des autres participants à un appel, uniquement pendant l’enregistrement d’une réunion. L’enregistrement reste sur votre Mac."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "macOS permission prompt (NSCalendarsFullAccessUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr reads the calendar event at the time a meeting starts to name the meeting and note who was invited. It never changes your calendar. What it saves stays with the meeting on your Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr liest den Kalendertermin zur Startzeit eines Meetings, um das Meeting zu benennen und festzuhalten, wer eingeladen war. Es ändert deinen Kalender nie. Was es speichert, bleibt beim Meeting auf deinem Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr lit l’événement du calendrier au moment où une réunion commence pour nommer la réunion et noter les personnes invitées. Il ne modifie jamais votre calendrier. Les données enregistrées restent associées à la réunion sur votre Mac."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "macOS permission prompt (NSContactsUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr reads the names in your contacts so dictation can spell the people you know correctly. Your address book is never uploaded."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr liest die Namen deiner Kontakte, damit die Namen von Menschen, die du kennst, beim Diktieren richtig geschrieben werden. Dein Adressbuch wird nie hochgeladen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr lit les noms de vos contacts afin que la dictée écrive correctement le nom des personnes que vous connaissez. Votre carnet d’adresses n’est jamais envoyé."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "About box: the copyright line. Legal text: keep the company name and the years exactly.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2025–2026 Envious Labs LLC. All rights reserved."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2025–2026 Envious Labs LLC. Alle Rechte vorbehalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2025–2026 Envious Labs LLC. Tous droits réservés."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "macOS permission prompt (NSMicrophoneUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr needs microphone access for speech-to-text dictation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr benötigt Zugriff auf dein Mikrofon, um deine Sprache in Text umzuwandeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr a besoin d’accéder au micro pour convertir la parole en texte lors de la dictée."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "macOS permission prompt (NSSpeechRecognitionUsageDescription), shown when the app first asks for this access. Say exactly what the app does with it, no more and no less.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr uses on-device speech recognition to show your words in the recording pill while you speak. This preview stays on your Mac and is never the text that gets pasted."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr verwendet die Spracherkennung auf dem Gerät, um deine Worte beim Sprechen in der Aufnahmeanzeige anzuzeigen. Diese Vorschau bleibt auf deinem Mac und ist nie der Text, der eingefügt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr utilise la reconnaissance vocale sur votre Mac pour afficher vos mots dans la pastille d’enregistrement pendant que vous parlez. Cet aperçu reste sur votre Mac et n’est jamais utilisé comme texte à coller."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
