    "You are responsible for telling people and getting their consent where the law requires it. Envious Labs is not responsible for recordings you make without consent." : {
      "comment" : "EnviousMeet consent text, paragraph 2.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist dafür verantwortlich, andere zu informieren und ihre Zustimmung einzuholen, wo das Gesetz es verlangt. Envious Labs ist nicht verantwortlich für Aufnahmen, die du ohne Zustimmung machst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vous incombe d’informer les personnes concernées et d’obtenir leur consentement lorsque la loi l’exige. Envious Labs n’est pas responsable des enregistrements que vous réalisez sans consentement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eres responsable de informar a las personas y obtener su consentimiento cuando la ley lo exija. Envious Labs no se hace responsable de las grabaciones que hagas sin consentimiento."
          }
        }
      }
    },
    "You can change the key any time in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst die Taste jederzeit in den Einstellungen ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiable à tout moment dans les Réglages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar la tecla en cualquier momento en Ajustes."
          }
        }
      }
    },
    "You can change this later in EnviousMeet settings." : {
      "comment" : "EnviousMeet setup: under a skipped permission or choice.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das später in den EnviousMeet-Einstellungen ändern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez modifier ce choix ultérieurement dans les réglages d’EnviousMeet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiarlo más adelante en los ajustes de EnviousMeet."
          }
        }
      }
    },
    "You can keep dictating while %@ downloads." : {
      "comment" : "AI Polish, local model: while the model downloads. %@ is the model name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst weiter diktieren, während %@ heruntergeladen wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez continuer à dicter pendant le téléchargement de %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes seguir dictando mientras se descarga %@."
          }
        }
      }
    },
    "You can keep dictating while EnviousMeet records." : {
      "comment" : "EnviousMeet: while a meeting records.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst weiter diktieren, während EnviousMeet aufnimmt."
