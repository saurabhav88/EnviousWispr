      }
    },
    "This keybind starts and stops recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Tastenkürzel startet und stoppt die Aufnahme."
          }
        }
      }
    },
    "This looks like %@, which you already have." : {
      "comment" : "Your Words, import review: a row's note. %@ is the existing word.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht aus wie %@, das du bereits hast."
          }
        }
      }
    },
    "This matches more than one word you already have." : {
      "comment" : "Your Words, import review: a row's note.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das passt zu mehreren Wörtern, die du bereits hast."
          }
        }
      }
    },
    "This may take a moment on first run while the model loads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Start kann das Laden des Modells einen Moment dauern."
