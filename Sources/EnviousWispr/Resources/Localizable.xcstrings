    "whatsNew.versions-ips-codes-whole.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry versions-ips-codes-whole).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smarter technical and developer formatting: Technical patterns, network addresses, and standard data types now convert directly into clean, written notation instead of spelled-out words."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Formatierung für Technik und Entwicklung: Technische Muster, Netzwerkadressen und gängige Datenformate erscheinen jetzt direkt in sauberer Schreibweise statt als ausgeschriebene Wörter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise en forme technique et destinée aux développeurs améliorée : les éléments techniques, les adresses réseau et les types de données standard sont désormais convertis directement dans une notation écrite claire, au lieu d’être transcrits en toutes lettres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor formato para texto técnico y de programación: la app convierte los patrones técnicos, las direcciones de red y los tipos de datos estándar directamente a su notación habitual, en vez de escribirlos con palabras."
          }
        }
      }
    },
