    "AI cleanup is paused until %@ V%@ finishes installing." : {
      "comment" : "Settings > AI Polish, local model row: an upgrade must finish. The first %@ is the model name, the second its version.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AI cleanup is paused until %1$@ V%2$@ finishes installing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Nachbearbeitung pausiert, bis %1$@ V%2$@ installiert ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Retouche IA est suspendue jusqu’à la fin de l’installation de %1$@ V%2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Pulido con IA está en pausa hasta que termine de instalarse %1$@ V%2$@."
          }
        }
      }
    },
    "AI cleanup is paused until the new %@ finishes installing." : {
      "comment" : "Settings > AI Polish, local model row: an upgrade must finish. %@ is the model name; the version is unknown.",
      "localizations" : {
        "de" : {
