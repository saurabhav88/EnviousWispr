---
// Make it yours (#2816): the recording pill in its three designs, the full
// start and stop sound library, and any key as the record key.
import FeatureShell from '../layouts/FeatureShell.astro';
import FeatureHero from '../components/features/FeatureHero.astro';
import PillShowcase from '../components/features/PillShowcase.astro';
import SoundSamples from '../components/features/SoundSamples.astro';
import KeyPicker from '../components/features/KeyPicker.astro';
import DownloadClosing from '../components/DownloadClosing.astro';
import '../styles/features/customization.css';
---

<FeatureShell
  path="/customization/"
  activePage="customization"
  title="Make it yours: keybinds, sounds and the recording pill"
  description="Pick your record key, choose from twelve start and stop sounds, and decide how the recording pill looks and where it sits. Small settings, big comfort."
>
  <FeatureHero
    kind="customization"
    label="Make it yours"
    title={'Make dictation<br><span class="accent-ink">feel like yours.</span>'}
    copy="Choose how dictation looks, sounds and fits into your habits. A small recording view. Familiar shortcuts. A chime that tells you it’s time to speak."
  >
    <PillShowcase />
  </FeatureHero>

  <section class="sound-story wrap">
    <div class="sound-copy">
      <span class="eyebrow">A little reassurance</span>
      <h2>Hear when it starts.<br />Know when it’s done.</h2>
      <p>A short sound when recording starts, and another when it stops, so you know it heard you without looking up. Twelve pairings, from barely there to a clear glint. Pick the one you like, or keep it quiet.</p>
      <small>Whisper Tick plays unless you change it. Switch sounds off in Settings, Sounds.</small>
    </div>
    <SoundSamples />
  </section>

  <section class="shortcuts-story wrap">
    <KeyPicker />
    <div class="shortcuts-copy">
      <span class="eyebrow">Your key, your call</span>
      <h2>Any key can be<br />your record key.</h2>
      <p>A key on its own, a key with modifiers, or the Globe key. Pick the one your hand already rests on, hold it, and talk. Tap a key to see it take the job.</p>
      <small>The right Option key is the default. Change it in Settings, Keybinds. Cancel (Escape) and Add a word (Control Shift W) have keybinds of their own on the same page.</small>
    </div>
  </section>

  <DownloadClosing title="Make dictation feel like yours." />
</FeatureShell>
