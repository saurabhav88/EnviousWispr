  # the directory it ran in and answers the label and recipe reads; the real checker and
  # validator judge a landing tree large enough for the validator's oracle floors.
  local fakebin="$tmp/fakebin" ghlog="$tmp/gh-cwd.log" body="$tmp/issue-body.md"
  local r_dup r_fix base_main started elapsed sleepy sleepy_child bystander
  mkdir -p "$fakebin"
