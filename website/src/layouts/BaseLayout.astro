---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import CompareTableMobile from '../components/CompareTableMobile.astro';
import '../styles/global.css';

import SiteHead from '../components/SiteHead.astro';
import SiteServices from '../components/SiteServices.astro';
import type {ComponentProps} from 'astro/types';
type Props = ComponentProps<typeof SiteHead>;
const { activePage = 'home' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="dot-grid" aria-hidden="true"></div>
    <Nav activePage={activePage} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollReveal />
    <CompareTableMobile />
    <SiteServices />
  </body>
</html>
