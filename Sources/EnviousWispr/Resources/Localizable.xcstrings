    "whatsNew.better-error-logging.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry better-error-logging).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved our error logging so we can spot issues and enhance your experience faster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben die Fehlerprotokollierung verbessert, damit wir Probleme schneller erkennen und die App verbessern können."
          }
        }
      }
    },
    "whatsNew.welcome-to-2-0.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry welcome-to-2-0).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to EnviousWispr 2.0"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei EnviousWispr 2.0"
          }
        }
      }
    },
    "whatsNew.welcome-to-2-0.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry welcome-to-2-0).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr 2.0 is about trust. Better text on the first try, sharper memory for your words, and fewer moments where you have to step in."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei EnviousWispr 2.0 geht es um Vertrauen: besserer Text beim ersten Versuch, ein besseres Gedächtnis für deine Wörter und weniger Situationen, in denen du eingreifen musst."
          }
        }
      }
    },
    "whatsNew.your-words-has-a-real-home.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry your-words-has-a-real-home).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Your Words\" has a real home now"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Deine Wörter“ haben jetzt einen festen Platz"
          }
        }
      }
    },
    "whatsNew.your-words-has-a-real-home.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry your-words-has-a-real-home).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learning, Vocab Packs, and Custom Terms each have their own section in Settings. Easier to see what EnviousWispr remembers, what you added yourself, and where to tune it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernen, Wortschatzpakete und eigene Begriffe haben jeweils einen eigenen Bereich in den Einstellungen. So siehst du leichter, was EnviousWispr gelernt hat, was du selbst hinzugefügt hast und wo du es anpassen kannst."
          }
        }
      }
    },
    "whatsNew.afm-dual-mode-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry afm-dual-mode-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence keeps your voice and your precision"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence bewahrt deinen Stil und deine Genauigkeit"
          }
        }
      }
    },
    "whatsNew.afm-dual-mode-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry afm-dual-mode-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device polish keeps your voice and your precision. Casual notes keep your tone. Code, jargon, and careful business writing keep their precision. Six months of tuning underpins this."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachbearbeitung auf dem Gerät bewahrt deinen Stil und deine Genauigkeit. Lockere Notizen bleiben locker. Code, Fachbegriffe und sorgfältig formulierte Geschäftstexte bleiben präzise. Dahinter stehen sechs Monate Feinarbeit."
          }
        }
      }
    },
    "whatsNew.custom-terms-survive-on-device-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry custom-terms-survive-on-device-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your custom terms now survive on-device polish"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Begriffe bleiben bei der Nachbearbeitung auf dem Gerät erhalten"
          }
        }
      }
    },
    "whatsNew.custom-terms-survive-on-device-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry custom-terms-survive-on-device-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Words you teach EnviousWispr now carry through to Apple Intelligence polish, not just cloud polish. Product names, client names, and domain terms are far less likely to get cleaned into the wrong thing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter, die du EnviousWispr beibringst, bleiben jetzt auch bei der Nachbearbeitung mit Apple Intelligence erhalten, nicht nur in der Cloud. Produktnamen, Kundennamen und Fachbegriffe werden dadurch seltener fälschlich verändert."
          }
        }
      }
    },
    "whatsNew.less-fiddling-better-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry less-fiddling-better-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less fiddling, better polished text"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Einstellungen, besserer Text"
          }
        }
      }
    },
    "whatsNew.less-fiddling-better-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry less-fiddling-better-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formal, Standard, and Friendly are gone. They rarely changed the result and could quietly bypass smart routing on Apple Intelligence. There is now one quality-tuned default that delivers more consistently."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Formell“, „Standard“ und „Freundlich“ entfallen. Sie änderten das Ergebnis selten und konnten die intelligente Auswahl bei Apple Intelligence unbemerkt umgehen. Stattdessen gibt es jetzt eine einzige, auf Qualität abgestimmte Standardeinstellung mit gleichmäßigeren Ergebnissen."
          }
        }
      }
    },
    "whatsNew.pick-polish-model-faster.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry pick-polish-model-faster).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the right polish model faster"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneller das passende Modell zur Nachbearbeitung finden"
          }
        }
      }
    },
    "whatsNew.pick-polish-model-faster.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry pick-polish-model-faster).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polish models are now grouped by provider with a short note on what each one is good at. Less hunting, better choices."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle zur Nachbearbeitung sind jetzt nach Anbieter gruppiert. Eine kurze Erklärung zeigt, wofür jedes Modell gut geeignet ist. So findest du leichter das passende."
          }
        }
      }
    },
    "whatsNew.smarter-new-word-suggestions.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smarter-new-word-suggestions).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding a new word is smarter now"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Wörter intelligenter hinzufügen"
          }
        }
      }
    },
    "whatsNew.smarter-new-word-suggestions.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry smarter-new-word-suggestions).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you add a custom term, EnviousWispr suggests likely spellings and pronunciations to catch. Repetitive or low-quality suggestions are filtered out more aggressively."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen eigenen Begriff hinzufügst, schlägt EnviousWispr mögliche Schreibweisen und Aussprachen vor, die erkannt werden sollen. Wiederholte oder wenig hilfreiche Vorschläge werden stärker herausgefiltert."
          }
        }
      }
    },
    "whatsNew.cleaner-transcription-before-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry cleaner-transcription-before-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cleaner transcription before polish"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauberere Transkription vor der Nachbearbeitung"
          }
        }
      }
    },
    "whatsNew.cleaner-transcription-before-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry cleaner-transcription-before-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The speech engine is now faster and steadier, especially on longer recordings. Fewer odd substitutions and cleaner raw text before polish even runs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracherkennung ist jetzt schneller und stabiler, besonders bei längeren Aufnahmen. Schon vor der Nachbearbeitung gibt es weniger seltsame Ersetzungen und saubereren Rohtext."
          }
        }
      }
    },
    "whatsNew.no-more-phantom-thank-you.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry no-more-phantom-thank-you).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more phantom \"Thank you\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein erfundenes „Danke“ mehr"
          }
        }
      }
    },
    "whatsNew.no-more-phantom-thank-you.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry no-more-phantom-thank-you).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silent endings used to occasionally produce a fake \"Thank you.\" That hallucination is now suppressed at the source."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein stilles Ende konnte gelegentlich ein nie gesprochenes „Danke“ erzeugen. Diese falsche Ausgabe wird jetzt direkt an der Quelle unterdrückt."
          }
        }
      }
    },
    "whatsNew.first-word-stays.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry first-word-stays).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first word stays in the transcript"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein erstes Wort bleibt im Transkript"
          }
        }
      }
    },
    "whatsNew.first-word-stays.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry first-word-stays).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The opening word of a recording could sometimes disappear. Fixed. Dictation now starts where you start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manchmal verschwand das erste Wort einer Aufnahme. Das ist behoben. Das Diktat beginnt jetzt dort, wo du anfängst."
          }
        }
      }
    },
    "whatsNew.auto-language-actually-works.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry auto-language-actually-works).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto language detection actually works"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Spracherkennung funktioniert jetzt richtig"
          }
        }
      }
    },
    "whatsNew.auto-language-actually-works.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry auto-language-actually-works).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave language on Auto and EnviousWispr will detect what you spoke instead of assuming English. Short clips also decide faster, so quick commands feel snappier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Sprache auf „Automatisch“ lässt, erkennt EnviousWispr jetzt deine gesprochene Sprache, statt Englisch anzunehmen. Bei kurzen Aufnahmen fällt die Entscheidung zudem schneller, sodass kurze Befehle flotter wirken."
          }
        }
      }
    },
    "whatsNew.stuck-model-loads-recover-sooner.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry stuck-model-loads-recover-sooner).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuck model loads recover sooner"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hängende Ladevorgänge von Modellen werden schneller behoben"
          }
        }
      }
    },
    "whatsNew.stuck-model-loads-recover-sooner.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry stuck-model-loads-recover-sooner).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a speech model gets wedged while loading, EnviousWispr now notices earlier and recovers without the long wait. Slow but healthy loads are left alone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt ein Sprachmodell beim Laden hängen, erkennt EnviousWispr das jetzt früher und stellt den Betrieb ohne langes Warten wieder her. Langsame, aber funktionierende Ladevorgänge laufen weiter."
          }
        }
      }
    },
    "whatsNew.custom-words-fast-at-scale.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry custom-words-fast-at-scale).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom Words stays fast at scale"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Wörter bleiben auch bei großen Listen schnell"
          }
        }
      }
    },
    "whatsNew.custom-words-fast-at-scale.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry custom-words-fast-at-scale).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even very large custom-word lists now stay responsive during polish. Long replacements that used to get dropped now apply correctly, and a failed save no longer throws away what you typed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachbearbeitung bleibt selbst bei sehr großen Listen eigener Wörter schnell. Lange Ersetzungen, die früher verloren gingen, werden richtig angewendet. Schlägt das Speichern fehl, bleibt deine Eingabe erhalten."
          }
        }
      }
    },
    "whatsNew.auto-paste-clear-help.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry auto-paste-clear-help).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear help when auto-paste needs access"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klare Hilfe, wenn automatisches Einfügen Zugriff braucht"
          }
        }
      }
    },
    "whatsNew.auto-paste-clear-help.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry auto-paste-clear-help).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Accessibility permission is missing, EnviousWispr now tells you exactly why paste could not happen and gives you a quick path to fix it. No more silent fallback to the clipboard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlt die Berechtigung für Bedienungshilfen, erklärt EnviousWispr jetzt genau, warum das Einfügen nicht möglich war, und zeigt dir den Weg zur Lösung. Die App weicht nicht mehr stillschweigend auf die Zwischenablage aus."
          }
        }
      }
    },
    "whatsNew.update-when-ready.title" : {
