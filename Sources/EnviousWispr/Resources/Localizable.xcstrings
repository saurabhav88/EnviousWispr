        }
      }
    },
    "Speaker names changed after this summary was written." : {
      "comment" : "History, a meeting: a speaker was renamed after the AI summary was written.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprechernamen wurden geändert, nachdem diese Zusammenfassung erstellt wurde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms des intervenants ont changé après la rédaction de ce résumé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de los participantes han cambiado después de crear este resumen."
          }
        }
      }
    },
    "Speaker names need Accessibility, which was off when this meeting was recorded. Names can't be added to this meeting now, but you can still rename each speaker. Allow Accessibility before your next call." : {
      "comment" : "History: a meeting recorded without the Accessibility permission, so no participant names were read from the call app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Sprechernamen ist der Zugriff auf die Bedienungshilfen nötig. Er war bei der Aufnahme dieses Meetings deaktiviert. Diesem Meeting können jetzt keine Namen mehr hinzugefügt werden, aber du kannst jeden Sprecher weiterhin umbenennen. Erlaube den Zugriff auf die Bedienungshilfen vor deinem nächsten Anruf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms des intervenants nécessitent l’autorisation d’Accessibilité, qui était désactivée lors de l’enregistrement de cette réunion. Il n’est plus possible d’ajouter des noms à cette réunion, mais vous pouvez toujours renommer chaque intervenant. Activez l’autorisation d’Accessibilité avant votre prochain appel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr no tenía permiso de Accesibilidad cuando se grabó esta reunión, así que no puede añadir los nombres automáticamente. Aun así, puedes cambiar el nombre de cada participante. Concede el permiso de Accesibilidad antes de tu próxima llamada."
          }
        }
      }
    },
    "Speakers found" : {
