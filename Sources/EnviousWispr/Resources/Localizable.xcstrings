    "whatsNew.export-words-backup.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry export-words-backup).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your whole vocabulary to a file. Useful for a backup, for moving to a new Mac, or for sharing a set of words with someone else."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deinen gesamten Wortschatz in einer Datei – als Sicherung, für einen neuen Mac oder um Wörter mit jemandem zu teilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez tout votre vocabulaire dans un fichier. Pratique pour créer une sauvegarde, passer à un nouveau Mac ou partager un ensemble de mots avec quelqu’un."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todo tu vocabulario en un archivo. Es útil para crear una copia de seguridad, cambiar a un Mac nuevo o compartir un conjunto de palabras con otra persona."
          }
        }
      }
    },
    "whatsNew.claude-cloud-polish-provider.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry claude-cloud-polish-provider).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude joins OpenAI and Gemini for cloud polish"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ergänzt OpenAI und Gemini bei der Cloud-Nachbearbeitung"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude rejoint OpenAI et Gemini pour la retouche dans le cloud"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude se suma a OpenAI y Gemini para el Pulido en la nube"
