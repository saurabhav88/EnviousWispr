    "whatsNew.introducing-enviousmeet.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry introducing-enviousmeet).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing \"EnviousMeet\" (Beta)"
          }
        },
        "de" : {
