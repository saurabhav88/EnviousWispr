    "On device" : {
      "comment" : "Transcribe a File, Polish step: the line under an engine's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Gerät"
          }
        },
        "fr" : {
