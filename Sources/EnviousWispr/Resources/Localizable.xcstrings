          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app dans laquelle vous étiez a été fermée. Il n’y avait donc plus rien à lire. Vous pouvez tout de même ajouter le mot manuellement ci-dessous."
