    "whatsNew.addresses-links-codes-in-four-languages.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry addresses-links-codes-in-four-languages).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localized spoken formatting: With your dictation language set to French, Spanish, Polish, Dutch, German, Russian, Portuguese or Italian, spoken URLs, emails and technical codes now come out written."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesprochene Formatierung in deiner Sprache: Wenn deine Diktiersprache auf Französisch, Spanisch, Polnisch, Niederländisch, Deutsch, Russisch, Portugiesisch oder Italienisch eingestellt ist, werden gesprochene Webadressen, E-Mail-Adressen und technische Codes jetzt richtig geschrieben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mise en forme des éléments dictés selon la langue : lorsque votre langue de dictée est le français, l’espagnol, le polonais, le néerlandais, l’allemand, le russe, le portugais ou l’italien, les URL, adresses e-mail et codes techniques dictés sont désormais transcrits dans leur forme écrite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formato según el idioma de dictado. Si seleccionas francés, español, polaco, neerlandés, alemán, ruso, portugués o italiano como idioma de dictado, las direcciones web, las direcciones de correo electrónico y los códigos técnicos que dictas ahora aparecen en su formato escrito."
          }
        }
      }
    },
