    "whatsNew.no-clipped-last-words.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry no-clipped-last-words).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We fixed a case where a quick, energetic word or two at the very end of a dictation could get trimmed off. Your full sentence now makes it through."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein oder zwei kurze, betonte Wörter am Ende eines Diktats konnten bisher abgeschnitten werden. Jetzt kommt der ganze Satz an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons corrigé un problème qui pouvait couper un ou deux mots rapides et énergiques à la toute fin d’une dictée. Votre phrase complète est maintenant transcrite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregimos un problema que podía cortar una o dos palabras al final del dictado si las decías rápido y con énfasis. Ahora se transcribe la frase completa."
          }
        }
      }
    },
    "whatsNew.paste-never-waits-on-history.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-never-waits-on-history).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasting never waits on saving"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einfügen wartet nicht mehr auf das Speichern"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage n’attend jamais la sauvegarde"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto se pega sin esperar a que se guarde"
          }
        }
      }
    },
    "whatsNew.paste-never-waits-on-history.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-never-waits-on-history).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if saving a dictation to your History runs into a snag, your words still land where you are typing. Delivery no longer waits on the archive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst wenn das Speichern eines Diktats im Verlauf scheitert, erscheint dein Text an der Eingabestelle. Das Einfügen wartet nicht mehr auf die Archivierung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même si l’enregistrement d’une dictée dans votre Historique rencontre un problème, vos mots s’insèrent quand même à l’endroit où vous saisissez du texte. Le collage n’attend plus l’archivage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque haya un problema al guardar un dictado en el Historial, el texto se pega donde estabas escribiendo. El pegado ya no espera a que se guarde el dictado."
          }
        }
      }
    },
    "whatsNew.voiceover-and-keyboard.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry voiceover-and-keyboard).",
