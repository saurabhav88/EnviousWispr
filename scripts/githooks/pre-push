  echo "branch side" > "$repo/README"; add_test_lines Conflict.swift 101
  git -C "$repo" add -A; git -C "$repo" commit --quiet -m "conflicting change"
  git -C "$repo" checkout --quiet main
  echo "main side" > "$repo/README"; git -C "$repo" commit --quiet -am "main side"
  rpush origin main
  rpush origin conflict; rc=$?
  check "R13 a conflict with origin/main is COULD NOT RUN: warns and allows" \
    "$rc|$(grep -c 'conflicts with origin/main' "$tmp/push.out")" "0|1"

  git -C "$repo" checkout --quiet rec
  FAKE_GH_FAIL=1 rpush origin rec:rec5; rc=$?
  check "R14 the checker's own could-not-run (exit 3) warns and allows" \
    "$rc|$(grep -c 'recipe-check::could not run' "$tmp/push.out")|$(grep -c 'OK with 1 warning' "$tmp/push.out")" "0|1|1"

