    "whatsNew.undo-after-escape.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry undo-after-escape).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo after Escape now pastes your words into the field you were in, or copies them to your clipboard if it can't paste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Rückgängig“ nach Escape fügt deine Wörter jetzt in das Feld ein, in dem du warst, oder kopiert sie in die Zwischenablage, wenn das Einfügen nicht möglich ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir appuyé sur Échap, Annuler colle désormais vos mots dans le champ où vous étiez, ou les copie dans le presse-papiers si le collage est impossible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshacer después de pulsar Esc ahora pega tus palabras en el campo en el que estabas o las copia en el portapapeles si no puede pegarlas."
          }
        }
      }
    },
    "whatsNew.privacy-controls.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry privacy-controls).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy controls"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutzeinstellungen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôles de confidentialité"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controles de privacidad"
          }
        }
      }
    },
    "whatsNew.privacy-controls.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry privacy-controls).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing \"Privacy controls\". Choose whether to share usage metrics and crash reports in Settings > Permissions. Crash report changes apply after a restart. When sending feedback, choose whether to attach diagnostics and preview the file first."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu: „Datenschutzeinstellungen“. Unter Einstellungen > Berechtigungen legst du fest, ob du Nutzungsstatistiken teilst und Absturzberichte sendest. Änderungen an der Einstellung für Absturzberichte werden nach einem Neustart wirksam. Beim Senden von Feedback entscheidest du, ob Diagnosedaten angehängt werden, und kannst die Datei vorher ansehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez les « Contrôles de confidentialité ». Dans Réglages > Autorisations, choisissez de partager ou non les statistiques d’utilisation et les rapports de plantage. Les modifications concernant les rapports de plantage prennent effet après un redémarrage. Lorsque vous envoyez des commentaires, choisissez de joindre ou non les données de diagnostic et affichez d’abord le fichier en aperçu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presentamos “Controles de privacidad”. En Ajustes > Permisos, elige si quieres compartir métricas de uso e informes de cierres inesperados. Los cambios en el envío de informes se aplican después de reiniciar la app. Al enviar comentarios, elige si quieres adjuntar datos de diagnóstico y revisa la vista previa del archivo antes de enviarlo."
          }
        }
      }
    },
    "whatsNew.word-check-memory.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry word-check-memory).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word check loads on demand"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wortprüfung wird bei Bedarf geladen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification des mots se charge à la demande"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comprobación de palabras se carga cuando es necesaria"
          }
        }
      }
    },
    "whatsNew.word-check-memory.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry word-check-memory).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envious Word Check now loads on demand instead of loading when EnviousWispr starts. It normally leaves memory after about 10 minutes without use; a dictation or file transcription still using it can keep it longer. EG-1 and S1-mini dictations use their own word checks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envious Word Check wird jetzt bei Bedarf geladen und nicht mehr beim Start von EnviousWispr. Normalerweise wird er nach etwa 10 Minuten ohne Nutzung wieder aus dem Arbeitsspeicher entfernt. Wenn ein Diktat oder eine Dateitranskription ihn noch nutzt, bleibt er länger im Arbeitsspeicher. Diktate mit EG-1 und S1-mini verwenden ihre eigene Wortprüfung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envious Word Check se charge désormais à la demande, plutôt qu’au démarrage d’EnviousWispr. En général, il est retiré de la mémoire après environ 10 minutes sans utilisation ; une dictée ou une transcription de fichier qui l’utilise encore peut le maintenir en mémoire plus longtemps. Les dictées avec EG-1 et S1-mini utilisent leur propre vérification des mots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envious Word Check ahora se carga solo cuando hace falta, en lugar de hacerlo al abrir EnviousWispr. Normalmente se descarga de la memoria después de unos 10 minutos sin uso, pero sigue disponible si un dictado o una transcripción de archivo aún lo necesita. Los dictados con EG-1 y S1-mini usan sus propios sistemas de comprobación de palabras."
          }
        }
      }
    },
