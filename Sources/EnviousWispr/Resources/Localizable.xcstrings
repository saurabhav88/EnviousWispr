    "whatsNew.auto-paste-clear-help.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry auto-paste-clear-help).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Accessibility permission is missing, EnviousWispr now tells you exactly why paste could not happen and gives you a quick path to fix it. No more silent fallback to the clipboard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlt die Berechtigung für Bedienungshilfen, erklärt EnviousWispr jetzt genau, warum das Einfügen nicht möglich war, und zeigt dir den Weg zur Lösung. Die App weicht nicht mehr stillschweigend auf die Zwischenablage aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’autorisation d’Accessibilité est manquante, EnviousWispr vous indique désormais exactement pourquoi le collage n’a pas pu être effectué et vous permet de résoudre rapidement le problème. Le recours silencieux au presse-papiers appartient au passé."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si falta el permiso de Accesibilidad, EnviousWispr te explica exactamente por qué no se ha podido pegar el texto y te ofrece una forma rápida de solucionarlo. Ya no se usa el portapapeles como alternativa sin avisar."
          }
        }
      }
    },
