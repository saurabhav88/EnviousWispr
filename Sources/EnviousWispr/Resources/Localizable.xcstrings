          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufnahme wurde aus dem Verlauf entfernt."
          }
        }
      }
    },
    "This usually takes a moment. Nothing else is needed from you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das dauert normalerweise nur einen Moment. Du musst nichts weiter tun."
