    "whatsNew.whisper-new-engine.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry whisper-new-engine).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper now runs on a new engine built for Apple Silicon. In our tests it made about 13% fewer errors, transcribed long recordings more than twice as fast, and stayed steady through a full day of dictation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper läuft jetzt auf einer neuen Engine für Apple Silicon. In unseren Tests machte es rund 13 % weniger Fehler, transkribierte lange Aufnahmen mehr als doppelt so schnell und blieb einen ganzen Tag lang beim Diktieren stabil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper utilise désormais un nouveau moteur conçu pour Apple Silicon. Lors de nos tests, il a produit environ 13 % d’erreurs en moins, transcrit les longs enregistrements plus de deux fois plus vite et est resté stable pendant toute une journée de dictée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whisper ahora funciona con un motor nuevo diseñado para Apple Silicon. En nuestras pruebas cometió aproximadamente un 13 % menos de errores, transcribió grabaciones largas más del doble de rápido y mantuvo un rendimiento estable durante todo un día de dictado."
          }
        }
      }
    },
    "whatsNew.hold-plus-space.title" : {
