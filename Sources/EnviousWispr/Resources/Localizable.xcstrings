          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si deux copies d’EnviousWispr étaient ouvertes en même temps, vos mots personnalisés pouvaient être affectés. Ce cas est désormais correctement géré."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
