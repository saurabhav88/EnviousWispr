        }
      }
    },
    "A snippet only fires when you say this word first. Say the trigger on its own and your dictation is left alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Textbaustein wird nur eingefügt, wenn du dieses Wort zuerst sagst. Sagst du das Auslösewort allein, bleibt dein Diktat unverändert."
          }
        }
      }
    },
