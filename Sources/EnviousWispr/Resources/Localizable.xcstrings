      }
    },
    "Say \"<phrase> emoji\" to get the glyph. Bare words never convert." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „<Ausdruck> Emoji“, um das Symbol einzufügen. Ohne „Emoji“ werden Wörter nicht umgewandelt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « <phrase> emoji » pour obtenir le symbole. Les mots seuls ne sont jamais convertis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “<frase> emoji” para obtener el símbolo. Las palabras solas nunca se convierten."
          }
        }
      }
    },
    "Say a phrase followed by emoji to get its symbol." : {
      "comment" : "Speech engine settings: short line under the spoken emoji row.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
