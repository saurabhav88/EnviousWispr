    "whatsNew.hour-long-recordings.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry hour-long-recordings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can now record for up to a full hour in one go. As you near the limit you get a gentle heads-up, and recording stops cleanly on its own so you never lose what you said."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jetzt bis zu einer vollen Stunde am Stück aufnehmen. Kurz vor dem Limit erhältst du einen dezenten Hinweis. Die Aufnahme endet dann automatisch und sauber, damit nichts Gesagtes verloren geht."
          }
        }
      }
    },
    "whatsNew.sharper-on-device-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry sharper-on-device-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharper on-device polish"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Nachbearbeitung direkt auf dem Gerät"
          }
        }
      }
    },
    "whatsNew.sharper-on-device-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry sharper-on-device-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The built-in, fully on-device polish got a real tune-up. It cleans up filler and phrasing more reliably, keeps the natural way you start a sentence, and leaves your wording alone when it should."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die integrierte Nachbearbeitung auf dem Gerät wurde verbessert. Sie entfernt Füllwörter und holprige Formulierungen zuverlässiger, bewahrt natürliche Satzanfänge und lässt deine Wortwahl in Ruhe, wenn keine Änderung nötig ist."
          }
        }
      }
    },
    "whatsNew.emoji-stay-put.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry emoji-stay-put).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your emoji stay put"
