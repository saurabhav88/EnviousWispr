  check "precondition: main with the anchored file pushes" "$rc" "0"
  git -C "$repo" checkout --quiet rec
  : > "$ghlog"
  rpush origin rec; rc=$?
  check "R5 the landing tree carries main-only changes: the same commit now passes" \
    "$rc|$(git -C "$repo" cat-file -e "$r_fix:Sources/Thing.swift" 2> /dev/null && echo has || echo lacks)|$(grep -c '1/1 rows runnable' "$tmp/push.out")" "0|lacks|1"
  check "R6 every GitHub lookup ran in the repository" "$(sort -u "$ghlog" | tr '\n' ' ')" "$repo "

  git -C "$repo" checkout --quiet main
  echo "let guarded = maybe" > "$repo/Sources/Thing.swift"
  git -C "$repo" commit --quiet -am "main: anchor moves"
  rpush origin main
  git -C "$repo" checkout --quiet rec
  rpush origin rec:rec2; rc=$?
  check "R7 the same commit blocks once main has moved its anchor" "$rc|$(grep -c 'row 1: UNRUNNABLE' "$tmp/push.out")" "1|1"
  git -C "$repo" checkout --quiet main
  echo "let guarded = true" > "$repo/Sources/Thing.swift"
  git -C "$repo" commit --quiet -am "main: anchor back"
  rpush origin main
  git -C "$repo" checkout --quiet rec

  git -C "$repo" branch rec-old "$r_dup"
  rpush origin rec-old; rc=$?
  check "R8 a non-HEAD branch is judged on its own range" "$rc|$(grep -c 'carries 2 of them' "$tmp/push.out")" "1|1"

  add_test_lines Dirty.swift 500; echo "// dirty" >> "$repo/Tests/Probe/New.swift"
  rpush origin rec:rec3; rc=$?
  check "R9 uncommitted and untracked test lines in the pushing checkout change nothing" "$rc" "0"
  rm -f "$repo/Tests/Probe/Dirty.swift"; git -C "$repo" checkout --quiet -- Tests/Probe/New.swift

