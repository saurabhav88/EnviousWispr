    "whatsNew.welcome-to-2-0.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry welcome-to-2-0).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr 2.0 is about trust. Better text on the first try, sharper memory for your words, and fewer moments where you have to step in."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei EnviousWispr 2.0 geht es um Vertrauen: besserer Text beim ersten Versuch, ein besseres Gedächtnis für deine Wörter und weniger Situationen, in denen du eingreifen musst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr 2.0 mise sur la confiance. Un meilleur texte dès le premier essai, une mémoire plus précise pour vos mots et moins de situations où vous devez intervenir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con EnviousWispr 2.0 puedes confiar más en el dictado: el texto sale mejor a la primera, la app recuerda mejor tus palabras y tú tienes que intervenir menos."
          }
        }
      }
    },
    "whatsNew.your-words-has-a-real-home.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry your-words-has-a-real-home).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Your Words\" has a real home now"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Deine Wörter“ haben jetzt einen festen Platz"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Vos mots » ont désormais leur place"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tus palabras” tiene ahora su propio espacio"
          }
        }
      }
    },
    "whatsNew.your-words-has-a-real-home.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry your-words-has-a-real-home).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learning, Vocab Packs, and Custom Terms each have their own section in Settings. Easier to see what EnviousWispr remembers, what you added yourself, and where to tune it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernen, Wortschatzpakete und eigene Begriffe haben jeweils einen eigenen Bereich in den Einstellungen. So siehst du leichter, was EnviousWispr gelernt hat, was du selbst hinzugefügt hast und wo du es anpassen kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’apprentissage, les lexiques et les termes personnalisés disposent désormais chacun de leur propre section dans les Réglages. Voyez plus facilement ce dont EnviousWispr se souvient, ce que vous avez ajouté vous-même et où ajuster ces éléments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprendizaje, Vocabularios y Términos personalizados tienen ahora su propia sección en Ajustes. Así es más fácil ver qué recuerda EnviousWispr, qué has añadido tú y dónde puedes ajustarlo."
          }
        }
      }
    },
    "whatsNew.afm-dual-mode-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry afm-dual-mode-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence keeps your voice and your precision"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence bewahrt deinen Stil und deine Genauigkeit"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence préserve votre voix et votre précision"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence conserva tu voz y tu precisión"
          }
        }
      }
    },
    "whatsNew.afm-dual-mode-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry afm-dual-mode-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device polish keeps your voice and your precision. Casual notes keep your tone. Code, jargon, and careful business writing keep their precision. Six months of tuning underpins this."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Nachbearbeitung auf dem Gerät bewahrt deinen Stil und deine Genauigkeit. Lockere Notizen bleiben locker. Code, Fachbegriffe und sorgfältig formulierte Geschäftstexte bleiben präzise. Dahinter stehen sechs Monate Feinarbeit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retouche sur l’appareil préserve votre voix et votre précision. Vos notes informelles gardent leur ton. Le code, le jargon et les textes professionnels soigneusement rédigés gardent leur précision. Six mois de réglages précis sont à l’origine de ces améliorations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Pulido en el dispositivo conserva tu voz y tu precisión. Las notas informales mantienen tu tono. El código, la jerga y los textos profesionales más cuidados conservan su precisión. Seis meses de ajustes respaldan este resultado."
          }
        }
      }
    },
    "whatsNew.custom-terms-survive-on-device-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry custom-terms-survive-on-device-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your custom terms now survive on-device polish"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Begriffe bleiben bei der Nachbearbeitung auf dem Gerät erhalten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos termes personnalisés résistent désormais à la retouche sur l’appareil"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus términos personalizados se conservan con el Pulido en el dispositivo"
          }
        }
      }
    },
    "whatsNew.custom-terms-survive-on-device-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry custom-terms-survive-on-device-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Words you teach EnviousWispr now carry through to Apple Intelligence polish, not just cloud polish. Product names, client names, and domain terms are far less likely to get cleaned into the wrong thing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wörter, die du EnviousWispr beibringst, bleiben jetzt auch bei der Nachbearbeitung mit Apple Intelligence erhalten, nicht nur in der Cloud. Produktnamen, Kundennamen und Fachbegriffe werden dadurch seltener fälschlich verändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots que vous apprenez à EnviousWispr sont désormais pris en compte par la retouche Apple Intelligence, et pas seulement par la retouche dans le cloud. Les noms de produits, de clients et les termes propres à votre domaine risquent bien moins d’être transformés à tort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras que enseñas a EnviousWispr ahora se respetan también en el Pulido con Apple Intelligence, no solo en el Pulido en la nube. Así es menos probable que la app cambie por error nombres de productos o clientes y términos de tu especialidad."
          }
        }
      }
    },
    "whatsNew.less-fiddling-better-polish.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry less-fiddling-better-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less fiddling, better polished text"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger Einstellungen, besserer Text"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de réglages, une meilleure retouche"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos ajustes, mejor texto pulido"
          }
        }
      }
    },
    "whatsNew.less-fiddling-better-polish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry less-fiddling-better-polish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formal, Standard, and Friendly are gone. They rarely changed the result and could quietly bypass smart routing on Apple Intelligence. There is now one quality-tuned default that delivers more consistently."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Formell“, „Standard“ und „Freundlich“ entfallen. Sie änderten das Ergebnis selten und konnten die intelligente Auswahl bei Apple Intelligence unbemerkt umgehen. Stattdessen gibt es jetzt eine einzige, auf Qualität abgestimmte Standardeinstellung mit gleichmäßigeren Ergebnissen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les options « Formelle », « Standard » et « Amicale » ont disparu. Elles modifiaient rarement le résultat et pouvaient contourner discrètement le routage intelligent d’Apple Intelligence. Une seule option par défaut, réglée pour la qualité, offre désormais des résultats plus homogènes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formal, Estándar y Amistoso han desaparecido. Rara vez cambiaban el resultado y podían omitir silenciosamente el enrutamiento inteligente de Apple Intelligence. Ahora hay un único ajuste predeterminado optimizado para la calidad, que ofrece resultados más uniformes."
          }
        }
      }
    },
    "whatsNew.pick-polish-model-faster.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry pick-polish-model-faster).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the right polish model faster"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneller das passende Modell zur Nachbearbeitung finden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir plus vite le modèle de retouche adapté"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige más rápido el modelo de Pulido adecuado"
          }
        }
      }
    },
    "whatsNew.pick-polish-model-faster.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry pick-polish-model-faster).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polish models are now grouped by provider with a short note on what each one is good at. Less hunting, better choices."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle zur Nachbearbeitung sind jetzt nach Anbieter gruppiert. Eine kurze Erklärung zeigt, wofür jedes Modell gut geeignet ist. So findest du leichter das passende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles de retouche sont désormais regroupés par fournisseur, avec une brève description de leurs points forts. Cherchez moins, choisissez mieux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora los modelos de Pulido están agrupados por proveedor e incluyen una breve nota sobre sus puntos fuertes. Menos búsquedas y mejores opciones."
          }
        }
      }
    },
    "whatsNew.smarter-new-word-suggestions.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smarter-new-word-suggestions).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding a new word is smarter now"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Wörter intelligenter hinzufügen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter un mot est désormais plus simple"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejores sugerencias al añadir una palabra"
          }
        }
      }
