    "whatsNew.stuck-model-loads-recover-sooner.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry stuck-model-loads-recover-sooner).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a speech model gets wedged while loading, EnviousWispr now notices earlier and recovers without the long wait. Slow but healthy loads are left alone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt ein Sprachmodell beim Laden hängen, erkennt EnviousWispr das jetzt früher und stellt den Betrieb ohne langes Warten wieder her. Langsame, aber funktionierende Ladevorgänge laufen weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un modèle vocal reste bloqué pendant son chargement, EnviousWispr le détecte désormais plus tôt et rétablit son fonctionnement sans longue attente. Les chargements lents, mais qui fonctionnent correctement, sont laissés en cours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un modelo de voz se bloquea mientras se carga, EnviousWispr lo detecta y lo soluciona antes. Si la carga sigue avanzando, la app no la interrumpe aunque tarde más de lo normal."
          }
        }
      }
    },
