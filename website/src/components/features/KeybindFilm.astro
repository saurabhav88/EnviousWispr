---
// Make it second nature: a looping film of the default record key doing its
// two jobs, hold to talk and tap twice for hands-free. The pill frames are the
// app's own capsule rendered at 2x, one per clock second, so the timer really
// counts. Driven by scripts/features/keybind-film.js; static without it.
import clock0 from '../../assets/features/mac-scene/capsule-clock-0.png';
import clock1 from '../../assets/features/mac-scene/capsule-clock-1.png';
import clock2 from '../../assets/features/mac-scene/capsule-clock-2.png';
import clock3 from '../../assets/features/mac-scene/capsule-clock-3.png';
import clock4 from '../../assets/features/mac-scene/capsule-clock-4.png';
import clock5 from '../../assets/features/mac-scene/capsule-clock-5.png';
import clock6 from '../../assets/features/mac-scene/capsule-clock-6.png';
import handsfree from '../../assets/features/mac-scene/pill-classic-handsfree.png';

const frames = [clock0, clock1, clock2, clock3, clock4, clock5, clock6];
const scenes = [
  { key: 'hold', name: 'Hold to talk' },
  { key: 'handsfree', name: 'Hands-free' },
];
// The bottom row of a MacBook keyboard, left to right, with relative widths.
const keys = [
  { label: '', glyph: 'fn', w: 1 },
  { label: 'control', glyph: '⌃', w: 1 },
  { label: 'option', glyph: '⌥', w: 1 },
  { label: 'command', glyph: '⌘', w: 1.25 },
  { label: '', glyph: '', w: 5.4, space: true },
  { label: 'command', glyph: '⌘', w: 1.25 },
  { label: 'option', glyph: '⌥', w: 1, record: true },
];
---

<div class="keybind-film" data-keybind-film data-scene="hold" data-key="up" data-pill="hidden" data-frame="0">
  <div class="kf-scenes" role="group" aria-label="Which part of the story to show">
    {
      scenes.map((s, i) => (
        <button type="button" class:list={{ selected: i === 0 }} data-kf-scene={s.key} aria-pressed={i === 0 ? 'true' : 'false'} disabled data-enables>
          {s.name}
        </button>
      ))
    }
  </div>

  <div class="kf-stage">
    <div class="kf-doc" aria-hidden="true">
      <span class="kf-doc-rule">Reply to Priya</span>
      <p><span data-kf-text>The two bigger ones need a proper rewrite, so I will have the next version over by Thursday.</span><i class="kf-caret"></i></p>
    </div>

    <div class="kf-air">
      <span class="kf-glow" aria-hidden="true"></span>
      <div class="kf-pill" aria-hidden="true">
        {frames.map((f, i) => <img src={f.src} alt="" width="370" height="88" data-kf-frame={i} loading="lazy" decoding="async" />)}
        <img src={handsfree.src} alt="" width="370" height="88" data-kf-frame="handsfree" loading="lazy" decoding="async" />
      </div>
      <span class="kf-done" aria-hidden="true">Pasted</span>
    </div>

    <div class="kf-keyboard" aria-hidden="true">
      {
        keys.map((k) => (
          <span class:list={['kf-key', { space: k.space, record: k.record }]} style={`--w:${k.w}`} data-kf-record={k.record ? '' : undefined}>
            {k.glyph ? <b>{k.glyph}</b> : null}
            {k.label ? <small>{k.label}</small> : null}
          </span>
        ))
      }
      <span class="kf-key arrow" style="--w:1"><b>◀</b></span>
      <span class="kf-key arrow stack" style="--w:1"><b>▲</b><b>▼</b></span>
      <span class="kf-key arrow" style="--w:1"><b>▶</b></span>
    </div>
  </div>

  <p class="kf-caption" data-kf-caption aria-live="polite">Hold the right Option key and talk. Let go, and your words land where your cursor was.</p>
</div>
