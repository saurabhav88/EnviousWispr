    "whatsNew.say-slash-get-a-slash.bullet.2" : {
      "comment" : "Settings > What's New: point 3 of the list under one feature announcement (entry say-slash-get-a-slash).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idiomatic phrases: Stays as words in contexts like \"slash the budget\" (though verbs like \"slash prices\" may still resolve to a symbol)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redewendungen: Bleiben Text, etwa „slash the budget“ (Verben wie „slash prices“ können trotzdem zum Zeichen werden)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expressions idiomatiques : elles restent sous forme de mots dans des contextes comme « slash the budget » (même si des verbes comme « slash prices » peuvent toujours être convertis en symbole)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expresiones idiomáticas: en frases como “slash the budget”, “slash” se conserva como palabra, aunque en otras, como “slash prices”, aún puede convertirse en el símbolo “/”."
          }
        }
      }
    },
    "whatsNew.say-slash-get-a-slash.bullet.3" : {
      "comment" : "Settings > What's New: point 4 of the list under one feature announcement (entry say-slash-get-a-slash).",
