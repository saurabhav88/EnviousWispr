<!-- Download click tracking with source attribution -->
<script>
  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href*="EnviousWispr.dmg"]');
    if (!link || typeof window.posthog === 'undefined') return;
    const source =
      link.dataset.downloadSource ||
      (link.closest('nav') && 'nav') ||
      (link.closest('.hero-section') && 'hero') ||
      (link.closest('.cta-section') && 'bottom-cta') ||
      (link.closest('footer') && 'footer') ||
      (link.closest('.blog-cta') && 'blog-post') ||
      'unknown';
    window.posthog.capture('download_clicked', {
      source: source,
      page: window.location.pathname,
    });
  });
</script>
