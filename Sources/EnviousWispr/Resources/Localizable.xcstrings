    "whatsNew.newer-ai-polish-models.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry newer-ai-polish-models).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Polish now works with the latest models. We recommend Gemini 3.5 Flash, or OpenAI 5.4 mini or nano, for the best balance of speed and quality."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Nachbearbeitung unterstützt jetzt die neuesten Modelle. Für ein gutes Verhältnis von Tempo und Qualität empfehlen wir Gemini 3.5 Flash oder OpenAI 5.4 mini beziehungsweise nano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Retouche IA fonctionne maintenant avec les modèles les plus récents. Nous recommandons Gemini 3.5 Flash, ou OpenAI 5.4 mini ou nano, pour un équilibre optimal entre rapidité et qualité."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Pulido con IA ya funciona con los modelos más recientes. Para lograr el mejor equilibrio entre velocidad y calidad, recomendamos Gemini 3.5 Flash u OpenAI 5.4 mini o nano."
          }
        }
      }
    },
