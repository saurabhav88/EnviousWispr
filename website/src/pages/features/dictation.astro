---
// AI Polished Dictation (#2816): benchmark results first, then what was
// tested and graded, then why it performs. Copy from the mock's page_content.py.
import FeatureShell from '../../layouts/FeatureShell.astro';
import FeatureHero from '../../components/features/FeatureHero.astro';
import BenchmarkBox from '../../components/features/BenchmarkBox.astro';
import FeatureFilm from '../../components/features/FeatureFilm.astro';
import DownloadCta from '../../components/features/DownloadCta.astro';
import { highlights, benchmarkRecordUrl } from '../../data/features/benchmark.js';
const steps = [
  ['Define good writing.', 'Write the policy for meaning, voice and structure before creating answer keys.'],
  ['Bring speech into it.', 'Speak realistic scenarios with TTS, then transcribe them with a real recognizer.'],
  ['Check the answer keys.', 'Two authors work independently. Resolve disagreements and exclude undecidable cases.'],
  ['Grade consistently.', 'Use the same judge and rubric for every model, with an adjudication pass.'],
];
---

<FeatureShell
  path="/features/dictation/"
  title="AI polished dictation on Mac, with benchmark results"
  description="Speak naturally and paste finished text. See the benchmark results, what was tested and graded, and why on-device polish reads well. Free on Apple Silicon."
>
  <FeatureHero
    variant="centred"
    kind="dictation"
    label="AI Polished Dictation"
    title="Tuned for better dictation.<br><span class=&quot;accent-ink&quot;>The results are here.</span>"
    copy="Better writing takes careful work. Here’s how our local polish models performed, what we graded, and the decisions behind the results."
  />
  <section class="benchmark-section wrap">
    <div class="evidence-highlights">
      {
        highlights.map((h) => (
          <div>
            <span>{h.label}</span>
            <strong>{h.value}</strong>
            <small>{h.note}</small>
          </div>
        ))
      }
    </div>
    <div class="section-top">
      <div><span class="eyebrow">How we stack up</span><h2>The details make<br />the difference.</h2></div>
      <p>Explore the strengths and tradeoffs of each model. This is our archived English text-polish comparison, not a test of complete dictation apps.</p>
    </div>
    <BenchmarkBox />
  </section>
  <div class="band">
    <section class="section wrap">
      <div class="section-top">
        <div><span class="eyebrow">What went into the test</span><h2>Built around the way<br />people actually speak.</h2></div>
        <p>Corrections. Unfinished thoughts. Spoken lists. The test checks more than whether a sentence looks tidy.</p>
      </div>
      <div class="test-story">
        {
          steps.map(([title, copy], i) => (
            <div>
              <span>{i + 1}</span>
              <h3>{title}</h3>
              <p>{copy}</p>
            </div>
          ))
        }
      </div>
      <details class="methodology">
        <summary>Explore the benchmark methodology <span>+</span></summary>
        <div>
          <p>The exam was sealed August 15, 2026. It contains 1,462 English cases across 11 categories; 11 undecidable cases were excluded. Initial answer-author agreement was 77.94%.</p>
          <p>The August 26 run used an Apple M5 Max with 64 GB memory and macOS 26. GPT-5.6-luna graded the model outputs with the same rubric. Pass rates include pass and minor; serious errors are reported separately.</p>
          <p>Envious Labs builds EG-1 and selected this test. Model grading has uncertainty. Fluid-1’s production instructions and custom decoder were not replicated, so this is not its official app performance.</p>
          <a class="text-link" href={benchmarkRecordUrl}>Read the benchmark details ↗</a>
        </div>
      </details>
    </section>
  </div>
  <section class="benefit wrap">
    <div class="benefit-copy">
      <span class="eyebrow">Why it performs</span>
      <h2>More care for<br />what you meant.</h2>
      <p>We tune for the hard parts of spoken writing: keeping your voice, resolving corrections, and creating structure only where it belongs. We test those changes against the same written standards.</p>
    </div>
    <div class="benefit-visual"><FeatureFilm kind="correction" /></div>
  </section>
  <DownloadCta title="Try it with your own words." />
</FeatureShell>
