        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicta los signos de puntuación para insertarlos."
          }
        }
      }
    },
    "Say punctuation out loud to insert it. EnviousWispr removes extra marks the speech engine adds next to the ones you say." : {
      "comment" : "Speech engine settings, spoken punctuation: description under the toggle.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich Satzzeichen aus, um sie einzufügen. EnviousWispr entfernt zusätzliche Satzzeichen, die die Spracherkennung direkt neben die von dir gesprochenen setzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites les signes de ponctuation à voix haute pour les insérer. EnviousWispr supprime les signes supplémentaires ajoutés par le moteur de reconnaissance vocale à côté de ceux que vous avez prononcés."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di los signos de puntuación en voz alta para insertarlos. EnviousWispr elimina los signos adicionales que el motor de voz añade junto a los que dices."
          }
        }
      }
    },
    "Say this first, then your trigger. One word." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag zuerst dieses Wort, dann deinen Auslöser. Ein Wort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites d’abord ceci, puis votre déclencheur. Un seul mot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di esto primero y luego tu activador. Una palabra."
          }
        }
      }
    },
    "Say you are recording when the call starts." : {
      "comment" : "EnviousMeet setup: consent row line under Ask first.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag zu Beginn des Anrufs, dass du aufnimmst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites que vous enregistrez au début de l’appel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di que estás grabando cuando empiece la llamada."
