    "whatsNew.enviouswispr-in-spanish.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry enviouswispr-in-spanish).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Español in Settings > App Settings > Appearance > Language, then relaunch to apply. System default follows your Mac's language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige “Español” en Ajustes > Ajustes de la app > Aspecto > Idioma y vuelve a abrir la app para aplicar el cambio. “Predeterminado del sistema” usa el idioma de tu Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Español“ unter Einstellungen > App-Einstellungen > Erscheinungsbild > Sprache und starte die App dann neu. „Systemstandard“ folgt der Sprache deines Macs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Español » dans Réglages > Réglages de l’app > Apparence > Langue, puis redémarrez l’app pour appliquer le changement. « Par défaut du système » suit la langue de votre Mac."
          }
        }
      }
    },
    "whatsNew.brand-new-history-tab-experience.title" : {
