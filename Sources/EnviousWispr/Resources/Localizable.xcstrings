    "whatsNew.bluetooth-usb-audio-support.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry bluetooth-usb-audio-support).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr now properly supports Bluetooth and USB microphones, including on Mac mini. We also rebuilt the entire infrastructure around our sound capture engine to be far more robust, so recording no longer fails quietly when a microphone misbehaves."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr unterstützt Bluetooth- und USB-Mikrofone jetzt richtig, auch auf dem Mac mini. Zudem haben wir die Audioaufnahme robuster gemacht, damit Aufnahmen bei Problemen mit dem Mikrofon nicht mehr unbemerkt scheitern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr prend désormais correctement en charge les microphones Bluetooth et USB, y compris sur Mac mini. Nous avons également entièrement repensé l’infrastructure de capture audio pour la rendre beaucoup plus fiable : l’enregistrement n’échoue plus discrètement lorsqu’un microphone rencontre un problème."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ahora es totalmente compatible con micrófonos Bluetooth y USB, también en el Mac mini. Además, hemos reconstruido toda la infraestructura del motor de captura de sonido para hacerla mucho más resistente, de modo que las grabaciones ya no fallen silenciosamente cuando un micrófono da problemas."
          }
        }
      }
    },
