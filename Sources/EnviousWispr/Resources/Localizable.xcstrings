    "whatsNew.ai-polish-keys-in-keychain.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry ai-polish-keys-in-keychain).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your API keys for AI Polish are now stored in your Mac's keychain, the same secure place your other passwords live. Existing keys were moved over automatically."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine API-Schlüssel für die KI-Nachbearbeitung werden jetzt im Schlüsselbund deines Mac gespeichert, zusammen mit deinen anderen Passwörtern. Vorhandene Schlüssel wurden automatisch übertragen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos clés API pour la Retouche IA sont maintenant stockées dans le trousseau de votre Mac, au même endroit sécurisé que vos autres mots de passe. Les clés existantes ont été transférées automatiquement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus claves de API para Pulido con IA se guardan ahora en el llavero de tu Mac, el mismo lugar seguro donde se almacenan tus otras contraseñas. Las claves existentes se trasladaron automáticamente."
          }
        }
      }
    },
