        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire insuffisante pour le moment. Fermez quelques apps ou choisissez une taille plus petite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cabe ahora mismo. Cierra algunas apps o elige un tamaño menor."
