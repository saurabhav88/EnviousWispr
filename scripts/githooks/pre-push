      "$([ -n "$sleepy" ] && [ -n "$sleepy_child" ] && echo listed || echo missing)|$(kill -0 "$sleepy" 2> /dev/null && echo running || echo stopped)|$(kill -0 "$sleepy_child" 2> /dev/null && echo running || echo stopped)|$(kill -0 "$bystander" 2> /dev/null && echo running || echo stopped)" \
      "listed|stopped|stopped|running"
