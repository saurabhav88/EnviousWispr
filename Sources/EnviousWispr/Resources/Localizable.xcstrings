          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de %@ todavía no se ha guardado."
          }
        }
      }
    },
    "Your API key" : {
      "comment" : "AI Polish provider list: description under a provider name. A cloud provider on the user's own key.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein API-Schlüssel"
          }
        },
        "fr" : {
