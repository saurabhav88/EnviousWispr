---
// The lips mark. Geometry and palette are the same eighteen rectangles the
// approved features mock reads from data/lips-mascot.json (#2816).
//
// `animate` adds the header-lips classes and a per-rectangle delay so the
// shared header can move the bars with a CSS keyframe (site-header.css) that
// reproduces the mock's scaleY(1 + 0.24·sin(t/190 + i·0.7)) at a 1194 ms
// period. Default rendering stays static.
interface Props {
  animate?: boolean;
  class?: string;
}
const { animate = false, class: className } = Astro.props;
const geometry = [
  [16, 84.2, 14, 20, 0],
  [40, 65.75, 14, 32, 1],
  [64, 43.36, 14, 48, 2],
  [88, 63.04, 14, 36, 3],
  [112, 81.43, 14, 24, 4],
  [136, 63.04, 14, 36, 5],
  [160, 43.36, 14, 48, 6],
  [184, 65.75, 14, 32, 7],
  [208, 84.2, 14, 20, 8],
  [16, 125.8, 14, 20, 7],
  [40, 119.35, 14, 36, 6],
  [64, 112.96, 14, 48, 5],
  [88, 120.64, 14, 60, 4],
  [112, 127.03, 14, 68, 3],
  [136, 120.64, 14, 60, 2],
  [160, 112.96, 14, 48, 1],
  [184, 119.35, 14, 36, 0],
  [208, 125.8, 14, 20, 8],
];
const colors = [
  '#ff2a40',
  '#ff8c00',
  '#ffd700',
  '#adff2f',
  '#00fa9a',
  '#00ffff',
  '#1e90ff',
  '#4169e1',
  '#8a2be2',
];
// 0.7 rad of a 2π·190 ms period is 133 ms per bar.
const delayMs = 133;
---

<svg
  viewBox="0 0 256 256"
  aria-hidden="true"
  focusable="false"
  class:list={[className, { 'header-lips': animate }]}
  ><g transform="translate(8,13)"
    >{
      geometry.map((v, i) => (
        <rect
          x={v[0]}
          y={v[1]}
          width={v[2]}
          height={v[3]}
          rx="5"
          fill={colors[v[4]]}
          class={animate ? (i < 9 ? 'lip-upper' : 'lip-lower') : undefined}
          style={animate ? `--lip-delay:-${i * delayMs}ms` : undefined}
        />
      ))
    }</g
  ></svg
>
