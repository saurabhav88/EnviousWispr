        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de API"
          }
        }
      }
    },
    "Your Globe key is set as your dictation keybind either way. This only stops macOS doing its own thing at the same time." : {
      "comment" : "Globe key tip (a popover after choosing the Globe key as the keybind): closing reassurance.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Globus-Taste bleibt in jedem Fall dein Tastenkürzel zum Diktieren. Dies verhindert nur, dass macOS gleichzeitig eine eigene Aktion ausführt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre touche Globe reste votre raccourci de dictée dans tous les cas. Cela empêche simplement macOS d’effectuer sa propre action en même temps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cualquier caso, la tecla Globo seguirá siendo tu atajo para dictar. Esto solo evita que macOS ejecute su propia acción al pulsarla."
          }
        }
      }
    },
    "Your Mac is almost out of space. Free up space to record a meeting." : {
      "comment" : "EnviousMeet: not enough disk space to start.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac hat fast keinen Speicherplatz mehr. Gib Speicherplatz frei, um ein Meeting aufzunehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne reste presque plus d’espace sur votre Mac. Libérez de la place pour enregistrer une réunion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac se está quedando sin espacio. Libera espacio para grabar una reunión."
          }
