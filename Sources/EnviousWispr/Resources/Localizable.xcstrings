    "whatsNew.spoken-emoji.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry spoken-emoji).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the emoji's name followed by the word \"emoji\" while you dictate, like \"smiley face emoji\" or \"thumbs up emoji\", and EnviousWispr drops the glyph right in."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag beim Diktieren den Namen eines Emoji und danach „Emoji“, etwa „lachendes Gesicht Emoji“ oder „Daumen hoch Emoji“. EnviousWispr fügt das Zeichen direkt ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant votre dictée, dites le nom de l’emoji suivi du mot « emoji », comme « visage souriant emoji » ou « pouce levé emoji », et EnviousWispr insère directement le symbole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras dictas, di el nombre del emoji seguido de la palabra “emoji”. Por ejemplo, en inglés, di “smiley face emoji” o “thumbs up emoji”. EnviousWispr insertará el símbolo directamente."
          }
        }
      }
    },
    "whatsNew.smart-language-detection.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry smart-language-detection).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smarter language detection"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelligentere Spracherkennung"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détection des langues plus intelligente"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detección de idiomas más inteligente"
          }
        }
      }
