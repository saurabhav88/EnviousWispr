    "Tip: you can turn off call prompts for some apps in EnviousMeet settings." : {
      "comment" : "EnviousMeet: shown once after the first No to Record this call?",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: In den EnviousMeet-Einstellungen kannst du die Nachfrage bei Anrufen für einzelne Apps ausschalten."
          }
        },
        "fr" : {
          "stringUnit" : {
