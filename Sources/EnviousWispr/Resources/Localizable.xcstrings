          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela représente plus de %@ mots, soit plus qu’EnviousWispr ne peut en importer à la fois. Essayez de coller un lot plus petit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto supera el límite de %@ palabras por importación. Prueba a pegar menos palabras."
          }
        }
      }
    },
    "That's more than %@ words. Paste a smaller batch." : {
