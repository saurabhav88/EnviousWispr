    "Press once to start recording. Press again to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal drücken, um die Aufnahme zu starten. Noch einmal drücken, um sie zu stoppen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez une fois pour démarrer l’enregistrement. Appuyez à nouveau pour l’arrêter."
          }
        },
