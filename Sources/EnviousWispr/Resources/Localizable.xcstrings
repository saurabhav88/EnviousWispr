    "Hold %@ and say the line below.\nLet go when you are done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %@ gedrückt und sprich den Satz unten.\nLass los, wenn du fertig bist."
