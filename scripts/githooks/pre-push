  [ -n "$slow_child" ] && kill "$slow_child" 2> /dev/null
  git -C "$repo" reset --quiet --hard HEAD~1

  # 13. a snapshot that cannot be removed after a verdict is kept and named, never left
  #     dangling; it warns without changing the verdict: a passing push goes through and a
  #     failing one still blocks
  local kept outcome
  if ! inject '  local snap="$1"' '  local snap="$1"; return 1'; then
    check "the cleanup-failure copy was made" "no" "yes"
  else
    for outcome in pass fail; do
      if [ "$outcome" = fail ]; then touch "$repo/BROKEN"; fi
      echo "f13$outcome" > "$repo/f13"; git -C "$repo" add -A; git -C "$repo" commit --quiet -m "f13 $outcome"
      push origin main; rc=$?
      kept="$(sed -n 's/.*kept \(.*ew-pre-push\.[A-Za-z0-9]*\).*/\1/p' "$tmp/push.out" | head -1)"
      check "a cleanup failure on a $outcome verdict warns, keeps the verdict, names what it kept" \
        "$rc|$(grep -c 'WARNING: could not remove snapshot' "$tmp/push.out")|$(grep -c 'not your code' "$tmp/push.out")|$([ -n "$kept" ] && [ -d "$kept" ] && echo kept || echo missing)" \
        "$([ "$outcome" = pass ] && echo 0 || echo 1)|1|1|kept"
