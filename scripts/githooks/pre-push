    push origin main; rc=$?
    kept="$(sed -n 's/.*kept \(.*ew-pre-push\.[A-Za-z0-9]*\).*/\1/p' "$tmp/push.out" | head -1)"
    local admin_entries
    admin_entries="$(find "$repo/.git/worktrees" -mindepth 1 -maxdepth 1 -type d 2> /dev/null | wc -l | tr -d ' ')"
    check "an unreadable gitdir blocks, keeps the snapshot's admin entry, and names the failure" \
      "$rc|$(grep -c 'Cleanup also failed: could not remove snapshot' "$tmp/push.out")|$admin_entries|$([ -n "$kept" ] && [ -d "$kept" ] && echo kept || echo missing)" \
      "1|1|1|kept"
