---
import { renderHost } from '../../utils/home/app-shell.js';
import { renderDraft } from '../../utils/home/text.js';
const { app, context = {}, text, hero = false, lang = 'en', focusable = false } = Astro.props;
const draft =
  '<div class="host-draft-slot"><div class="' +
  (hero ? 'hero-draft' : 'illustrated-result') +
  '" lang="' +
  lang +
  '">' +
  renderDraft(text) +
  '</div></div>';
const host = renderHost(app, context).replace('<div class="host-draft-slot"></div>', draft);
// renderHost already names each preview after its app; a second aria-label would win and hide it.
const accessibleHost = focusable
  ? host.replace('class="host-app', 'tabindex="0" role="region" class="host-app')
  : host;
---

<Fragment
  set:html={accessibleHost}
/>
