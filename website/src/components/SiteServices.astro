  // counts (workers/shared/download-intent.js). The PostHog snippet installs
  // a queueing stub synchronously, so a click before the library arrives is
  // still recorded once it does.
  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href^="/download"]');
    if (!link) return;
    if (typeof window.posthog === 'undefined') loadPostHog();
    const source =
      link.dataset.downloadSource ||
      (link.closest('nav') && 'nav') ||
      (link.closest('.hero-section') && 'hero') ||
