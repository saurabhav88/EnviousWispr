---
import { render } from "astro:content";
import { getPublishedPosts } from "../../utils/posts";
import { presentPost } from "../../utils/blog-presentation";
import BlogPost from "../../layouts/BlogPost.astro";
export async function getStaticPaths() {
  return (await getPublishedPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await getPublishedPosts())
  .filter((candidate) => candidate.id !== post.id)
  .map((candidate) => ({
    post: candidate,
    overlap: candidate.data.tags.filter((tag) => post.data.tags.includes(tag))
      .length,
    sameTopic: !!post.data.topic && candidate.data.topic === post.data.topic,
  }))
  .filter(({ overlap, sameTopic }) => overlap > 0 || sameTopic)
  .sort(
    (a, b) =>
      Number(b.sameTopic) - Number(a.sameTopic) ||
      b.overlap - a.overlap ||
      b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf() ||
      a.post.id.localeCompare(b.post.id),
  )
  .slice(0, 3);
const relatedPosts = await Promise.all(
  related.map(({ post }) => presentPost(post)),
);
---

<BlogPost post={post} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</BlogPost>
