#!/usr/bin/env bash
# scripts/githooks/pre-push: run the quick CI checks on the exact commits being pushed (#3524).
#
# Git runs this before every `git push` from any checkout whose `core.hooksPath` points at
# scripts/githooks (Claude, Codex and terminal pushes alike). For each branch commit being
# pushed it makes a detached worktree of THAT commit, so uncommitted and untracked files in
# the pushing checkout can never change the verdict, and runs that commit's own
# scripts/ci/fast-checks.sh against it: the same list cloud CI runs in build-check. It then
# runs the commit's own Recipe trailer check (check-test-recipe.py) against the prospective
# merge of that commit into a freshly fetched origin/main: the tree that would land.
#
# Verdicts:
#   a check FAILS ............ the push is blocked; the check's own output says why
#   COULD NOT RUN ............ a warning naming what is missing; the push goes ahead and
#                              cloud CI checks it (e.g. a commit from before fast-checks.sh,
#                              offline, a fetch slower than 15 s, a conflict with main)
#   hook fault ............... any unexpected error in this hook blocks the push, with the
#                              rollback command; a broken gate never waves a push through
#   cleanup failure .......... after a complete verdict, a warning naming the kept temp
#                              directory; the verdict stands (it is the hook's copy, not
#                              the pushed code; founder 2026-10-07)
# Deletions and tags are skipped: they push no new code.
#
# Usage:
#   (git) pre-push <remote-name> <remote-url>   with "<local ref> <local sha> <remote ref>
#                                                <remote sha>" lines on stdin
#   pre-push --self-test                         drive real `git push` calls against an
#                                                owned local remote in a temp directory
#
# Rollback: scripts/githooks/install.sh --uninstall (the installer is part of this change set).
#
# Portability: macOS /bin/bash 3.2 and Linux bash 5.
# -E: the ERR trap below also fires inside functions.
set -Eeuo pipefail

ZERO_SHA=0000000000000000000000000000000000000000
ROLLBACK="scripts/githooks/install.sh --uninstall"

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/ci/process-tree.sh
. "$HOOK_DIR/../ci/process-tree.sh" || {
  echo "==> pre-push: BLOCKED (hook fault: cannot load $HOOK_DIR/../ci/process-tree.sh). Rollback: $ROLLBACK" >&2
  exit 1
}

ORIGIN=""          # the checkout the push runs from; its Dev build data is read in PR 3
ORIGIN_DEV_DATA="" # that checkout's Dev build data
REPO=""            # the repository's main registered worktree: history and GitHub identity
WORK=""            # this run's own temp directory; every snapshot lives inside it
SNAPSHOTS=()       # owned detached worktrees, registered BEFORE creation so a partial one is covered
CHILD=""           # the running check, stopped with its whole process tree on interruption
SNAP_DIR=""        # set by snapshot(); not command substitution, which would lose SNAPSHOTS
CLEANUP_ERROR=""   # what cleanup could not do; warned after a verdict, never silent
FETCH_SECONDS=15   # the plan's cap on waiting for the network (#3524 §3.4)
RECIPE_SECONDS=15  # the recipe check reads GitHub, so the same network cap applies
STOP_GRACE=2       # seconds between TERM and KILL when a deadline stops a command
MAIN_STATE=""      # "" until fetched; then "ok", or why origin/main could not be fetched
MAIN_SHA=""        # origin/main as fetched once for this run; every pushed commit merges with it

# Is <path> registered as a worktree of this repository? Sets REGISTRATION to "registered"
# or "absent", and ADMIN_ENTRY to the admin directory whose `gitdir` file points at
# <path>/.git, if any. Both git's own list and the admin directories are read: git's list
# omits an entry whose `gitdir` file cannot be read, so the list alone could call a
# registered snapshot absent. Exact path match; WORK is canonicalised with `pwd -P` when
# made, so the spellings agree. Returns 1 when either source cannot be read: an unknown is
# never read as "absent", so it can never authorise a delete.
REGISTRATION=""
ADMIN_ENTRY=""
read_registration() {
  local listing common entry gitdir
  REGISTRATION=""
  ADMIN_ENTRY=""
  listing="$(git -C "$REPO" worktree list --porcelain)" || return 1
  common="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)" || return 1
  for entry in "$common"/worktrees/*; do
    # No gitdir file: git cannot map that entry to any path, ours included.
    [ -f "$entry/gitdir" ] || continue
    gitdir="$(cat "$entry/gitdir")" || return 1
    if [ "$gitdir" = "$1/.git" ]; then ADMIN_ENTRY="$entry"; fi
  done
  case $'\n'"$listing"$'\n' in
    (*$'\n'"worktree $1"$'\n'*) REGISTRATION="registered" ;;
    (*) if [ -n "$ADMIN_ENTRY" ]; then REGISTRATION="registered"; else REGISTRATION="absent"; fi ;;
  esac
}

# Remove git's registration for exactly <path>: its own admin directory. Never
# `git worktree prune`, which would also drop registrations that are not ours. Returns 1
# if the path is still registered, or cannot be checked, afterwards.
unregister_exact() {
  read_registration "$1" || return 1
  if [ -n "$ADMIN_ENTRY" ]; then rm -rf "$ADMIN_ENTRY" || return 1; fi
  read_registration "$1" || return 1
  [ "$REGISTRATION" = "absent" ]
}

# Remove one owned snapshot, whatever state a crash or a fault left it in. Returns 1 if the
# snapshot is still registered or still on disk afterwards, or if git cannot say; the
# directory is deleted only after git confirms it is no longer registered.
remove_snapshot() {
  local snap="$1"
  read_registration "$snap" || return 1
  if [ "$REGISTRATION" = "registered" ]; then
    if [ -d "$snap" ]; then
      git -C "$REPO" worktree remove --force "$snap" > /dev/null 2>&1 || true
    fi
    # Still registered (a missing directory, or a checkout without its .git file): remove
    # exactly this registration, then the directory.
    read_registration "$snap" || return 1
    if [ "$REGISTRATION" = "registered" ]; then unregister_exact "$snap" || return 1; fi
  fi
  if [ -e "$snap" ]; then rm -rf "$snap" || return 1; fi
  read_registration "$snap" || return 1
  [ "$REGISTRATION" = "absent" ] && [ ! -e "$snap" ]
}

# Remove every owned snapshot and the temp directory. Returns 1, with CLEANUP_ERROR set, if
# any snapshot could not be removed; then the temp directory is KEPT and named, so a person
# can finish with `git worktree remove --force <path>`.
cleanup() {
  local snap failed=""
  for snap in ${SNAPSHOTS[@]+"${SNAPSHOTS[@]}"}; do
    remove_snapshot "$snap" || failed="$failed $snap"
  done
  SNAPSHOTS=()
  if [ -n "$failed" ]; then
    CLEANUP_ERROR="could not remove snapshot(s):$failed; kept $WORK"
    WORK=""
    return 1
  fi
  if [ -n "$WORK" ]; then rm -rf "$WORK" || { CLEANUP_ERROR="could not remove $WORK"; WORK=""; return 1; }; fi
  WORK=""
  return 0
}

hook_fault() {
  trap - ERR INT TERM
  echo "==> pre-push: BLOCKED (hook fault: $1)" >&2
  echo "    The gate itself failed, so this push was not judged. Rollback: $ROLLBACK" >&2
  if ! cleanup; then echo "    Cleanup also failed: $CLEANUP_ERROR" >&2; fi
  exit 1
}

on_signal() {
  trap - ERR INT TERM
  if [ -n "$CHILD" ]; then
    # Bounded: a check that ignores TERM is KILLed after STOP_GRACE, never waited on forever.
    stop_tree_bounded "$CHILD" "$STOP_GRACE"
    if ! kill -0 "$CHILD" 2> /dev/null; then wait "$CHILD" 2> /dev/null || true; fi
  fi
  echo "==> pre-push: BLOCKED (interrupted)" >&2
  if [ -n "$PROCESS_TREE_INCOMPLETE" ]; then echo "    Cleanup incomplete: $PROCESS_TREE_INCOMPLETE" >&2; fi
  if ! cleanup; then echo "    Cleanup also failed: $CLEANUP_ERROR" >&2; fi
  exit 130
}

# The checks this hook runs, in order. Each takes `--repo <main worktree> --tree <snapshot>
# --sha <commit>` and returns 0 PASS, 1 FAIL, 3 COULD NOT RUN; anything else is a hook fault.
# PR 3 adds the String Catalog check, which reads ORIGIN_DEV_DATA; it does not exist yet.
CHECKS="check_fast_checks check_recipe"

# Parse the dispatch contract; every check calls this first.
parse_check_args() {
  CHECK_REPO="" CHECK_TREE="" CHECK_SHA=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo | --tree | --sha)
        # A missing value must return, not loop: a failed `shift 2` leaves $# unchanged.
        if [ $# -lt 2 ] || [ -z "$2" ]; then
          echo "==> pre-push: missing value for $1" >&2
          return 4
        fi
        case "$1" in
          --repo) CHECK_REPO="$2" ;;
          --tree) CHECK_TREE="$2" ;;
          --sha) CHECK_SHA="$2" ;;
        esac
        shift 2
        ;;
      *) echo "==> pre-push: unknown check argument: $1" >&2; return 4 ;;
    esac
  done
  case "$CHECK_SHA" in
    *[!0-9a-f]* | "") echo "==> pre-push: not a commit id: '$CHECK_SHA'" >&2; return 4 ;;
  esac
  [ -d "$CHECK_REPO" ] && [ -d "$CHECK_TREE" ] && [ ${#CHECK_SHA} -eq 40 ] \
    || { echo "==> pre-push: bad check arguments (repo=$CHECK_REPO tree=$CHECK_TREE sha=$CHECK_SHA)" >&2; return 4; }
}

check_fast_checks() {
  local runner rc
  parse_check_args "$@" || return 4
  runner="$CHECK_TREE/scripts/ci/fast-checks.sh"
  if [ ! -f "$runner" ]; then
    echo "==> fast-checks: COULD NOT RUN (${CHECK_SHA:0:12} has no scripts/ci/fast-checks.sh; CI will check)" >&2
    return 3
  fi
  # The runner needs only the tree; history checks (PR 2) use --repo. Same interpreter as
  # this hook, so a hook running under one bash never judges with another.
  "$BASH" "$runner" --tree "$CHECK_TREE" >&2 &
  CHILD=$!
  if wait "$CHILD"; then rc=0; else rc=$?; fi
  CHILD=""
  # The runner exits 0 (all PASS or SKIP), 1 (a member or the runner failed) or 2 (usage).
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    *) echo "==> fast-checks: exited $rc, which is not a verdict" >&2; return 4 ;;
  esac
}

# run_bounded <seconds> <command...>: run the command as CHILD (so an interruption stops it
# and everything it started) and return its status, or 124 when the deadline passed; then the
# command's whole process tree has been stopped, TERM first and KILL after STOP_GRACE for
# anything that ignores it. The deadline is wall time (SECONDS), not a count of sleeps.
# macOS has no `timeout`.
run_bounded() {
  local limit="$1" start rc
  shift
  "$@" &
  CHILD=$!
  start=$SECONDS
  while kill -0 "$CHILD" 2> /dev/null; do
    if [ $((SECONDS - start)) -ge "$limit" ]; then
      stop_tree_bounded "$CHILD" "$STOP_GRACE"
      if [ -n "$PROCESS_TREE_INCOMPLETE" ]; then
        echo "==> pre-push: WARNING: $PROCESS_TREE_INCOMPLETE after a deadline" >&2
      fi
      if ! kill -0 "$CHILD" 2> /dev/null; then wait "$CHILD" 2> /dev/null || true; fi
      CHILD=""
      return 124
    fi
    sleep 0.1
  done
  if wait "$CHILD"; then rc=0; else rc=$?; fi
  CHILD=""
  return "$rc"
}

# Refresh origin/main once per run, within FETCH_SECONDS, and fix MAIN_SHA for the whole run.
# A failure is remembered in MAIN_STATE and makes the recipe check COULD NOT RUN; it never
# falls back to a stale origin/main, HEAD or the unmerged commit.
fetch_main() {
  local rc
  [ -z "$MAIN_STATE" ] || return 0
  # An explicit destination: a plain `fetch origin main` updates origin/main only when the
  # configured fetch mapping says so, and a stale origin/main would then look fresh.
  if run_bounded "$FETCH_SECONDS" env GIT_TERMINAL_PROMPT=0 \
    git -C "$REPO" fetch --quiet --no-tags origin "+refs/heads/main:refs/remotes/origin/main" \
    > "$WORK/fetch.out" 2>&1; then rc=0; else rc=$?; fi
  case "$rc" in
    0) ;;
    124) MAIN_STATE="git fetch origin main took longer than $FETCH_SECONDS s"; return 0 ;;
    *) MAIN_STATE="git fetch origin main failed (exit $rc): $(head -c 300 "$WORK/fetch.out" | tr '\n' ' ')"; return 0 ;;
  esac
  if MAIN_SHA="$(git -C "$REPO" rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}')"; then
    MAIN_STATE="ok"
  else
    MAIN_STATE="git fetch origin main left no refs/remotes/origin/main"
  fi
}

# The Recipe trailer check (#3524 §3.2): the pushed commit's own check-test-recipe.py reads
# the trailers in merge-base(origin/main, sha)..sha, asks GitHub from the repository, and
# validates an issue recipe against the prospective merge, so a row anchored on code only
# main has, or on code main has since removed, is judged as it will land.
check_recipe() {
  local checker base out merge_tree landing land_tree land rc
  parse_check_args "$@" || return 4
  checker="$CHECK_TREE/scripts/ci/check-test-recipe.py"
  if [ ! -f "$checker" ] || ! grep -q -- '"--trailers"' "$checker"; then
    echo "==> recipe: COULD NOT RUN (${CHECK_SHA:0:12} has no trailer-reading check-test-recipe.py; recipe-check in CI will check)" >&2
    return 3
  fi
  if ! command -v python3 > /dev/null 2>&1; then
    echo "==> recipe: COULD NOT RUN (no python3 on PATH; recipe-check in CI will check)" >&2
    return 3
  fi
  fetch_main
  if [ "$MAIN_STATE" != "ok" ]; then
    echo "==> recipe: COULD NOT RUN ($MAIN_STATE); recipe-check in CI will check" >&2
    return 3
  fi
  if base="$(git -C "$CHECK_REPO" merge-base "$MAIN_SHA" "$CHECK_SHA")"; then rc=0; else rc=$?; fi
  case "$rc" in
    0) ;;
    1)
      echo "==> recipe: COULD NOT RUN (${CHECK_SHA:0:12} shares no history with origin/main ${MAIN_SHA:0:12}; recipe-check in CI will check)" >&2
      return 3
      ;;
    *) echo "==> recipe: git merge-base exited $rc" >&2; return 4 ;;
  esac
  if out="$(git -C "$CHECK_REPO" merge-tree --write-tree "$MAIN_SHA" "$CHECK_SHA" 2>&1)"; then rc=0; else rc=$?; fi
  case "$rc" in
    0) ;;
    1)
      echo "==> recipe: COULD NOT RUN (${CHECK_SHA:0:12} conflicts with origin/main ${MAIN_SHA:0:12}, so there is no landing tree; recipe-check in CI will check once the conflict is resolved)" >&2
      return 3
      ;;
    *) echo "==> recipe: git merge-tree exited $rc: ${out:0:300}" >&2; return 4 ;;
  esac
  merge_tree="${out%%$'\n'*}"
  case "$merge_tree" in
    *[!0-9a-f]* | "") echo "==> recipe: git merge-tree printed no tree id: ${out:0:300}" >&2; return 4 ;;
  esac
  [ ${#merge_tree} -eq 40 ] || { echo "==> recipe: git merge-tree printed no tree id: ${out:0:300}" >&2; return 4; }
  # A throwaway commit only so `git worktree add` can check the tree out; nothing refers to it
  # and it is never pushed, so signing is turned off for this one command: a signer that is
  # missing or asks for a passphrase must not decide a push. Repository settings are untouched.
  landing="$(GIT_AUTHOR_NAME=pre-push GIT_AUTHOR_EMAIL=pre-push@example.invalid \
    GIT_COMMITTER_NAME=pre-push GIT_COMMITTER_EMAIL=pre-push@example.invalid \
    git -c commit.gpgSign=false -C "$CHECK_REPO" commit-tree "$merge_tree" -p "$MAIN_SHA" -p "$CHECK_SHA" \
    -m "pre-push: prospective merge of $CHECK_SHA into origin/main $MAIN_SHA")"
  snapshot "$landing"
  land="$SNAP_DIR"
  land_tree="$(git -C "$land" rev-parse 'HEAD^{tree}')"
  [ "$land_tree" = "$merge_tree" ] && [ "$land" != "$CHECK_TREE" ] \
    || { echo "==> recipe: the landing snapshot is not the prospective merge (tree $land_tree)" >&2; return 4; }
  echo "==> recipe: ${CHECK_SHA:0:12} merged with origin/main ${MAIN_SHA:0:12} (base ${base:0:12})" >&2
  if run_bounded "$RECIPE_SECONDS" python3 "$checker" --trailers --base "$base" --head "$CHECK_SHA" \
    --repo "$CHECK_REPO" --checkout "$land" >&2; then rc=0; else rc=$?; fi
  case "$rc" in
    0 | 1 | 3) return "$rc" ;;
    124)
      echo "==> recipe: COULD NOT RUN (the check took longer than $RECIPE_SECONDS s; recipe-check in CI will check)" >&2
      return 3
      ;;
    *) echo "==> recipe: check-test-recipe.py exited $rc, which is not a verdict" >&2; return 4 ;;
  esac
}

# Make a detached worktree of <sha> inside WORK; its path lands in SNAP_DIR.
snapshot() {
  local sha="$1" dir
  dir="$WORK/${sha:0:12}"
  SNAPSHOTS+=("$dir")
  git -C "$REPO" worktree add --detach --quiet "$dir" "$sha" > /dev/null 2>&1 \
    || hook_fault "cannot create a snapshot of $sha"
  [ "$(git -C "$dir" rev-parse HEAD)" = "$sha" ] || hook_fault "snapshot of $sha is at the wrong commit"
  SNAP_DIR="$dir"
}

main() {
  local local_ref local_sha remote_ref remote_sha seen="" sha tree check rc
  local blocked=0 warned=0 checked=0

  # Resolve the pushing checkout BEFORE touching any other tree, then drop the variables git
  # sets for this repository so commands in a snapshot cannot be pointed back at it.
  command -v pgrep > /dev/null 2>&1 || hook_fault "missing tool: pgrep"
  ORIGIN="$(git rev-parse --show-toplevel)" || hook_fault "not inside a git checkout"
  ORIGIN_DEV_DATA="$ORIGIN/.derivedData/Dev"
  : "$ORIGIN_DEV_DATA"
  # The main registered worktree: the first `worktree` line of the porcelain list.
  REPO="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
  [ -n "$REPO" ] && [ -d "$REPO" ] || hook_fault "cannot resolve the repository's main worktree"
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_PREFIX
  WORK="$(mktemp -d "${TMPDIR:-/tmp}/ew-pre-push.XXXXXX")" || hook_fault "cannot create a temp directory"
  # Canonical spelling (/var -> /private/var on macOS) so registration checks match exactly.
  WORK="$(cd "$WORK" && pwd -P)" || hook_fault "cannot resolve the temp directory"
  echo "==> pre-push: CI gap: the website build and check:help take longer than the local cut; website-check in CI remains the authority." >&2

  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    : "$remote_sha"
    if [ "$local_sha" = "$ZERO_SHA" ]; then
      echo "==> pre-push: skip $remote_ref (deletion)" >&2
      continue
    fi
    # Skipped by DESTINATION: a tag pushed to a branch (refs/tags/x:refs/heads/y) puts
    # code on that branch, so it is checked like any branch push.
    case "$remote_ref" in
      refs/tags/*)
        echo "==> pre-push: skip $remote_ref (tag)" >&2
        continue
        ;;
    esac
    case " $seen " in *" $local_sha "*) continue ;; esac
    seen="$seen $local_sha"

    echo "==> pre-push: checking ${local_sha:0:12} ($local_ref -> $remote_ref)" >&2
    snapshot "$local_sha"
    tree="$SNAP_DIR"
    checked=$((checked + 1))
    for check in $CHECKS; do
      if "$check" --repo "$REPO" --tree "$tree" --sha "$local_sha"; then rc=0; else rc=$?; fi
      case "$rc" in
        0) ;;
        1) blocked=$((blocked + 1)) ;;
        3) warned=$((warned + 1)) ;;
        *) hook_fault "$check returned $rc for $local_sha" ;;
      esac
    done
  done

  # A cleanup failure is about this hook's own temp copy, never the pushed code: after a
  # complete verdict it warns and leaves the verdict alone (founder 2026-10-07, #3524).
  # A fault or interruption BEFORE a verdict still blocks (hook_fault, on_signal).
  if ! cleanup; then
    trap - ERR
    echo "==> pre-push: WARNING: $CLEANUP_ERROR. This is about the hook's temp copy, not your code; the verdict below stands." >&2
    echo "    Remove it with: git worktree remove --force <path> for each snapshot inside it, then delete the directory." >&2
    warned=$((warned + 1))
  fi
  if [ "$blocked" -gt 0 ]; then
    echo "==> pre-push: BLOCKED ($blocked failing check(s) across $checked commit(s); fix them, or see above)" >&2
    exit 1
  fi
  if [ "$warned" -gt 0 ]; then
    echo "==> pre-push: OK with $warned warning(s) ($checked commit(s); CI will check what could not run here)" >&2
  else
    echo "==> pre-push: OK ($checked commit(s) checked)" >&2
  fi
}

# ---------------------------------------------------------------------------
# Self-test: a throwaway repository with a stub fast-checks.sh, an owned bare
# remote, and real `git push` calls through this hook. The stub fails when a
# committed file BROKEN exists, records the commit it checked, and sleeps while
# a committed file SLOW exists.
# ---------------------------------------------------------------------------
# shellcheck disable=SC2016 # the self-test passes literal shell text into private hook copies
self_test() {
  local hook tmp repo remote fails=0 cases=0 out rc sha_good sha_bad pid leftovers_before
  set +e
  hook="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  leftovers_before="$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'ew-pre-push.*' | wc -l | tr -d ' ')"
  tmp="$(cd "$(mktemp -d)" && pwd -P)"
  repo="$tmp/repo"
  remote="$tmp/remote.git"

  check() { # check <label> <actual> <expected>
    cases=$((cases + 1))
    if [ "$2" = "$3" ]; then echo "ok    $1"; else echo "FAIL  $1: got [$2] want [$3]"; fails=$((fails + 1)); fi
  }
  push() { git -C "$repo" push "$@" > "$tmp/push.out" 2>&1; }
  # inject <exact line> <replacement>: a private hook copy with one whole line replaced;
  # fails (and the caller records it) unless exactly one line matched.
  inject() {
    awk -v old="$1" -v new="$2" '$0 == old { print new; n++; next } { print } END { exit (n == 1 ? 0 : 1) }' \
      "$hook" > "$tmp/hooks/pre-push"
  }
  checked_shas() { grep -o 'stub checked [0-9a-f]*' "$tmp/push.out" | cut -d' ' -f3 | sort | tr '\n' ' '; }

  git init --quiet --bare "$remote"
  git init --quiet -b main "$repo"
  git -C "$repo" config user.email self-test@example.invalid
  git -C "$repo" config user.name self-test
  mkdir -p "$repo/scripts/ci" "$tmp/hooks"
  cat > "$repo/scripts/ci/fast-checks.sh" << 'STUB'
#!/usr/bin/env bash
tree="$2"
echo "stub checked $(git -C "$tree" rev-parse HEAD)"
echo "stub env GIT_INDEX_FILE=${GIT_INDEX_FILE:-unset}"
echo "stub bash $BASH_VERSION"
if [ -e "$tree/SLOW" ]; then
  sleep 30 &
  echo "$!" > "$SELFTEST_SLOW_PID.child"
  echo "$$" > "$SELFTEST_SLOW_PID"
  wait
fi
[ ! -e "$tree/BROKEN" ]
STUB
  cp "$(dirname "$hook")/../ci/check-test-recipe.py" "$repo/scripts/ci/check-test-recipe.py"
  cp "$(dirname "$hook")/../validate-mutation-recipe.py" "$(dirname "$hook")/../mutation-battery.py" "$repo/scripts/"
  echo base > "$repo/README"
  git -C "$repo" add -A
  git -C "$repo" commit --quiet -m base
  git -C "$repo" remote add origin "$remote"
  cp "$hook" "$tmp/hooks/pre-push"
  mkdir -p "$tmp/ci"
  cp "$(dirname "$hook")/../ci/process-tree.sh" "$tmp/ci/process-tree.sh"
  git -C "$repo" config core.hooksPath "$tmp/hooks"

  # 1. clean pass, and the commit checked is the one pushed
  push origin main; rc=$?
  sha_good="$(git -C "$repo" rev-parse HEAD)"
  check "a clean push passes and checks the pushed commit" "$rc|$(checked_shas)" "0|$sha_good "
  echo "      (git ran the hook with: $(grep -o 'stub bash .*' "$tmp/push.out" | head -1))"
  check "the website CI gap is named in the hook output" "$(grep -c 'CI gap: the website build' "$tmp/push.out")" "1"

  # 2. a committed failure blocks; the fix passes
  touch "$repo/BROKEN"; git -C "$repo" add -A; git -C "$repo" commit --quiet -m broken
  sha_bad="$(git -C "$repo" rev-parse HEAD)"
  push origin main; rc=$?
  check "a committed failure blocks the push" "$rc|$(grep -c 'BLOCKED (1 failing' "$tmp/push.out")" "1|1"
  git -C "$repo" rm --quiet BROKEN; git -C "$repo" commit --quiet -m fixed
  push origin main; rc=$?
  check "the fixed commit passes" "$rc" "0"

  # 3. a non-HEAD branch is checked at ITS commit, not the working tree's
  git -C "$repo" branch bad "$sha_bad"
  push origin bad:bad; rc=$?
  check "a non-HEAD branch is checked at its own commit" "$rc|$(checked_shas)" "1|$sha_bad "

  # 4. dirty and untracked files in the pushing checkout change nothing
  git -C "$repo" checkout --quiet -b side
  touch "$repo/BROKEN"; echo dirty >> "$repo/README"
  push origin side; rc=$?
  check "uncommitted and untracked files do not reach the verdict" "$rc" "0"
  rm -f "$repo/BROKEN"; git -C "$repo" checkout --quiet -- README

  # 5. two refs in one push: both checked, one bad blocks
  git -C "$repo" branch good2 HEAD
  push origin bad:bad2 good2:good2; rc=$?
  check "two refs in one push are both checked" "$rc|$(checked_shas)" "1|$(printf '%s\n' "$sha_bad" "$(git -C "$repo" rev-parse good2)" | sort | tr '\n' ' ')"

  # 6. a deletion is skipped
  push origin :side; rc=$?
  check "a deletion is skipped and allowed" "$rc|$(grep -c '(deletion)' "$tmp/push.out")" "0|1"

  # 7. a tag is skipped, even on a bad commit
  git -C "$repo" tag v-bad "$sha_bad"
  push origin v-bad; rc=$?
  check "a tag is skipped and allowed" "$rc|$(grep -c '(tag)' "$tmp/push.out")" "0|1"
  push origin refs/tags/v-bad:refs/heads/from-tag; rc=$?
  check "a tag pushed to a branch is checked like a branch" "$rc|$(checked_shas)|$(grep -c '(tag)' "$tmp/push.out")" "1|$sha_bad |0"

  # 8. inherited git variables do not leak into the snapshot's checks
  out="$(cd "$repo" && printf 'refs/heads/main %s refs/heads/main %s\n' "$(git rev-parse main)" "$ZERO_SHA" \
    | GIT_INDEX_FILE="$tmp/not-an-index" "$BASH" "$hook" origin "$remote" 2>&1)"; rc=$?
  check "inherited GIT_INDEX_FILE is cleared before checks run" "$rc|$(printf '%s' "$out" | grep -c 'GIT_INDEX_FILE=unset')" "0|1"

  # 9. a commit with no fast-checks.sh and no recipe checker is COULD NOT RUN twice: warnings,
  #    not a block
  git -C "$repo" checkout --quiet --orphan bare-branch
  git -C "$repo" rm --quiet -r --cached . > /dev/null
  echo x > "$repo/only-file"; git -C "$repo" add only-file; git -C "$repo" commit --quiet -m orphan
  push origin bare-branch; rc=$?
  check "missing evidence warns and allows" "$rc|$(grep -c 'COULD NOT RUN' "$tmp/push.out")|$(grep -c 'OK with 2 warning' "$tmp/push.out")" "0|2|1"
  git -C "$repo" checkout --quiet -f main; git -C "$repo" clean --quiet -fd

  # 10. a fault inside the hook blocks, through a private copy that fails mid-run
  # shellcheck disable=SC2016 # the sed program is literal shell text, not to be expanded
  sed 's/^    checked=\$((checked + 1))$/    checked=$((checked + 1)); false/' "$hook" > "$tmp/hooks/pre-push"
  # shellcheck disable=SC2016 # literal text again
  if [ "$(grep -cx '    checked=\$((checked + 1)); false' "$tmp/hooks/pre-push")" != 1 ]; then
    check "the fault-injection copy was made" "no" "yes"
  else
    echo f10 > "$repo/f10"; git -C "$repo" add f10; git -C "$repo" commit --quiet -m f10
    push origin main; rc=$?
    check "a hook fault blocks the push and names the rollback" "$rc|$(grep -c 'hook fault' "$tmp/push.out")|$(grep -c "$ROLLBACK" "$tmp/push.out")" "1|1|1"
  fi
  cp "$hook" "$tmp/hooks/pre-push"

