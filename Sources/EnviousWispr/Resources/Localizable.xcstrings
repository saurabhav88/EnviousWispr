    "whatsNew.dock-icon-and-window-in-front.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry dock-icon-and-window-in-front).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard macOS app behavior: EnviousWispr now appears in your Dock and the ⌘⇥ (Command-Tab) app switcher, bringing its window to the front when focused."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganz normales Mac-Verhalten: EnviousWispr erscheint jetzt im Dock und beim App-Wechsel mit ⌘⇥ (Befehlstaste-Tab) und bringt sein Fenster nach vorn, wenn du es aufrufst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un comportement macOS standard : EnviousWispr apparaît désormais dans votre Dock et dans le sélecteur d’apps ⌘⇥ (Commande-Tabulation), et sa fenêtre passe au premier plan lorsqu’elle est sélectionnée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comportamiento estándar de macOS: EnviousWispr ahora aparece en el Dock y en el selector de apps ⌘⇥ (Comando-Tab), y muestra su ventana en primer plano cuando la seleccionas."
          }
        }
      }
    },
    "whatsNew.dock-icon-and-window-in-front.bullet.0" : {
      "comment" : "Settings > What's New: point 1 of the list under one feature announcement (entry dock-icon-and-window-in-front).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Better menu bar placement: Unless you've moved it, the menu bar icon now sits further to the right near your system icons, making it quicker to spot."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Position in der Menüleiste: Wenn du das Menüleistensymbol nie verschoben hast, sitzt es jetzt weiter rechts bei den Systemsymbolen und ist schneller zu finden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur emplacement dans la barre des menus : sauf si vous l’avez déplacée, l’icône de la barre des menus se trouve désormais plus à droite, près des icônes système, pour être plus facile à repérer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejor ubicación en la barra de menús: salvo que lo hayas movido, el icono de la barra de menús ahora está más a la derecha, cerca de los iconos del sistema, para que lo encuentres más rápido."
          }
        }
      }
    },
    "whatsNew.dock-icon-and-window-in-front.bullet.1" : {
      "comment" : "Settings > What's New: point 2 of the list under one feature announcement (entry dock-icon-and-window-in-front).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu bar only mode: Prefer a distraction-free setup? Turn off Show app in Dock under Settings > Appearance to keep EnviousWispr tucked away exclusively in your menu bar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in der Menüleiste: Du möchtest es aufgeräumt? Deaktiviere „App im Dock anzeigen“ unter Einstellungen > Erscheinungsbild, dann bleibt EnviousWispr nur in deiner Menüleiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode barre des menus uniquement : vous préférez une configuration sans distraction ? Désactivez Afficher l’app dans le Dock dans Réglages > Apparence pour garder EnviousWispr exclusivement dans votre barre des menus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo en la barra de menús: ¿Prefieres una configuración sin distracciones? Desactiva “Mostrar la app en el Dock” en Ajustes > Aspecto para mantener EnviousWispr exclusivamente en la barra de menús."
          }
        }
      }
    },
