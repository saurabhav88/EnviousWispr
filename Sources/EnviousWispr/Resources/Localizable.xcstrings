    "whatsNew.paste-chromium-electron.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-chromium-electron).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictating into Chrome, Slack, Discord, VS Code, and other Electron-based apps now pastes cleanly even when the focused text field isn't fully reported. Previously the text would sometimes sit on the clipboard instead of landing in place."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktierter Text wird jetzt auch in Chrome, Slack, Discord, VS Code und anderen Electron-Apps richtig eingefügt, wenn das aktive Textfeld nicht vollständig gemeldet wird. Bisher blieb der Text manchmal nur in der Zwischenablage."
          }
        }
      }
    },
    "whatsNew.gemma-3-nano.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry gemma-3-nano).",
      "extractionState" : "manual",
      "localizations" : {
