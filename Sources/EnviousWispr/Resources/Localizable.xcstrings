    },
    "whatsNew.update-banner-stays-put.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry update-banner-stays-put).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a new version is ready, the in-app banner now stays visible until you install. No more dismissing it and forgetting it was there."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine neue Version bereitsteht, bleibt der Hinweis in der App jetzt bis zur Installation sichtbar. So gerät das Update nicht nach dem Schließen des Hinweises in Vergessenheit."
          }
        }
      }
    },
    "whatsNew.better-error-logging.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry better-error-logging).",
