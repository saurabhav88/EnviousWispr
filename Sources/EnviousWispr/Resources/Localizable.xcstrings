    "whatsNew.dark-mode.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry dark-mode).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr now has a dark mode. Match your system automatically, or pick light or dark yourself in Settings. Easier on the eyes for late-night dictation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr hat jetzt einen Dunkelmodus. Übernimm das Erscheinungsbild automatisch vom System oder wähle in den Einstellungen selbst zwischen Hell und Dunkel. Angenehmer für Diktate am späten Abend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr propose désormais un mode sombre. Dans Réglages, choisissez de suivre automatiquement l’apparence de votre Mac ou sélectionnez le mode clair ou sombre. Le mode sombre est plus agréable pour dicter le soir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EnviousWispr ahora tiene modo oscuro. Haz que coincida automáticamente con tu sistema o elige el modo claro u oscuro en Ajustes. Más cómodo para la vista al dictar por la noche."
          }
        }
      }
    },
    "whatsNew.hour-long-recordings.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry hour-long-recordings).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record for up to an hour at a time"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu einer Stunde am Stück aufnehmen"
          }
        },
        "fr" : {
