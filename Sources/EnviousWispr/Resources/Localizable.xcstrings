        }
      }
    },
    "We'll add %@ names from your contacts. %@ are already in your list." : {
      "comment" : "Your Words, import from Contacts: the first %@ is the number of new names, the second the number already in the word list; neither is 1.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
