        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correction d’un problème qui additionnait les nombres dictés à la suite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha corregido un error por el que los números se sumaban al dictarlos seguidos."
          }
        }
      }
    },
    "whatsNew.latest-cloud-models-and-smaller-fixes.bullet.7" : {
      "comment" : "Settings > What's New: point 8 of the list under one feature announcement (entry latest-cloud-models-and-smaller-fixes).",
