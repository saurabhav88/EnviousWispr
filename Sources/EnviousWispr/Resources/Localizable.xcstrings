      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your API keys for AI Polish are now stored in your Mac's keychain, the same secure place your other passwords live. Existing keys were moved over automatically."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine API-Schlüssel für die KI-Nachbearbeitung werden jetzt im Schlüsselbund deines Mac gespeichert, zusammen mit deinen anderen Passwörtern. Vorhandene Schlüssel wurden automatisch übertragen."
          }
        }
      }
    },
    "whatsNew.cleaner-audio-settings.title" : {
