    "Off for now" : {
      "comment" : "Closing film: AI polish was skipped in Setup.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorerst aus"
          }
        },
        "fr" : {
          "stringUnit" : {
