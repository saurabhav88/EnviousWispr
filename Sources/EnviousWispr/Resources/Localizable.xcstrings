          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bessere Unterstützung für /Befehle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleure prise en charge de /commands"
          }
        },
