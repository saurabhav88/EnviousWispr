      }
    },
    "Hold only the keybind and press Space to go hands-free." : {
      "comment" : "Keybinds, Recording mode help in Push to Talk: while holding a single modifier dictation key, pressing Space locks hands-free recording on. Space is the Space bar.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte nur das Tastenkürzel gedrückt und drücke die Leertaste, um freihändig aufzunehmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
