    "whatsNew.faster-polish-after-pause.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry faster-polish-after-pause).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your first dictation after a quiet stretch now gets polished faster. The pre-warm probe talks to the LLM the same way a real polish does, so the first real call doesn't pay a cold-start tax."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein erstes Diktat nach einer längeren Pause wird jetzt schneller nachbearbeitet. Die vorbereitende Anfrage spricht mit dem Sprachmodell wie eine echte Nachbearbeitung, damit der erste tatsächliche Aufruf keinen Kaltstart abwarten muss."
          }
        }
      }
    },
    "whatsNew.paste-chromium-electron.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry paste-chromium-electron).",
