    },
    "whatsNew.paste-never-waits-on-history.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry paste-never-waits-on-history).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if saving a dictation to your History runs into a snag, your words still land where you are typing. Delivery no longer waits on the archive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst wenn das Speichern eines Diktats im Verlauf scheitert, erscheint dein Text an der Eingabestelle. Das Einfügen wartet nicht mehr auf die Archivierung."
          }
        }
      }
    },
    "whatsNew.voiceover-and-keyboard.title" : {
      "comment" : "Settings > What's New: the title of one feature announcement (entry voiceover-and-keyboard).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built for VoiceOver and keyboard navigation"
