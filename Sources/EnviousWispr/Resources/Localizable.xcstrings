        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus palabras"
          }
        }
      }
    },
    "Your Words could not be refreshed, so there is nothing to match against yet. Try again." : {
      "comment" : "Quick Add panel: why the selected text could not be read.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wörter konnten nicht aktualisiert werden. Deshalb sind noch keine Treffer möglich. Versuche es erneut."
          }
