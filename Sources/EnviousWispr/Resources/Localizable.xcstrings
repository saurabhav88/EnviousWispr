    "This model needs a newer version of EnviousWispr." : {
      "comment" : "AI Polish, local model card: the reason under the health status.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell benötigt eine neuere Version von EnviousWispr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce modèle nécessite une version plus récente d’EnviousWispr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo necesita una versión más reciente de EnviousWispr."
          }
        }
      }
    },
    "This older transcript can't confirm which file it came from." : {
      "comment" : "History transcript: a transcript saved before the app stored file details; a file is there but nothing confirms it is the original.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesem älteren Transkript lässt sich nicht bestätigen, aus welcher Datei es stammt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette ancienne transcription ne permet pas de confirmer de quel fichier elle provient."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede confirmar de qué archivo procede esta transcripción antigua."
          }
        }
      }
    },
    "This only picks which start word you edit. It does not change your dictation language." : {
      "comment" : "Speech engine settings, Start word row: the language picker does not set the dictation language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier wählst du nur, welches Startwort du bearbeitest. Deine Diktiersprache ändert sich dadurch nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette option permet uniquement de choisir le mot de début à modifier. Elle ne change pas la langue de votre dictée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo selecciona la palabra de inicio que editas. No cambia el idioma del dictado."
          }
        }
      }
    },
    "This pack has no words." : {
      "localizations" : {
