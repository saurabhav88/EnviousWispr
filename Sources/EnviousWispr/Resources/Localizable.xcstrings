    "Choose \"Do Nothing\"" : {
      "comment" : "Globe key tip (a popover after choosing the Globe key as the keybind): step 3. Quote the option exactly as macOS labels it in this language.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
