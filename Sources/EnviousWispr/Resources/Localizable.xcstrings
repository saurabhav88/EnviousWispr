    "whatsNew.apple-intelligence-multilingual.description" : {
      "comment" : "Settings > What's New: the paragraph under one feature announcement's title (entry apple-intelligence-multilingual).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI polish with Apple Intelligence now preserves the language you spoke in. German stays German, Korean stays Korean. Languages Apple Intelligence cannot handle are quietly skipped so you always get your raw transcript instead of a silent failure."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI-Nachbearbeitung mit Apple Intelligence bewahrt jetzt deine gesprochene Sprache. Deutsch bleibt Deutsch, Koreanisch bleibt Koreanisch. Kann Apple Intelligence eine Sprache nicht bearbeiten, erhältst du stattdessen unauffällig das rohe Transkript."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retouche IA avec Apple Intelligence conserve maintenant la langue que vous avez utilisée. L’allemand reste de l’allemand, le coréen reste du coréen. Les langues qu’Apple Intelligence ne peut pas traiter sont ignorées discrètement, afin que vous obteniez toujours votre transcription brute plutôt qu’un échec silencieux."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Pulido con Apple Intelligence conserva el idioma en el que dictaste. El alemán sigue siendo alemán y el coreano sigue siendo coreano. Si Apple Intelligence no admite un idioma, la app omite el Pulido sin mostrar un aviso y te entrega la transcripción original."
          }
        }
      }
    },
